interface gui {
  use text.{text-component};
  use common.{click-type};
  use item-stack.{item-stack};
  use screens.{screen};
  use inventory.{inventory};

  resource gui {
    constructor(%type: screen, title: text-component);
    /// Returns the underlying inventory handle for this GUI.
    get-inventory: func() -> inventory;
    set-item: func(slot: u32, item: item-stack);
    get-item: func(slot: u32) -> option<item-stack>;
    /// Returns the type of this GUI.
    get-type: func() -> screen;
    /// Returns the title of this GUI.
    get-title: func() -> text-component;
    /// Returns the number of slots in this GUI.
    get-size: func() -> u32;
    /// Clears all items from the GUI.
    clear-items: func();
    /// Sets whether players can grab items out of the inventory.
    set-allow-grab-items: func(allow: bool);
    /// Returns whether players can grab items out of the inventory.
    get-allow-grab-items: func() -> bool;
    /// Sets whether players can put items into the inventory from their own.
    set-allow-put-items: func(allow: bool);
    /// Returns whether players can put items into the inventory from their own.
    get-allow-put-items: func() -> bool;
  }
}

/// Provides types and utilities for displaying rich dialogs to Java Edition players.
/// These dialogs support various layouts, body elements (text and items),
/// and interactive inputs (checkboxes, text fields, sliders).
interface java-dialogs {
  use text.{text-component};
  use item-stack.{item-stack};

  /// Represents the layout and button configuration of a dialog.
  enum dialog-type {
    /// A simple dialog with a single "OK" button.
    notice,
    /// A dialog with "Yes" and "No" buttons.
    confirmation,
    /// A scrollable list of custom buttons.
    multi-action,
    /// A list of buttons that open other registered dialogs.
    dialog-list,
    /// A dedicated menu for displaying server-related links.
    server-links,
  }

  /// Represents an element in the main content area of a dialog.
  variant dialog-body {
    /// A simple text message.
    plain-message(text-component),
    /// A visual item display.
    item(item-stack),
  }

  /// A checkbox input control.
  record dialog-input-bool {
    label: text-component,
    default-value: bool,
  }

  /// A text field input control.
  record dialog-input-text {
    label: text-component,
    placeholder: text-component,
    default-value: string,
  }

  /// A numerical range slider input control.
  record dialog-input-number-range {
    label: text-component,
    min-value: f32,
    max-value: f32,
    initial-value: f32,
    step: f32,
    label-format: option<string>,
  }

  /// A multiple-choice selection input control.
  record dialog-input-single-option {
    label: text-component,
    options: list<text-component>,
    initial-index: u32,
  }

  /// Represents an interactive input control in a dialog.
  variant dialog-input {
    /// A checkbox for true/false states.
    %bool(dialog-input-bool),
    /// A simple string input field.
    text(dialog-input-text),
    /// A slider for numerical input within a range.
    number-range(dialog-input-number-range),
    /// A multiple-choice selection button.
    single-option(dialog-input-single-option),
  }

  /// Defines what happens after a dialog is closed.
  enum after-action {
    /// Returns the player to the previous screen (e.g., keeping an inventory open).
    peek,
    /// Closes all open screens.
    pop,
  }

  /// Represents a custom server-side action.
  record custom-click-action {
    /// A unique identifier for the action (sent back to the server).
    id: string,
    /// Optional binary data to send with the action.
    payload: option<list<u8>>,
  }

  /// Represents an action triggered by a button click.
  variant action {
    /// Opens an external URL.
    open-url(string),
    /// Triggers a custom server-side callback with an ID and optional payload.
    custom-click(custom-click-action),
  }

  /// Represents a clickable button in a dialog.
  record action-button {
    text: text-component,
    tooltip: option<text-component>,
    width: option<u32>,
    action: action,
  }

  /// Built-in link types recognized by the Java Edition client.
  enum link-type {
    bug-report,
    community-guidelines,
    support,
    status,
    feedback,
    community,
    website,
    forums,
    news,
    announcements,
  }

  /// The label for a link, which can be a built-in type or custom text.
  variant link-label {
    /// A built-in link type with a predefined icon/label.
    built-in(link-type),
    /// A custom text component label.
    custom(text-component),
  }

  /// Represents a link displayed in a Java Edition dialog.
  record link {
    /// The label to display for the link.
    label: link-label,
    /// The URL the link points to.
    url: string,
  }

  /// Represents a dialog shown to a Java Edition player.
  record dialog {
    /// The main title of the dialog.
    title: text-component,
    /// The layout type of the dialog.
    %type: dialog-type,
    /// A list of body elements to display in the main area.
    body: list<dialog-body>,
    /// A list of interactive input controls.
    inputs: list<dialog-input>,
    /// A list of clickable buttons (for multi-action and other types).
    buttons: list<action-button>,
    /// A list of links (primarily for server-links type).
    links: list<link>,
    /// What to do after the dialog is closed.
    after-action: option<after-action>,
    /// Whether the player can exit the dialog using the Esc key.
    can-close-with-escape: bool,
    /// The text shown on buttons that link to/open this dialog.
    external-title: option<text-component>,
  }
}

interface recipe {
  use item-stack.{item-stack};

  /// Recipe category for the recipe book.
  enum recipe-category {
    building,
    redstone,
    equipment,
    misc,
    food,
    blocks,
  }

  /// Represents an ingredient in a recipe.
  variant ingredient {
    /// A specific item (e.g. "minecraft:diamond").
    item(string),
    /// A tag group of items (e.g., "minecraft:logs").
    tag(string),
    /// One of multiple specific items.
    one-of(list<string>),
  }

  /// Represents a shaped crafting recipe.
  record shaped-recipe {
    /// The pattern of the recipe (e.g., ["# #", " s ", "# #"]).
    pattern: list<string>,
    /// Mapping of characters in the pattern to ingredients.
    key: list<tuple<string, ingredient>>,
    /// The resulting item stack.
    output: item-stack,
    /// The recipe group (optional).
    group: option<string>,
    /// The recipe category in the recipe book.
    category: option<recipe-category>,
    /// Whether to show a toast notification when the recipe is unlocked.
    show-notification: option<bool>,
  }

  /// Represents a shapeless crafting recipe.
  record shapeless-recipe {
    /// The list of ingredients required.
    ingredients: list<ingredient>,
    /// The resulting item stack.
    output: item-stack,
    /// The recipe group (optional).
    group: option<string>,
    /// The recipe category in the recipe book.
    category: option<recipe-category>,
  }

  /// Represents a cooking recipe (Smelting, Blasting, Smoking, Campfire).
  record cooking-recipe {
    /// The ingredient to cook.
    ingredient: ingredient,
    /// The resulting item stack.
    output: item-stack,
    /// Experience points awarded.
    experience: f32,
    /// Cooking time in ticks.
    cooking-time: u32,
    /// The recipe group (optional).
    group: option<string>,
    /// The recipe category in the recipe book.
    category: option<recipe-category>,
  }

  /// Types of cooking stations.
  enum cooking-type {
    smelting,
    blasting,
    smoking,
    campfire,
  }

  /// Common interface for registering recipes.
  resource recipe-manager {
    /// Registers a shaped crafting recipe.
    register-shaped: func(id: string, recipe: shaped-recipe);
    /// Registers a shapeless crafting recipe.
    register-shapeless: func(id: string, recipe: shapeless-recipe);
    /// Registers a cooking recipe.
    register-cooking: func(id: string, station-type: cooking-type, recipe: cooking-recipe);
  }
}

interface scoreboard {
  use text.{text-component};
  use common.{named-color};

  enum render-type {
    integer,
    hearts,
  }

  variant number-format {
    blank,
    fixed(text-component),
  }

  enum display-slot {
    player-list,
    sidebar,
    below-name,
    sidebar-team-black,
    sidebar-team-dark-blue,
    sidebar-team-dark-green,
    sidebar-team-dark-aqua,
    sidebar-team-dark-red,
    sidebar-team-dark-purple,
    sidebar-team-gold,
    sidebar-team-gray,
    sidebar-team-dark-gray,
    sidebar-team-blue,
    sidebar-team-green,
    sidebar-team-aqua,
    sidebar-team-red,
    sidebar-team-light-purple,
    sidebar-team-yellow,
    sidebar-team-white,
  }

  enum nametag-visibility {
    always,
    never,
    hide-for-other-teams,
    hide-for-own-team,
  }

  enum collision-rule {
    always,
    never,
    push-other-teams,
    push-own-team,
  }

  record team-settings {
    display-name: text-component,
    friendly-fire: bool,
    see-friendly-invisibles: bool,
    nametag-visibility: nametag-visibility,
    collision-rule: collision-rule,
    color: named-color,
    prefix: text-component,
    suffix: text-component,
  }

  resource scoreboard {
    add-objective: func(name: string, display-name: text-component, render-type: render-type, number-format: option<number-format>);
    update-objective: func(name: string, display-name: text-component, render-type: render-type, number-format: option<number-format>);
    remove-objective: func(name: string);
    set-display-slot: func(slot: display-slot, objective-name: string);
    clear-display-slot: func(slot: display-slot);
    update-score: func(entity-name: string, objective-name: string, value: s32, number-format: option<number-format>);
    add-score: func(entity-name: string, objective-name: string, delta: s32) -> s32;
    remove-score: func(entity-name: string, objective-name: string);
    reset-entity-scores: func(entity-name: string);
    create-team: func(name: string, settings: team-settings);
    remove-team: func(name: string);
    update-team: func(name: string, settings: team-settings);
    add-player-to-team: func(team-name: string, player-name: string);
    remove-player-from-team: func(team-name: string, player-name: string);
    clear-team-players: func(team-name: string);
    get-teams: func() -> list<string>;
    get-team: func(name: string) -> option<team-settings>;
    get-team-players: func(team-name: string) -> list<string>;
    get-player-team: func(player-name: string) -> option<string>;
  }

  enum bedrock-sort-order {
    ascending,
    descending,
  }

  enum bedrock-display-slot {
    player-list,
    sidebar,
    below-name,
  }

  resource bedrock-scoreboard {
    add-objective: func(name: string, display-name: string, sort-order: bedrock-sort-order);
    update-objective: func(name: string, display-name: string, sort-order: bedrock-sort-order);
    remove-objective: func(name: string);
    set-display-slot: func(slot: bedrock-display-slot, objective-name: string);
    clear-display-slot: func(slot: bedrock-display-slot);
    update-score: func(entity-name: string, objective-name: string, value: s32);
    add-score: func(entity-name: string, objective-name: string, delta: s32) -> s32;
    remove-score: func(entity-name: string, objective-name: string);
    reset-entity-scores: func(entity-name: string);
  }
}

interface uuid {
  /// A 128-bit UUID represented as two 64-bit integers.
  record uuid {
    high: u64,
    low: u64,
  }

  /// Generates a new random v4 UUID.
  generate: func() -> uuid;

  /// Parses a UUID from a string. Returns none if the string is not a valid UUID.
  parse: func(s: string) -> option<uuid>;

  /// Converts a UUID to its standard string representation.
  to-string: func(id: uuid) -> string;
}

interface bedrock-packets {
  use uuid.{uuid};
  use common.{nbt-tree};

  /// Specific entity event action or visual effect.
  enum actor-event-id {
    none,
    jump,
    hurt,
    death,
    start-attacking,
    stop-attacking,
    taming-failed,
    taming-succeeded,
    shake-wetness,
    eat-grass,
    fishhook-bubble,
    fishhook-fish-pos,
    fishhook-hook-time,
    fishhook-tease,
    squid-fleeing,
    zombie-converting,
    play-ambient,
    spawn-alive,
    start-offer-flower,
    stop-offer-flower,
    love-hearts,
    villager-angry,
    villager-happy,
    witch-hat-magic,
    fireworks-explode,
    in-love-hearts,
    silverfish-merge-animation,
    guardian-attack-sound,
    drink-potion,
    throw-potion,
    prime-tnt-cart,
    prime-creeper,
    air-supply,
    deprecated-add-player-levels,
    guardian-mining-fatigue,
    agent-swing-arm,
    dragon-start-death-anim,
    ground-dust,
    shake,
    feed,
    baby-age,
    instant-death,
    notify-trade,
    leash-destroyed,
    caravan-updated,
    talisman-activate,
    deprecated-update-structure-feature,
    player-spawned-mob,
    puke,
    update-stack-size,
    start-swimming,
    balloon-pop,
    treasure-hunt,
    summon-agent,
    finished-charging-item,
    actor-grow-up,
    vibration-detected,
    drink-milk,
    shake-wetness-stop,
    kinetic-damage-dealt,
    hurt-without-receiving-damage,
  }

  /// Transmits actor-specific animations, sounds, and state changes (such as hurt, taming, or eating).
  record s-actor-event {
    /// Runtime entity ID of the actor experiencing the event.
    target-runtime-id: s64,
    /// Identifier of the specific actor event.
    event-id: actor-event-id,
    /// Event-specific integer payload data (e.g. particle color or sound data).
    data: s32,
    /// Optional position where the event should be centered.
    fire-at-position: option<tuple<f64, f64, f64>>,
  }

  /// Animation action performed on an actor.
  enum animate-action {
    no-action,
    /// Arm swinging animation.
    swing-arm,
    /// Waking up from bed animation.
    wake-up,
    /// Critical hit particle burst.
    critical-hit,
    /// Magic critical hit sparkle burst.
    magic-critical-hit,
  }

  /// Cause or trigger for an arm swing action.
  enum actor-swing-source {
    none,
    build,
    mine,
    interact,
    attack,
    use-item,
    throw-item,
    drop-item,
    event,
  }

  /// Plays animations (arm swing, critical strike particles, waking up) on an actor.
  record s-animate {
    /// Type of animation to display.
    action: animate-action,
    /// Runtime entity ID of the target actor.
    target-actor-runtime-id: s64,
    /// Floating point payload (used for rowing animation angles).
    data: f32,
    /// Source context that triggered an arm swing.
    swing-source: option<actor-swing-source>,
  }

  /// Sent by the client when picking a targeted block (middle-click / pick block action).
  record s-block-pick-request {
    /// World position coordinates of the targeted block.
    position: tuple<s32, s32, s32>,
    /// Whether block entity data / NBT should be copied into the picked item stack.
    with-data: bool,
    /// Maximum hotbar slots available for placing the picked item.
    max-slots: u8,
  }

  /// Sent by the client to report cache hits and misses for chunk blobs requested by the server.
  record s-client-cache-blob-status {
    /// Hashes of chunk blobs not found in the client cache, which the server must send.
    miss-hashes: list<s64>,
    /// Hashes of chunk blobs successfully retrieved from the client cache.
    hit-hashes: list<s64>,
  }

  /// Sent by the client during login to inform the server whether client-side chunk blob caching is supported.
  record s-client-cache-status {
    /// True if the client supports caching sub-chunk blobs by hash.
    is-cache-supported: bool,
  }

  /// Metadata describing the origin and sender of an executed command.
  record command-origin-data {
    /// Origin type string (e.g. `player`, `command_block`, `server`).
    r-type: string,
    /// UUID uniquely identifying the sender instance.
    uuid: uuid,
    /// Request identifier string for correlating command outputs.
    request-id: string,
    /// Entity unique ID of the player executing the command, if applicable.
    player-id: s64,
  }

  /// Sent by the client to request server-side execution of a slash command.
  record s-command-request {
    /// Raw command line string (with leading slash).
    command: string,
    /// Origin context information identifying the command sender.
    origin: command-origin-data,
    /// Whether the command originates from an internal engine subsystem.
    is-internal: bool,
    /// Protocol command syntax version string.
    version: string,
  }

  /// Sent by either client or server to close an open container inventory window.
  record s-container-close {
    /// Window ID of the container being closed.
    container-id: u8,
    /// Bedrock container type identifier.
    container-type: u8,
    /// True if the close was initiated by the server rather than the player.
    server-initiated-close: bool,
  }

  /// Transmits player emote animations to the server and broadcasts them to nearby players.
  record s-emote {
    /// Runtime entity ID of the emoting player.
    actor-runtime-id: s64,
    /// UUID identifier string of the emote piece being performed.
    emote-id: string,
    /// Duration of the emote animation in ticks.
    emote-length-ticks: s32,
    /// Xbox Live User ID of the player.
    xuid: string,
    /// Platform ID string of the player.
    platform-id: string,
    /// Bitflags modifying emote playback behavior (e.g. mute chat).
    %flags: u8,
  }

  /// Sent by the client to provide the server with a list of all emotes unlocked and equipped by the player.
  record s-emote-list {
    /// Runtime entity ID of the player sending their emote inventory.
    runtime-id: s64,
    /// List of emote piece UUIDs unlocked by the player.
    emote-piece-ids: list<uuid>,
  }

  /// Action type performed in an entity interaction.
  enum action {
    invalid,
    /// Stop riding a vehicle entity.
    stop-riding,
    /// Continuous interaction position update.
    interact-update,
    /// Open NPC dialog interface.
    npc-open,
    /// Open entity inventory (e.g. horse or llama).
    open-inventory,
  }

  /// Sent by the client when interacting with an entity (mounting, NPC dialogue, opening inventory).
  record s-interact {
    /// Type of interaction performed.
    action: action,
    /// Runtime entity ID of the target entity.
    target-runtime-id: s64,
    /// Interaction hit position vector, present for mouse/touch interactions.
    position: option<tuple<f64, f64, f64>>,
  }

  variant inventory-action-source {
    container,
    %world,
    creative,
    todo,
    unknown(s32),
  }

  record legacy-set-item-slot {
    container-id: u8,
    slots: list<u8>,
  }

  enum hand-slot {
    mainhand,
    offhand,
  }

  record stack-request-item {
    identifier: option<string>,
    metadata-value: s32,
    count: s32,
    block-runtime-id: s32,
    extra-data: list<u8>,
  }

  record item-stack-request-action-create {
    result-index: u8,
  }

  record item-stack-request-action-beacon-payment {
    primary-effect-id: s32,
    secondary-effect-id: s32,
  }

  record item-stack-request-action-mine-block {
    hotbar-slot: s32,
    predicted-durability: s32,
    stack-id: s32,
  }

  record item-stack-request-action-craft-recipe {
    recipe-id: s32,
    repetitions: u8,
  }

  record item-stack-request-action-craft-recipe-auto {
    recipe-id: s32,
    repetitions: u8,
  }

  record item-stack-request-action-craft-creative {
    creative-item-id: s32,
    repetitions: u8,
  }

  record item-stack-request-action-optional {
    recipe-id: s32,
    filter-string-index: s32,
  }

  record item-stack-request-action-grindstone {
    recipe-id: s32,
    repair-cost: s32,
    repetitions: u8,
  }

  record item-stack-request-action-loom {
    pattern-id: string,
    repetitions: u8,
  }

  record item-stack-request-action-craft-results-deprecated {
    result-items: list<stack-request-item>,
    times-crafted: u8,
  }

  /// Type of loading screen transition event.
  enum loading-screen-packet-type {
    /// Client has started displaying a loading screen.
    start-loading-screen,
    /// Client has dismissed the loading screen and resumed rendering.
    end-loading-screen,
  }

  /// Sent by the client to update the server on client-side loading screen transitions.
  record s-loading-screen {
    loading-screen-packet-type: loading-screen-packet-type,
    loading-screen-id: option<s32>,
  }

  /// Sent by the client to initiate the login handshake, containing authentication tokens and device information.
  record s-login {
    /// Protocol version spoken by the connecting client.
    protocol-version: s32,
    /// Chain of JSON Web Tokens containing identity and Xbox Live authentication claims.
    jwt: list<u8>,
    /// Raw client data JWT carrying skin parameters, device details, and locale settings.
    raw-token: list<u8>,
  }

  record skin-animation {
    frames: f64,
    image: string,
    image-height: s32,
    image-width: s32,
    animation-type: s32,
    animation-expression: s32,
  }

  record persona-piece {
    is-default: bool,
    pack-id: string,
    piece-id: string,
    piece-type: string,
    product-id: string,
  }

  record persona-piece-tint-colour {
    colours: list<string>,
    piece-type: string,
  }

  record client-data {
    client-random-id: s64,
    device-os: s32,
    device-id: string,
    game-version: string,
    language-code: string,
    current-input-mode: s32,
    default-input-mode: s32,
    ui-profile: s32,
    server-address: string,
    device-model: string,
    gui-scale: s32,
    client-is-editor-capable: bool,
    client-editor-connection-intent: s32,
    max-view-distance: s32,
    memory-tier: s32,
    platform-type: s32,
    graphics-mode: s32,
    compatible-with-client-side-chunk-gen: bool,
    platform-offline-id: string,
    platform-online-id: string,
    platform-user-id: string,
    self-signed-id: string,
    play-fab-id: string,
    third-party-name: string,
    third-party-name-only: bool,
    skin-id: string,
    skin-data: string,
    skin-image-height: s32,
    skin-image-width: s32,
    skin-colour: string,
    arm-size: string,
    persona-skin: bool,
    premium-skin: bool,
    trusted-skin: bool,
    override-skin: bool,
    cape-data: string,
    cape-id: string,
    cape-image-height: s32,
    cape-image-width: s32,
    cape-on-classic-skin: bool,
    skin-geometry: string,
    skin-geometry-version: string,
    skin-resource-patch: string,
    animated-image-data: list<skin-animation>,
    skin-animation-data: string,
    persona-pieces: list<persona-piece>,
    piece-tint-colours: list<persona-piece-tint-colour>,
  }

  /// Sent by the client in response to a server-sent modal form dialog.
  record s-modal-form-response {
    /// Form ID corresponding to the request sent by the server.
    form-id: s32,
    /// JSON encoded form response data (inputs, selected buttons), or None if cancelled.
    json-response: option<string>,
    /// Optional cancellation reason code if the form was dismissed without submission.
    form-cancel-reason: option<u8>,
  }

  /// Sent by the client to report malformed or unexpected packets received from the server.
  record s-packet-violation-warning {
    /// Violation category (e.g. unknown packet or malformed payload).
    violation-type: s32,
    /// Severity level of the violation (warning vs fatal).
    violation-severity: s32,
    /// Packet ID that triggered the violation.
    violation-packet-id: s32,
    /// Diagnostic description of the violation context.
    violation-context: string,
  }

  /// Category of action performed by a player.
  enum player-action-type {
    unknown,
    start-destroy-block,
    abort-destroy-block,
    stop-destroy-block,
    get-updated-block,
    /// Seems to be not used, or atleast not send by client
    drop-item,
    start-sleeping,
    stop-sleeping,
    respawn,
    start-jump,
    start-sprinting,
    stop-sprinting,
    start-sneaking,
    stop-sneaking,
    creative-destroy-block,
    change-dimension-ack,
    start-gliding,
    stop-gliding,
    deny-destroy-block,
    crack-block,
    change-skin,
    updated-enchanting-seed,
    start-swimming,
    stop-swimming,
    start-spin-attack,
    stop-spin-attack,
    interact-with-block,
    predict-destroy-block,
    continue-destroy-block,
    start-item-use-on,
    stop-item-use-on,
    handled-teleport,
    missed-swing,
    start-crawling,
    stop-crawling,
    start-flying,
    stop-flying,
    client-ack-server-data,
    start-using-item,
    internal-update,
    count,
  }

  /// Sent by the client when performing player actions such as mining, sprinting, sneaking, or dimensions changes.
  record s-player-action {
    /// Runtime entity ID of the executing player.
    player-runtime-id: s64,
    /// Specific action type triggered.
    action: player-action-type,
    /// Coordinates of the target block involved in the action, or zero if none.
    block-position: tuple<s32, s32, s32>,
    /// Result block position (e.g. adjacent position where a block would be placed).
    result-pos: tuple<s32, s32, s32>,
    /// Face of the block targeted by the action.
    face: s32,
  }

  /// A block action (e.g. start/stop breaking) executed within a player input tick.
  record player-block-action {
    /// Action category performed on the block.
    action: player-action-type,
    /// Targeted block coordinates.
    block-pos: tuple<s32, s32, s32>,
    /// Face of the block targeted.
    face: s32,
  }

  /// Primary physical input peripheral used by the client.
  enum input-mode {
    /// Standard desktop mouse and keyboard.
    mouse,
    /// Mobile touchscreen controls.
    touch,
    /// Console gamepad or controller.
    game-pad,
    /// Motion controller (VR / AR).
    motion-controller,
  }

  /// Client rendering / gameplay mode.
  enum play-mode {
    /// Standard full-screen desktop or mobile play.
    normal,
    teaser,
    screen,
    exit-level,
    num-modes,
  }

  /// Client control interaction model style.
  enum interaction-model {
    /// Touch drag and tap interaction.
    touch,
    /// Centered crosshair interaction.
    crosshair,
    /// Classic D-pad and tap controls.
    classic,
  }

  enum input-data {
    ascend,
    descend,
    north-jump,
    jump-down,
    sprint-down,
    change-height,
    jumping,
    auto-jumping-in-water,
    sneaking,
    sneak-down,
    up,
    down,
    left,
    right,
    up-left,
    up-right,
    want-up,
    want-down,
    want-down-slow,
    want-up-slow,
    sprinting,
    ascend-block,
    descend-block,
    sneak-toggle-down,
    persist-sneak,
    start-sprinting,
    stop-sprinting,
    start-sneaking,
    stop-sneaking,
    start-swimming,
    stop-swimming,
    start-jumping,
    start-gliding,
    stop-gliding,
    perform-item-interaction,
    perform-block-actions,
    perform-item-stack-request,
    handled-teleport,
    emoting,
    missed-swing,
    start-crawling,
    stop-crawling,
    start-flying,
    stop-flying,
    client-ack-server-data,
    client-predicted-vehicle,
    paddling-left,
    paddling-right,
    block-breaking-delay-enabled,
    horizontal-collision,
    vertical-collision,
    down-left,
    down-right,
    start-using-item,
    camera-relative-movement-enabled,
    rot-controlled-by-move-direction,
    start-spin-attack,
    stop-spin-attack,
    is-hotbar-touch-only,
    jump-released-raw,
    jump-pressed-raw,
    jump-current-raw,
    sneak-released-raw,
    sneak-pressed-raw,
    sneak-current-raw,
    internal-update,
  }

  /// Sent by the Bedrock client when the player changes their active hotbar slot.
  record s-player-hotbar {
    /// Zero-based slot index selected in the hotbar.
    selected-slot: s32,
    /// Container identifier (usually player inventory).
    container-id: u8,
    /// Whether the server should select this slot immediately.
    should-select-slot: bool,
  }

  /// Typed value payload for an ability toggle request.
  variant ability-value {
    /// Boolean flag value (e.g. enabling or disabling flight).
    %bool(bool),
    /// Floating point value (e.g. fly speed modification).
    float(f32),
  }

  /// Sent by the client to request permission to modify a player ability (such as flying).
  record s-request-ability {
    /// Identifier of the requested ability.
    ability: s32,
    /// Requested ability state or value.
    value: ability-value,
  }

  /// Sent by the client to request a specific chunk render distance from the server.
  record s-request-chunk-radius {
    /// Requested chunk render radius in chunks.
    chunk-radius: s32,
    /// Upper limit of chunk render radius requested by the client settings.
    max-chunk-radius: u8,
  }

  /// Sent by the client to query network settings (such as compression algorithms and thresholds) from the server.
  record s-request-network-settings {
    /// Network protocol version supported by the connecting client.
    /// If unsupported by the server, the connection will be rejected.
    client-network-version: s32,
  }

  /// Sent by the client during resource pack negotiation to acknowledge packs or request downloads.
  record s-resource-pack-client-response {
    /// Pack response status (e.g. refused, send packs, have all packs, or completed).
    response: u8,
    /// Number of packs requested for download.
    download-size: s32,
    /// Array of pack identifiers (`UUID_Version`) the client needs to download.
    pack-ids: list<string>,
  }

  /// Lifecycle stage for player respawning.
  enum respawn-state {
    /// Server is searching for a valid spawn position point.
    searching-for-spawn,
    /// Server indicates client is ready to spawn at target coordinates.
    ready-to-spawn,
    /// Client confirms it has loaded the surrounding world and is ready to spawn.
    client-ready-to-spawn,
  }

  /// Bidirectional packet managing player respawning and client spawn readiness.
  record s-respawn {
    /// World coordinates where the player is to respawn.
    position: tuple<f64, f64, f64>,
    /// Stage of the respawn lifecycle.
    state: respawn-state,
    /// Runtime entity ID of the respawning player.
    player-runtime-id: s64,
  }

  /// Sent by the client after receiving PlayStatus(PlayerSpawn) to signal that world initialization is complete.
  record s-set-local-player-as-initialized {
    /// Runtime entity ID assigned to the player in `StartGame`.
    player-id: s64,
  }

  /// Sent by the client to sync inventory UI layout options and selected crafting tabs.
  record s-set-player-inventory-options {
    /// Selected left inventory category tab.
    left-inventory-tab: s32,
    /// Selected right inventory category tab.
    right-inventory-tab: s32,
    /// Whether recipe filtering (craftable only) is toggled on.
    filtering: bool,
    /// Layout style of the inventory grid.
    layout-inv: s32,
    /// Layout style of the crafting section.
    layout-craft: s32,
  }

  /// Formatting type and destination UI layer for Bedrock text packets.
  enum text-packet-type {
    /// Unformatted raw text message.
    raw,
    /// Standard player chat message.
    chat,
    /// Translatable localization key with arguments.
    translation,
    /// Brief popup message displayed above the action bar.
    popup,
    /// Jukebox disc track notification popup.
    jukebox-popup,
    /// Small tip text displayed above the hotbar.
    tip,
    /// Server system notification message.
    system,
    /// Private whisper message directed to a specific player.
    whisper,
    /// Global server announcement message.
    announcement,
    /// Formatted JSON whisper message.
    json-whisper,
    /// Formatted raw JSON message.
    json,
    /// Formatted JSON announcement.
    json-announcement,
  }

  /// Transmits in-game chat messages, system alerts, popups, and raw JSON text between client and server.
  record s-text {
    /// Whether translation is requested for localization strings in the message.
    needs-translation: bool,
    /// Formatting category and presentation target of the text.
    r-type: text-packet-type,
    /// Sender username (included in chat, whisper, and announcement packets).
    source-name: string,
    /// Primary text content or translation key.
    message: string,
    /// Localization substitution arguments for translation or popup texts.
    parameters: list<string>,
    /// Sender Xbox Live User ID (XUID).
    xuid: string,
    /// Platform-specific chat identifier (e.g. Nintendo Switch chat isolation).
    platform-chat-id: string,
    /// Optional profanity-filtered message for clients with filtering enabled.
    filtered-message: option<string>,
  }

  /// Synchronized numeric entity attribute with min, current, and max bounds.
  record synced-attribute {
    /// Identifier string for the attribute (e.g. `minecraft:health`).
    attribute-name: string,
    /// Minimum allowed attribute value.
    min-value: f32,
    /// Current active attribute value.
    current-value: f32,
    /// Maximum allowed attribute value.
    max-value: f32,
  }

  /// A fixed command enum and its allowed option indices.
  record enum-data {
    /// Name of the enumeration.
    name: string,
    /// Indices of valid values pointing into `enum_values`.
    values: list<s32>,
  }

  /// Relationship between a chained subcommand value and argument flags.
  record chained-subcommand-relationship {
    /// Index into the `ChainedSubcommandValues` flat list.
    index: s32,
    /// Argument type flags (basic types only, no `ARG_FLAG`_* modifiers).
    value: s32,
  }

  /// Represents a subcommand that can chain commands, e.g. `/execute`.
  record chained-subcommand-data {
    /// Name of the chained subcommand.
    name: string,
    /// Value and type relationships for this subcommand.
    subcommand-values: list<chained-subcommand-relationship>,
  }

  /// An individual parameter definition within a command overload.
  record param-data {
    /// Parameter name shown in command hints.
    name: string,
    /// Encodes type flags (`ARG_FLAG_VALID` | `ARG_FLAG_ENUM` | index, or raw type).
    parse-symbol: s32,
    /// Whether this parameter is optional.
    is-optional: bool,
    /// Parameter option byte bitflags.
    options: u8,
  }

  /// An overload variant describing a sequence of expected arguments.
  record overload-data {
    /// Whether this overload is part of a chained command invocation.
    is-chaining: bool,
    /// Parameter specifications comprising this overload.
    parameter-data: list<param-data>,
  }

  /// A dynamic command enumeration whose choices can update without resending all commands.
  record soft-enum-data {
    /// Name of the dynamic enumeration.
    enum-name: string,
    /// Available options within the enumeration.
    enum-options: list<string>,
  }

  /// Restricts specific enum values based on constraints.
  record constrained-value-data {
    /// Symbol of the enum value being constrained.
    enum-value-symbol: s32,
    /// Symbol of the enum containing the value.
    enum-symbol: s32,
    /// Indices of constraints applied.
    constraint-indices: list<u8>,
  }

  /// Synchronizes the complete block-actor data for a block position.
  record c-block-actor-data {
    /// World coordinates of the block entity being updated.
    block-position: tuple<s32, s32, s32>,
    /// Network NBT compound containing all properties and state of the block entity.
    actor-data-tags: nbt-tree,
  }

  /// Updates a client-side block animation, such as a chest lid opening or closing.
  record c-block-event {
    /// World coordinates of the block undergoing the event.
    block-position: tuple<s32, s32, s32>,
    /// Type identifier of the block action being executed.
    event-type: s32,
    /// Type-specific integer parameter (e.g. 1 to open a chest lid, 0 to close it).
    event-value: s32,
  }

  /// Sent by the server to make a specific 'boss event' occur in the world.
  ///
  /// Packet ID: `74`
  record c-boss-event {
    /// The unique ID of the boss entity that the boss event sent involves.
    boss-entity-id: s64,
    /// The type of the event (one of `BOSS_EVENT_*`).
    event-type: u8,
    /// The title shown above the boss bar.
    title: string,
    /// Filtered version of `title` with profanity removed.
    filtered-title: string,
    /// The percentage of health shown in the boss bar (0.0 - 1.0).
    health-percentage: f32,
    /// The colour of the boss bar (one of `BOSS_EVENT_COLOUR_*`).
    color: u8,
    /// The overlay of the boss bar (one of `BOSS_EVENT_OVERLAY_*`).
    overlay: u8,
  }

  /// Transitions the player to a different dimension with a loading screen.
  record c-change-dimension {
    /// Target dimension identifier (0: Overworld, 1: Nether, 2: The End).
    ///
    /// Must differ from the player's current dimension to prevent an infinite loading screen.
    dimension-id: s32,
    /// Coordinates where the player spawns in the destination dimension.
    position: tuple<f64, f64, f64>,
    /// Whether this dimension change was triggered by player respawn after death.
    respawn: bool,
    /// Optional identifier for the loading screen session.
    loading-screen-id: option<s32>,
  }

  /// Sent by the server in response to [`SRequestChunkRadius`](crate::bedrock::server::request_chunk_radius::SRequestChunkRadius) to confirm the approved chunk render distance.
  record c-chunk-radius-updated {
    /// Approved chunk radius (in chunks) that the server will send to the client.
    chunk-radius: s32,
  }

  /// Payload data for a requested chunk blob that was missing from the client cache.
  record missing-blob-data {
    /// 64-bit hash identifier of the blob.
    blob-id: s64,
    /// Raw serialized byte payload of the chunk blob.
    blob-data: list<u8>,
  }

  /// Sent by the server in response to [`SClientCacheBlobStatus`](crate::bedrock::server::client_cache_blob_status::SClientCacheBlobStatus) with requested chunk blobs.
  record c-client-cache-miss-response {
    /// Array of blob byte payloads corresponding to missed blob hashes.
    missing-blobs: list<missing-blob-data>,
  }

  /// Operating system or client platform identifier reported by the client.
  enum build-platform {
    unknown,
    google,
    ios,
    osx,
    amazon,
    gear-vr,
    uwp,
    win32,
    dedicated,
    tv-os,
    sony,
    nintendo,
    xbox,
    windows-phone,
    linux,
  }

  /// Game mode identifier used in Bedrock protocol packets.
  enum game-type {
    unknown,
    survival,
    creative,
    adventure,
    default,
    spectator,
  }

  /// Player permission level representing their world access rights.
  enum player-permission-level {
    visitor,
    member,
    operator,
    custom,
  }

  /// Command permission level determining allowed command execution scope.
  enum command-permission-level {
    any,
    game-directors,
    admin,
    host,
    owner,
    internal,
  }

  /// Metadata, permissions, aliases, and argument overloads for a single registered command.
  record command-data {
    /// Canonical command name (without leading slash).
    name: string,
    /// Human-readable description displayed in command help.
    description: string,
    /// Command behavior flags.
    %flags: s32,
    /// Minimum permission level required to execute the command.
    permission-level: command-permission-level,
    /// Index into enum table defining aliases for this command (-1 if none).
    alias-enum: s32,
    /// Indices of chained subcommands referenced by this command.
    command-data-chained-subcommand-indexes: list<s32>,
    /// Overload variants specifying acceptable argument sequences.
    overloads: list<overload-data>,
  }

  /// Advertises available console and chat commands, arguments, overloads, and auto-completion structures.
  record c-available-commands {
    /// Global table of all unique string arguments and options referenced by command enums.
    enum-values: list<string>,
    /// Subcommand names supporting chained execution (e.g. `/execute`).
    chained-subcommand-values: list<string>,
    /// Suffix strings appended to command parameters.
    post-fixes: list<string>,
    /// Fixed enumeration definitions mapping enum names to indices in `enum_values`.
    enum-data: list<enum-data>,
    /// Chained subcommand definitions and argument relationships.
    chained-subcommand-data: list<chained-subcommand-data>,
    /// Command specifications and overloads registered for the player.
    commands: list<command-data>,
    /// Dynamic enumerations that can be updated at runtime without resending all commands.
    soft-enums: list<soft-enum-data>,
    /// Value constraints and restrictions applied to specific enum options.
    constraints: list<constrained-value-data>,
  }

  /// A single ability layer defining movement speeds and allowed action bitflags.
  record serialized-abilities-data-serialized-layer {
    /// Layer type index (such as base, spectator, or creative).
    serialized-layer: s32,
    /// Bitmask of abilities configured for this layer.
    abilities-set: s32,
    /// Current boolean values for the configured abilities bitmask.
    ability-value: s32,
    /// Flying speed multiplier.
    fly-speed: f32,
    /// Vertical flying speed multiplier.
    vertical-fly-speed: f32,
    /// Walking speed multiplier.
    walk-speed: f32,
  }

  /// Serialized abilities data containing permissions and ability bitmasks for a player.
  record serialized-abilities-data {
    /// Unique entity ID of the target player.
    target-player-raw-id: s64,
    /// Permission level shown in the player list.
    player-permissions: player-permission-level,
    /// Level determining what command categories the player can invoke.
    command-permissions: command-permission-level,
    /// Ability layers specifying capabilities (flight, invulnerability, etc.).
    layers: list<serialized-abilities-data-serialized-layer>,
  }

  /// Describes an attachment link between two entities, such as a player riding a vehicle.
  record actor-link {
    /// Unique entity ID of the vehicle / entity being ridden.
    ridden-unique-id: s64,
    /// Unique entity ID of the passenger / rider.
    rider-unique-id: s64,
    /// Type of link (e.g. 0 for passenger, 1 for vehicle).
    link-type: u8,
    /// Whether the link takes effect immediately without smooth transition.
    immediate: bool,
    /// Whether the link was initiated by the passenger entity.
    rider-initiated: bool,
    /// Rotational velocity applied to the vehicle.
    vehicle-angular-velocity: f32,
  }

  /// Sent by the server to open an inventory container screen (chest, furnace, anvil) on the client.
  record c-container-open {
    /// Window ID assigned to the opened container session.
    container-id: u8,
    /// Container inventory type (chest, hopper, dispenser, etc.).
    container-type: u8,
    /// Block coordinates of the container block entity in world space.
    position: tuple<s32, s32, s32>,
    /// Entity ID if the container belongs to an entity (e.g. horse or donkey chest).
    target-entity-id: s64,
  }

  /// Sent by the server to correct the client's predicted movement under server authoritative movement.
  record c-correct-player-move-prediction {
    /// Prediction mode type (e.g. player movement vs vehicle movement).
    prediction-type: u8,
    /// Corrected world position coordinates.
    pos: tuple<f64, f64, f64>,
    /// Positional delta velocity vector.
    pos-delta: tuple<f64, f64, f64>,
    /// Pitch and yaw rotation angles.
    rotation: tuple<f64, f64>,
    /// Angular velocity of the vehicle if riding one.
    vehicle-angular-velocity: option<f32>,
    /// Whether the player was resting on solid ground.
    on-ground: bool,
    /// Tick number on which the prediction error occurred.
    tick: s64,
  }

  record recipe-item-descriptor-item {
    identifier: string,
    metadata-value: s32,
  }

  variant recipe-item-descriptor {
    empty,
    item(recipe-item-descriptor-item),
    tag(string),
  }

  record item-descriptor-count {
    descriptor: recipe-item-descriptor,
    count: s32,
  }

  record recipe-unlock-requirement {
    context: s32,
  }

  enum creative-category {
    all,
    construction,
    nature,
    equipment,
    items,
    item-command-only,
    undefined,
  }

  /// Sent by the server to cleanly disconnect a client with an optional error code and kick message.
  record c-disconnect {
    /// Disconnect reason code determining the message shown on the client disconnect screen.
    reason: s32,
    /// Whether to skip showing the disconnect message dialog and return directly to the main menu.
    skip-message: bool,
    /// Disconnect explanation message displayed to the user.
    message: string,
    /// Profanity-filtered variant of the disconnect message.
    filtered-message: string,
  }

  enum rule-value {
    null,
  }

  /// An individual gamerule entry with its identifier, edit permission, and typed value.
  record game-rule {
    /// Name of the gamerule in lowercase (e.g. `showcoordinates`).
    rule-name: string,
    /// Whether players with operator permissions can edit this gamerule in-game.
    rule-can-be-modified: bool,
    /// Value associated with the gamerule.
    rule-value: rule-value,
  }

  /// Sent by the server to update gamerules on the client (e.g. `showcoordinates` or `dodaylightcycle`).
  record c-gamerules-changed {
    /// List of game rules being updated.
    rule-data: list<game-rule>,
  }

  /// Registration data for a single item type in the network item registry.
  record item-data {
    /// String identifier for the item (e.g. `minecraft:diamond_sword`).
    item-name: string,
    /// Numerical runtime ID of the item.
    item-id: s32,
    /// Whether the item uses data-driven components.
    is-component-based: bool,
    /// Format version of the item schema.
    item-version: s32,
    /// Pre-serialized Bedrock NBT compound representing the item components.
    component-data: list<u8>,
  }

  /// Sent by the server to register custom and vanilla item identifiers with their component definitions.
  record c-item-registry {
    /// List of registered item definitions and their component NBT data.
    items: list<item-data>,
  }

  /// Slot update information resulting from an approved item stack request.
  record item-stack-response-slot-info {
    /// Slot index requested by the client.
    requested-slot: u8,
    /// Destination slot index allocated by the server.
    slot: u8,
    /// Item count in the slot.
    amount: u8,
    /// Unique network stack ID assigned to the slot's item stack.
    item-stack-net-id: s32,
    /// Custom display name assigned to the item.
    custom-name: string,
    /// Filtered custom display name.
    filtered-custom-name: string,
    /// Durability correction delta.
    durability-correction: s32,
  }

  /// Broadcasts visual or auditory level-wide events, such as particles or block breaking.
  record c-level-event {
    /// Identifier corresponding to the specific level event action.
    event-id: s32,
    /// World coordinates where the event originates or particle effect is centered.
    position: tuple<f64, f64, f64>,
    /// Type-specific auxiliary parameter associated with the event (e.g. block runtime ID).
    data: s32,
  }

  /// Identifiers for common level-wide events and particle effects.
  enum level-event {
    /// Emits block break particles at the target position.
    particles-destroy-block,
    /// Initiates a block cracking animation.
    block-start-break,
    /// Cancels or completes a block cracking animation.
    block-stop-break,
    /// Advances the crack stage of a block cracking animation.
    block-update-break,
  }

  /// Plays a sound effect at a designated world position or associated with an actor.
  record c-level-sound-event {
    /// Canonical identifier string for the sound event.
    sound-event: string,
    /// World coordinates where the sound source is located.
    position: tuple<f64, f64, f64>,
    /// Auxiliary integer parameter used by specific sound effects.
    data: s32,
    /// Identifier of the entity generating the sound (e.g. `minecraft:skeleton`).
    actor-identifier: string,
    /// Whether the sound pitch/variant should reflect a juvenile mob variant.
    is-baby: bool,
    /// Whether the sound plays globally at full volume without spatial falloff.
    is-global: bool,
    /// Unique identifier of the entity emitting the sound.
    actor-unique-id: s64,
    /// Optional explicit override position where the event should trigger.
    fire-at-position: option<tuple<f64, f64, f64>>,
  }

  /// Sent by the server to add, modify, or remove potion/status effects on an entity.
  record c-mob-effect {
    /// Runtime entity ID of the target actor.
    target-runtime-id: s64,
    /// Effect action event (Add, Modify, or Remove).
    event-id: u8,
    /// Status effect type identifier.
    effect-id: s32,
    /// Amplifier/potency level of the effect (e.g. 0 for Speed I, 1 for Speed II).
    effect-amplifier: s32,
    /// Whether swirl particles should be displayed around the entity.
    show-particles: bool,
    /// Duration of the effect in ticks.
    effect-duration-ticks: s32,
    /// Simulation tick number for server authoritative syncing.
    tick: s64,
    /// Whether the effect is ambient (e.g. from a beacon).
    ambient: bool,
  }

  /// Requests the client to open a server-defined UI form (modal dialog, list menu, or custom form).
  record c-modal-form-request {
    /// Unique identifier assigned by the server to distinguish responses when the form is submitted.
    form-id: s32,
    /// JSON-encoded definition describing the layout, controls, and contents of the form window.
    form-ui-json: string,
  }

  /// Sent by the server to update an entity's absolute position and rotation angles.
  record c-move-actor-absolute {
    /// Runtime entity ID of the moving actor.
    actor-runtime-id: s64,
    /// Bitflags indicating on-ground status, teleportation, or forced movement.
    header: u8,
    /// Absolute world position coordinates.
    position: tuple<f64, f64, f64>,
    /// Pitch angle encoded as an 8-bit rotation value (`angle * 256 / 360`).
    rotation-x: u8,
    /// Yaw angle encoded as an 8-bit rotation value.
    rotation-y: u8,
    /// Head yaw angle encoded as an 8-bit rotation value.
    rotation-y-head: u8,
  }

  /// Bandwidth-optimized delta movement packet for updating an entity's position and rotation.
  record c-move-actor-delta {
    /// Runtime entity ID of the moving actor.
    entity-runtime-id: s64,
    /// Bitmask specifying which coordinates, angles, and flags are present in the payload.
    %flags: s32,
    /// Delta or absolute X coordinate.
    x: f32,
    /// Delta or absolute Y coordinate.
    y: f32,
    /// Delta or absolute Z coordinate.
    z: f32,
    /// Pitch angle encoded as an 8-bit rotation value.
    pitch: u8,
    /// Yaw angle encoded as an 8-bit rotation value.
    yaw: u8,
    /// Head yaw angle encoded as an 8-bit rotation value.
    head-yaw: u8,
    /// Server world simulation tick number.
    tick: s64,
  }

  /// Sent by the server to update a player's movement, teleport, or view angle.
  record c-move-player {
    /// Runtime entity ID of the player being moved.
    player-runtime-id: s64,
    /// Absolute position coordinates in world space.
    position: tuple<f64, f64, f64>,
    /// Pitch angle in degrees.
    pitch: f32,
    /// Yaw angle in degrees.
    yaw: f32,
    /// Horizontal head yaw rotation angle in degrees.
    head-yaw: f32,
    /// Movement mode (normal, reset, teleport, or rotation).
    mode: u8,
    /// Whether the player is resting on the ground.
    on-ground: bool,
    /// Runtime entity ID of the vehicle the player is riding, or zero.
    riding-runtime-id: s64,
    /// Cause of the teleportation (present when mode is `MODE_TELEPORT`).
    teleport-cause: s32,
    /// Entity type that triggered the teleportation.
    teleport-source-entity-type: s32,
    /// World simulation tick number.
    tick: s64,
  }

  /// Sent by the server to update the center anchor position and radius around which chunks remain loaded on the client.
  record c-network-chunk-publisher-update {
    /// Center block position of the loaded area.
    pos-for-view: tuple<s32, s32, s32>,
    /// Radius around the view position (measured in blocks, typically chunk radius * 16).
    new-radius: s32,
    /// List of chunk coordinates saved in the client's cache.
    server-build-chunk-list: list<tuple<f64, f64>>,
  }

  /// Sent by the server in response to [`SRequestNetworkSettings`](crate::bedrock::server::request_network_settings::SRequestNetworkSettings) to configure packet compression and client throttling.
  record c-network-settings {
    /// Byte size threshold above which packet payloads are compressed. If zero, packets are uncompressed.
    compression-threshold: s32,
    /// The compression algorithm to use (`0` = Deflate/ZLib, `1` = Snappy, `0xffff` = None).
    compression-algorithm: s32,
    /// Whether the client should throttle player ticking when player count exceeds threshold.
    client-throttle-enabled: bool,
    /// Player count limit before the client activates throttling.
    client-throttle-threshold: u8,
    /// Fraction of players ticked per frame when throttling is engaged.
    client-throttle-scalar: f32,
  }

  /// Sent by the server to inform the client of login results, version compatibility, or player spawn readiness.
  enum c-play-status {
    /// Authentication and login succeeded; client proceeds to resource pack handshake.
    login-success,
    /// Client protocol version is older than required by the server.
    outdated-client,
    /// Server protocol version is older than the client version.
    outdated-server,
    /// Server is ready for the player to spawn into the world.
    player-spawn,
    /// Client tenant ID is invalid.
    invalid-tenant,
    /// Educational edition client attempting to join a vanilla server.
    edition-mismatch-edu-to-vanilla,
    /// Vanilla client attempting to join an educational server.
    edition-mismatch-vanilla-to-edu,
    /// Server is full for local split-screen sub-clients.
    server-full-sub-client,
    /// Editor mode client attempting to join a vanilla world.
    editor-mismatch-editor-to-vanilla,
    /// Vanilla client attempting to join an editor world.
    editor-mismatch-vanilla-to-editor,
  }

  /// Sent by the server to update the active selected hotbar slot of the player.
  record c-player-hotbar {
    /// Zero-based slot index selected in the hotbar.
    selected-slot: s32,
    /// Container identifier (usually player inventory).
    container-id: u8,
    /// Whether the client should immediately focus the slot.
    should-select-slot: bool,
  }

  record piece-tint-color {
    piece-type: string,
    colors: list<s32>,
  }

  record skin {
    skin-id: string,
    play-fab-id: string,
    resource-patch: list<u8>,
    image-width: s32,
    image-height: s32,
    skin-data: list<u8>,
    animations: list<skin-animation>,
    cape-width: s32,
    cape-height: s32,
    cape-data: list<u8>,
    geometry-data: list<u8>,
    animation-data: list<u8>,
    geometry-data-engine-version: list<u8>,
    cape-id: string,
    full-id: string,
    arm-size: string,
    skin-color: string,
    persona-pieces: list<persona-piece>,
    piece-tint-colors: list<piece-tint-color>,
    is-premium: bool,
    is-persona: bool,
    persona-cape-on-classic: bool,
    is-primary-user: bool,
    override-appearance: bool,
    is-trusted: bool,
    profile-hash: string,
  }

  record player-list-entry {
    uuid: uuid,
    entity-unique-id: s64,
    username: string,
    xuid: string,
    platform-chat-id: string,
    build-platform: build-platform,
    skin: skin,
    is-teacher: bool,
    is-host: bool,
    is-sub-client: bool,
    player-color: list<u8>,
  }

  /// Sent by the server to add or remove players from the in-game pause screen player list.
  record c-player-list {
    /// Action type (`ACTION_ADD` = 0 to add, `ACTION_REMOVE` = 1 to remove).
    action: u8,
    /// Player entries being added or removed.
    entries: list<player-list-entry>,
  }

  /// Sent by the server to despawn an entity from the client's world.
  record c-remove-actor {
    /// Unique entity ID of the entity to remove.
    target-actor-id: s64,
  }

  /// Removes a scoreboard objective, hiding it from the player's screen.
  record c-remove-objective {
    /// Identifier of the active objective to remove.
    objective-name: string,
  }

  /// Identifies a specific pack instance and sub-pack layer in the active resource pack stack.
  record pack-instance-id {
    /// UUID string of the resource pack.
    pack-id: string,
    /// Semantic version string.
    version: string,
    /// Sub-pack configuration name.
    sub-pack-name: string,
  }

  /// A resource pack UUID paired with its semantic version string.
  record pack-id-version {
    /// Unique identifier for the pack.
    pack-uuid: uuid,
    /// Semantic version string (e.g. `1.0.0`).
    pack-version: string,
  }

  /// Information describing a resource pack available on the server.
  record pack-info-data {
    /// UUID and version string identifying the pack.
    pack-id-version: pack-id-version,
    /// Size of the pack in bytes.
    pack-size: s64,
    /// Encryption key for marketplace or encrypted content.
    content-key: string,
    /// Specific subpack folder name, if applicable.
    subpack-name: string,
    /// Content identity identifier.
    content-identity: string,
    /// True if the pack contains JavaScript or game test scripts.
    has-scripts: bool,
    /// True if the pack includes custom add-on behaviors.
    is-addon-pack: bool,
    /// True if the pack includes PBR textures for ray tracing (RTX).
    is-ray-tracing-capable: bool,
    /// Optional CDN URL where the client can download the pack.
    cdn-url: string,
  }

  /// Sent by the server to list all resource and behavior packs required or available to download.
  record c-resource-packs-info {
    /// If true, the client must accept and download all packs to join.
    resource-pack-required: bool,
    /// Whether any packs in the list are add-on packs.
    has-addon-packs: bool,
    /// Whether any packs contain client-side scripting.
    has-scripts: bool,
    /// Whether vibrant visual shader enhancements should be disabled.
    force-disable-vibrant-visuals: bool,
    /// World template UUID and version, if joining a world template.
    world-template-id-and-version: pack-id-version,
    /// Array of resource packs available on the server.
    resource-packs: list<pack-info-data>,
  }

  variant metadata-value {
    byte(u8),
    short(s32),
    int(s32),
    float(f32),
    %string(string),
    compound-tag,
    item-pos(tuple<s32, s32, s32>),
    int64(s64),
    vec3(tuple<f64, f64, f64>),
  }

  record property-sync-data {
    int-entries-list: list<tuple<s32, s32>>,
    float-entries-list: list<tuple<s32, f32>>,
  }

  /// Sent by the server to spawn non-player entities (mobs, projectiles, vehicles, items) on the client.
  record c-add-actor {
    /// Unique entity ID across sessions.
    target-actor-id: s64,
    /// Runtime entity ID for the current session.
    target-runtime-id: s64,
    /// Entity type identifier (e.g. `minecraft:zombie` or `minecraft:arrow`).
    actor-type: string,
    /// World spawn coordinates.
    position: tuple<f64, f64, f64>,
    /// Initial movement velocity vector.
    velocity: tuple<f64, f64, f64>,
    /// Pitch (x) and yaw (y) rotation angles.
    rotation: tuple<f64, f64>,
    /// Horizontal head yaw rotation angle.
    y-head-rotation: f32,
    /// Body yaw rotation angle.
    y-body-rotation: f32,
    /// Entity attributes (health, movement speed, follow range).
    attributes-list: list<synced-attribute>,
    /// Metadata dictionary (flags, name tags, scale).
    actor-data: string,
    /// Dynamic Molang property synchronization data.
    synced-properties: property-sync-data,
    /// Entity attachment links (e.g. passenger or leash connections).
    actor-links: list<actor-link>,
  }

  /// Sent by the server to update metadata and Molang properties of an entity (e.g. name tags, fire, scale).
  record c-set-actor-data {
    /// The unique runtime ID of the entity being updated
    target-runtime-id: s64,
    /// A map of entity metadata properties (e.g., flags, name tags, scale)
    actor-data: string,
    /// Dynamic properties synced between client and server
    synced-properties: property-sync-data,
    /// The server tick at which this update occurred
    tick: s64,
  }

  /// Sent by the server to create, modify, or remove an attachment link between two entities (e.g. riding).
  record c-set-actor-link {
    /// Attachment link descriptor defining the vehicle and passenger entities.
    link: actor-link,
  }

  /// Sent by the server to set the movement velocity of an entity (e.g. knockback or explosion velocity).
  record c-set-actor-motion {
    /// Runtime entity ID of the target actor.
    target-runtime-id: s64,
    /// 3D velocity vector applied to the entity.
    motion: tuple<f64, f64, f64>,
    /// Simulation tick number for server authoritative syncing.
    tick: s64,
  }

  /// Synchronizes world difficulty level to the client.
  record c-set-difficulty {
    /// World difficulty value (0: Peaceful, 1: Easy, 2: Normal, 3: Hard).
    difficulty: s32,
  }

  /// Configures and displays a scoreboard objective in a specific UI slot.
  record c-set-display-objective {
    /// Slot location where the objective is presented (`sidebar`, `list`, or `belowname`).
    display-slot-name: string,
    /// Internal unique identifier for the scoreboard objective.
    objective-name: string,
    /// Visible title text displayed atop the scoreboard.
    objective-display-name: string,
    /// Objective criteria string (e.g. `dummy`).
    criteria-name: string,
    /// Ordering direction for scores (0: ascending, 1: descending).
    sort-order: s32,
  }

  /// Updates player health (legacy packet; attribute updates are typically preferred).
  record c-set-health {
    /// New health value assigned to the player.
    health: s32,
  }

  /// Updates the player's active game mode (e.g. Survival, Creative, Spectator).
  record c-set-player-game-type {
    /// Target game mode to apply.
    player-game-type: game-type,
  }

  /// A single score line or entry on a scoreboard.
  record score-entry {
    /// Unique scoreboard identifier for this entry.
    scoreboard-id: s64,
    /// Associated objective identifier.
    objective-name: string,
    /// Score value displayed alongside the entry.
    score: s32,
    /// Target type (1: player, 2: entity, 3: fake player).
    entry-type: s32,
    /// Unique entity identifier when entry type is player or entity.
    entity-unique-id: s64,
    /// Custom label when entry type is a fake player.
    custom-name: string,
  }

  /// Updates or removes scoreboard entries displayed to the client.
  record c-set-score {
    /// Action type determining whether scores are modified (0) or removed (1).
    action: s32,
    /// Score entries affected by this update.
    entries: list<score-entry>,
  }

  /// Scope of the spawn position update.
  enum spawn-position-type {
    /// Sets an individual player respawn point (e.g. bed or respawn anchor).
    player-respawn,
    /// Sets the global world spawn point, also updating compass direction.
    world-respawn,
  }

  /// Updates the player or world spawn coordinates, affecting respawning and compass orientation.
  record c-set-spawn-position {
    /// Determines whether this update configures a player-specific or world spawn location.
    spawn-position-type: spawn-position-type,
    /// Spawn coordinates being set.
    block-position: tuple<s32, s32, s32>,
    /// Dimension identifier associated with this spawn position.
    dimension-type: s32,
    /// World spawn coordinates.
    spawn-block-pos: tuple<s32, s32, s32>,
  }

  /// Sent by the server to synchronize the day-night cycle time (in ticks) with the client.
  record c-set-time {
    /// In-game time of day in ticks.
    time: s32,
  }

  /// Action or display target of a title packet.
  enum title-type {
    /// Clears any currently displayed title.
    clear,
    /// Resets title animations and display durations to default values.
    reset,
    /// Displays primary title text.
    title,
    /// Displays secondary subtitle text beneath the title.
    subtitle,
    /// Displays text above the player's hotbar (action bar).
    actionbar,
    /// Configures fade-in, stay, and fade-out durations without displaying new text.
    times,
    /// Displays localized or formatted JSON text as primary title.
    title-text-object,
    /// Displays localized or formatted JSON text as subtitle.
    subtitle-text-object,
    /// Displays localized or formatted JSON text on the action bar.
    actionbar-text-object,
  }

  /// Displays or controls on-screen titles, subtitles, or action bar notices.
  record c-set-title {
    /// Operation type to perform (show text, adjust timing, clear, or reset).
    title-type: title-type,
    /// Content string or raw JSON component displayed on screen.
    title-text: string,
    /// Duration in ticks for the title to fade in.
    fade-in-time: s32,
    /// Duration in ticks for the title to remain fully visible.
    stay-time: s32,
    /// Duration in ticks for the title to fade out.
    fade-out-time: s32,
    /// Xbox Live user identifier of the recipient, if applicable.
    xuid: string,
    /// Platform-specific online identifier.
    platform-online-id: string,
    /// Sanitized version of the title message with profanity removed.
    filtered-title-message: string,
  }

  /// Displays or dismisses the end-game rolling credits screen.
  record c-show-credits {
    /// Runtime entity identifier of the player viewing the credits.
    player-runtime-id: s64,
    /// State transition flag (0: start showing credits, 1: stop showing credits).
    credits-state: s32,
  }

  record gathering-join-info {
    experience-id: uuid,
    experience-name: string,
    experience-world-id: uuid,
    experience-world-name: string,
    creator-id: string,
    unknown-uuid-1: uuid,
    unknown-uuid-2: uuid,
    server-id: string,
  }

  record store-entry-point-info {
    store-id: string,
    store-name: string,
  }

  record presence-info {
    experience-name: string,
    world-name: string,
  }

  record server-join-information {
    gathering: option<gathering-join-info>,
    store-entry-point: option<store-entry-point-info>,
    presence: option<presence-info>,
  }

  record server-telemetry-data {
    server-id: string,
    scenario-id: string,
    world-id: string,
    owner-id: string,
  }

  record experiment-toggle {
    name: string,
    enabled: bool,
  }

  record experiments {
    toggles: list<experiment-toggle>,
    experiments-ever-toggled: bool,
  }

  /// Sent by the server to define the order in which resource and behavior packs are applied by the client.
  record c-resource-pack-stack-packet {
    /// If true, textures from the resource packs are strictly required to join.
    texture-pack-required: bool,
    /// Ordered list of packs to apply in bottom-to-top priority.
    texture-pack-list: list<pack-instance-id>,
    /// Base vanilla version of the game.
    base-game-version: string,
    /// Experimental gameplay feature toggles enabled for this world.
    experiments: experiments,
    /// Whether to load editor mode packs.
    include-editor-packs: bool,
  }

  enum game-publish-setting {
    no-multi-play,
    invite-only,
    friends-only,
    friends-of-friends,
    public,
  }

  record level-settings {
    seed: s64,
    spawn-biome-type: s32,
    custom-biome-name: string,
    dimension: s32,
    generator-type: s32,
    world-gamemode: game-type,
    hardcore: bool,
    difficulty: s32,
    spawn-position: tuple<s32, s32, s32>,
    has-achievements-disabled: bool,
    editor-world-type: s32,
    is-created-in-editor: bool,
    is-exported-from-editor: bool,
    day-cycle-stop-time: s32,
    education-edition-offer: s32,
    has-education-features-enabled: bool,
    education-product-id: string,
    rain-level: f32,
    lightning-level: f32,
    has-confirmed-platform-locked-content: bool,
    was-multiplayer-intended: bool,
    was-lan-broadcasting-intended: bool,
    xbox-live-broadcast-setting: game-publish-setting,
    platform-broadcast-setting: game-publish-setting,
    commands-enabled: bool,
    is-texture-packs-required: bool,
    rule-data: list<game-rule>,
    experiments: experiments,
    bonus-chest: bool,
    has-start-with-map-enabled: bool,
    permission-level: u8,
    server-simulation-distance: s32,
    has-locked-behavior-pack: bool,
    has-locked-resource-pack: bool,
    is-from-locked-world-template: bool,
    is-using-msa-gamertags-only: bool,
    is-from-world-template: bool,
    is-world-template-option-locked: bool,
    is-only-spawning-v1-villagers: bool,
    is-disabling-personas: bool,
    is-disabling-custom-skins: bool,
    emote-chat-muted: bool,
    game-version: string,
    limited-world-width: s32,
    limited-world-height: s32,
    new-nether: bool,
    edu-shared-uri-button-name: string,
    edu-shared-uri-link-uri: string,
    override-force-experimental-gameplay-has-value: bool,
    chat-restriction-level: u8,
    disable-player-interactions: bool,
    server-editor-connection-policy: s32,
    allow-anonymous-block-drops-in-editor-worlds: bool,
  }

  /// An entry for a custom block registered on the server.
  ///
  /// The runtime ID of these custom block entries is based on their alphabetic index
  /// within the registered block palette.
  record block-property {
    /// Name or identifier of the custom block (e.g. `namespace:block`).
    name: string,
    /// NBT compound containing properties defining the unique block state.
    properties: nbt-tree,
  }

  /// Sent by the server to initialize the client's world, spawn coordinates, gamerules, and entity runtime ID.
  record c-start-game {
    /// Persistent unique ID of the player entity across sessions.
    entity-id: s64,
    /// Runtime entity ID uniquely identifying the player during the current session.
    runtime-entity-id: s64,
    /// Initial game mode assigned to the player.
    player-gamemode: game-type,
    /// World coordinates where the player spawns.
    position: tuple<f64, f64, f64>,
    /// Initial pitch rotation angle.
    pitch: f32,
    /// Initial yaw rotation angle.
    yaw: f32,
    /// World and dimension settings (generator, seed, difficulty, gamerules).
    level-settings: level-settings,
    /// Unique level identifier string.
    level-id: string,
    /// Display name of the world shown in menus.
    level-name: string,
    /// Template ID for marketplace worlds.
    premium-world-template-id: string,
    /// True if the world is running in trial mode.
    is-trial: bool,
    /// Number of movement ticks kept in rewind history for server authoritative movement.
    rewind-history-size: s32,
    /// True if block breaking progress is checked and controlled by the server.
    server-authoritative-block-breaking: bool,
    /// Current in-game world time in ticks.
    current-level-time: s64,
    /// Player's enchanting seed for deterministic enchanting tables.
    enchantment-seed: s32,
    /// Custom block property definitions registered on the server.
    block-properties: list<block-property>,
    /// Correlation ID string used for telemetry and matchmaking.
    multiplayer-correlation-id: string,
    /// Whether the modern item stack network manager is enabled.
    enable-itemstack-net-manager: bool,
    /// Version string of the server software.
    server-version: string,
    compound-id: u8,
    compound-len: s32,
    compound-end: u8,
    /// CRC64 checksum of the block state registry.
    block-registry-checksum: s64,
    /// UUID of the world template if created from a template.
    world-template-id: uuid,
    /// Whether client-side chunk generation is enabled.
    enable-clientside-generation: bool,
    /// Whether block runtime IDs are cryptographic hashes instead of sequential IDs.
    blocknetwork-ids-are-hashed: bool,
    /// Whether entity and environment sounds are validated by the server.
    server-auth-sounds: bool,
    /// Server connection information.
    server-join-information: option<server-join-information>,
    /// Telemetry and session tracking identifiers.
    telemetry: server-telemetry-data,
  }

  /// Sent by the server when an entity or player picks up a dropped item, playing the pickup animation.
  record c-take-item-actor {
    /// Runtime entity ID of the item entity being collected.
    item-runtime-id: s64,
    /// Runtime entity ID of the collector entity that picked up the item.
    actor-runtime-id: s64,
  }

  /// Instructs the client to disconnect and reconnect to another server address and port.
  record c-transfer {
    /// Destination server hostname or IP address.
    server-address: string,
    /// Destination server UDP port.
    server-port: s32,
    /// Whether the client should reload its local world context upon transferring.
    reload-world: bool,
  }

  /// Updates player movement and interaction abilities such as flight and build permissions.
  record c-update-abilities {
    /// Serialized ability layers and permission parameters.
    data: serialized-abilities-data,
  }

  /// Bit flags and identifiers for individual player abilities and privileges.
  enum ability {
    build,
    mine,
    doors-and-switches,
    open-containers,
    attack-players,
    attack-mobs,
    operator-commands,
    teleport,
    invulnerable,
    flying,
    may-fly,
    instabuild,
    lightning,
    fly-speed,
    walk-speed,
    muted,
    world-builder,
    no-clip,
    privileged-builder,
    vertical-fly-speed,
    ability-count,
  }

  /// An attribute modifier that adjusts an attribute by addition or multiplication.
  record attribute-modifier {
    /// Unique identifier for the modifier.
    id: string,
    /// Human-readable modifier name.
    name: string,
    /// Numeric modifier amount.
    amount: f32,
    /// Mathematical operation (addition, multiply base, multiply total).
    operation: s32,
    /// Modifier operand type index.
    operand: s32,
    /// Whether the modifier persists across save/load sessions.
    is-serializable: bool,
  }

  /// Detailed specification of an entity attribute and its active modifiers.
  record attribute-data {
    /// Minimum value the attribute can reach.
    min-value: f32,
    /// Maximum value the attribute can reach.
    max-value: f32,
    /// Current calculated attribute value.
    current-value: f32,
    /// Base minimum default value.
    default-min-value: f32,
    /// Base maximum default value.
    default-max-value: f32,
    /// Base default value without modifiers.
    default-value: f32,
    /// Identifier string for the attribute (e.g. `minecraft:health`).
    name: string,
    /// Active modifiers altering this attribute.
    modifiers: list<attribute-modifier>,
  }

  /// Sent by the server to update an entity's attribute values (e.g. health, absorption, movement speed, hunger).
  record c-update-attributes {
    /// Runtime entity ID of the target actor.
    target-runtime-id: s64,
    /// List of attributes with their current bounds, values, and modifiers.
    attribute-list: list<attribute-data>,
    /// Simulation tick number for sync verification.
    tick: s64,
  }

  /// Updates a single block state client-side without retransmitting the entire chunk.
  record c-update-block {
    /// World coordinates where the block state is being updated.
    block-position: tuple<s32, s32, s32>,
    /// Runtime identifier corresponding to the new block state.
    block-runtime-id: s32,
    /// Bitflags governing client-side update behaviors such as neighbor updates.
    %flags: s32,
    /// Target world layer for the block (e.g. 0 for primary blocks, 1 for waterlogging).
    layer: s32,
  }

  /// Opens or refreshes a Bedrock merchant screen with its complete offer list.
  record c-update-trade {
    /// Window identifier of the active trade screen.
    container-id: u8,
    /// Window type identifier (typically 15 for villager trading).
    r-type: u8,
    /// Count of trading options available.
    size: s32,
    /// Experience or progression tier of the trading merchant.
    trader-tier: s32,
    /// Unique identifier of the merchant entity.
    entity-unique-id: s64,
    /// Unique entity identifier of the last player to interact with this merchant.
    last-trading-player: s64,
    /// Visible title displayed at the top of the trading interface.
    display-name: string,
    /// Whether to display the modern villager trading UI.
    use-new-trade-screen: bool,
    /// Whether offer pricing incorporates demand and supply economics.
    using-economy-trade: bool,
    /// Network NBT compound containing full recipe and trade offer definitions.
    data: nbt-tree,
  }

  /// Describes a network item stack transmitted over the wire in Bedrock packets.
  ///
  /// Contains the item runtime ID, count, aux/metadata value, block runtime state,
  /// and variable user data including NBT, can-place, and can-destroy block filters.
  record network-item-descriptor {
    /// Runtime item identifier.
    id: s32,
    /// Stack item count.
    stack-size: s32,
    /// Auxiliary metadata or damage value.
    aux-value: s32,
    /// Block runtime ID associated with the item (for block items).
    block-runtime-id: s32,
    /// NBT component data (display name, enchantments, etc.).
    nbt-data: nbt-tree,
    /// Block identifiers this item can be placed against in Adventure mode.
    place-on-blocks: list<string>,
    /// Block identifiers this tool can destroy in Adventure mode.
    destroy-blocks: list<string>,
    /// Shield blocking tick counter used for shield cooldown sync.
    shield-blocking-tick: s64,
  }

  record inventory-action {
    source-type: s32,
    window-id: option<s32>,
    source-flags: option<s32>,
    inventory-slot: s32,
    old-item: network-item-descriptor,
    new-item: network-item-descriptor,
  }

  record use-item-transaction-data {
    action-type: s32,
    trigger-type: u8,
    block-position: tuple<s32, s32, s32>,
    block-face: u8,
    hot-bar-slot: s32,
    hand: hand-slot,
    item-in-hand: network-item-descriptor,
    player-position: tuple<f64, f64, f64>,
    click-position: tuple<f64, f64, f64>,
    block-runtime-id: s32,
    client-prediction: u8,
    client-cooldown-state: u8,
  }

  record use-item-on-entity-transaction-data {
    target-entity-runtime-id: s64,
    action-type: s32,
    hot-bar-slot: s32,
    item-in-hand: network-item-descriptor,
    player-position: tuple<f64, f64, f64>,
    click-position: tuple<f64, f64, f64>,
  }

  record release-item-transaction-data {
    action-type: s32,
    hot-bar-slot: s32,
    item-in-hand: network-item-descriptor,
    head-position: tuple<f64, f64, f64>,
  }

  variant transaction-data {
    normal(string),
    mismatch(string),
    use-item(use-item-transaction-data),
    use-item-on-entity(use-item-on-entity-transaction-data),
    release-item(release-item-transaction-data),
  }

  /// Sent by the client when performing complex inventory interactions, item usages, and entity attacks.
  record s-inventory-transaction {
    /// Legacy transaction request ID used for rollback tracking.
    legacy-request-id: s32,
    /// Legacy slot modification entries.
    legacy-set-item-slots: list<legacy-set-item-slot>,
    /// Whether action elements are present in the transaction.
    has-value: bool,
    /// List of slot modification actions composing this transaction.
    actions: list<inventory-action>,
    /// Transaction category type (`Normal`, `Mismatch`, `ItemUse`, `ItemUseOnEntity`, `ItemRelease`).
    transaction-type: s32,
    /// Specialized transaction payload corresponding to the transaction type.
    transaction-data: transaction-data,
  }

  record player-use-item-transaction-data {
    action-type: s32,
    trigger-type: u8,
    block-position: tuple<s32, s32, s32>,
    block-face: u8,
    hot-bar-slot: s32,
    item-in-hand: network-item-descriptor,
    player-position: tuple<f64, f64, f64>,
    click-position: tuple<f64, f64, f64>,
    block-runtime-id: s32,
    client-prediction: u8,
    client-cooldown-state: u8,
  }

  record player-inventory-action {
    legacy-request-id: s32,
    legacy-slots: list<legacy-set-item-slot>,
    actions: list<inventory-action>,
    transaction: player-use-item-transaction-data,
  }

  record bedrock-shapeless-recipe {
    recipe-id: string,
    input: list<item-descriptor-count>,
    output: list<network-item-descriptor>,
    uuid: uuid,
    block: string,
    priority: s32,
    unlock-requirement: recipe-unlock-requirement,
    recipe-network-id: s32,
  }

  record bedrock-shaped-recipe {
    recipe-id: string,
    width: s32,
    height: s32,
    input: list<item-descriptor-count>,
    output: list<network-item-descriptor>,
    uuid: uuid,
    block: string,
    priority: s32,
    assume-symmetry: bool,
    unlock-requirement: recipe-unlock-requirement,
    recipe-network-id: s32,
  }

  variant bedrock-recipe {
    shapeless(bedrock-shapeless-recipe),
    shaped(bedrock-shaped-recipe),
  }

  /// Sent by the server to send all crafting and smelting recipes available in the world.
  record c-crafting-data {
    /// List of shaped and shapeless crafting recipes.
    recipes: list<bedrock-recipe>,
    /// Whether previous recipe entries should be cleared on the client.
    clean-recipes: bool,
  }

  record creative-group-info-payload {
    creative-category: creative-category,
    name: string,
    group-icon-item: network-item-descriptor,
  }

  record creative-item-entry-payload {
    id: s32,
    item: network-item-descriptor,
    group-index: s32,
  }

  /// Sent by the server to populate the creative inventory menu with item categories, groups, and items.
  record c-creative-content {
    /// Creative tab groups with category icons and display names.
    groups: list<creative-group-info-payload>,
    /// Individual creative item stack entries.
    entries: list<creative-item-entry-payload>,
  }

  /// Wrapped network item stack including its network ID for slot tracking.
  record item-stack-wrapper {
    /// Item runtime ID.
    id: s32,
    /// Stack count.
    stack-size: s32,
    /// Auxiliary metadata or damage value.
    aux-value: s32,
    /// Runtime block state identifier.
    block-runtime-id: s32,
    /// Item NBT data.
    nbt-data: nbt-tree,
    /// Allowed block placement filter.
    place-on-blocks: list<string>,
    /// Allowed block destruction filter.
    destroy-blocks: list<string>,
    /// Shield blocking tick counter.
    shield-blocking-tick: s64,
    /// Server-assigned unique network stack ID, if present.
    net-id: option<s32>,
  }

  /// Sent by the server to spawn a dropped item entity in the world.
  record c-add-item-actor {
    /// Persistent unique entity ID of the dropped item entity.
    target-actor-id: s64,
    /// Runtime entity ID for the current session.
    target-runtime-id: s64,
    /// Item stack representation of the dropped item.
    item: item-stack-wrapper,
    /// World spawn coordinates.
    position: tuple<f64, f64, f64>,
    /// Movement velocity vector.
    velocity: tuple<f64, f64, f64>,
    /// Metadata dictionary for the item entity.
    entity-data: string,
    /// Whether the item originated from fishing.
    is-from-fishing: bool,
  }

  /// Compact network item stack descriptor with unparsed raw extra data bytes.
  record network-item-stack-descriptor {
    /// Item runtime ID.
    id: s32,
    /// Stack count.
    stack-size: s32,
    /// Auxiliary metadata or damage value.
    aux-value: s32,
    /// Runtime block state identifier.
    block-runtime-id: s32,
    /// Serialized user data buffer (NBT, filters).
    extra-data: list<u8>,
    /// Unique network stack ID.
    net-id: option<s32>,
  }

  /// Sent by the client to update the item held or equipped in a mob or player slot.
  record s-mob-equipment {
    /// Runtime entity ID of the mob or player changing equipment.
    entity-runtime-id: s64,
    /// Item descriptor being equipped.
    item: network-item-stack-descriptor,
    /// Slot index in the container.
    slot: u8,
    /// Currently selected hotbar slot.
    selected-slot: u8,
    /// Container identifier (e.g. inventory or armor).
    container-id: u8,
  }

  /// Sent by the server to spawn another player client-side into the world.
  record c-add-player {
    /// UUID of the player being spawned.
    uuid: uuid,
    /// Player display username.
    player-name: string,
    /// Session-unique runtime entity ID for the player.
    target-runtime-id: s64,
    /// Platform-specific chat identifier string.
    platform-chat-id: string,
    /// Spawn coordinates in world space.
    position: tuple<f64, f64, f64>,
    /// Initial movement velocity.
    velocity: tuple<f64, f64, f64>,
    /// Pitch (x) and yaw (y) rotation angles.
    rotation: tuple<f64, f64>,
    /// Horizontal head yaw rotation angle.
    y-head-rotation: f32,
    /// Item stack currently held in the main hand.
    carried-item: network-item-stack-descriptor,
    /// Game mode of the player.
    player-game-type: game-type,
    /// Entity metadata flags and properties.
    entity-data: string,
    /// Dynamic Molang property synchronization.
    synced-properties: property-sync-data,
    /// Permissions and ability layers for this player.
    abilities-data: serialized-abilities-data,
    /// Vehicle and attachment links.
    actor-links: list<actor-link>,
    /// Unique device ID of the client device.
    device-id: string,
    /// Operating system platform of the player.
    build-platform: build-platform,
  }

  /// Sent by the server to show the item equipped or held by a mob or other player.
  record c-mob-equipment {
    /// Runtime entity ID of the equipped actor.
    target-runtime-id: s64,
    /// Item descriptor for the equipped item stack.
    item: network-item-stack-descriptor,
    /// Slot index within the container.
    slot: u8,
    /// Currently selected hotbar slot.
    selected-slot: u8,
    /// Container identifier (e.g. inventory or armor).
    container-id: u8,
  }

  /// Identifies the container or inventory screen segment referenced by an item stack request.
  enum container-name {
    anvil-input,
    anvil-material,
    anvil-result-preview,
    smithing-table-input,
    smithing-table-material,
    smithing-table-result-preview,
    armor,
    level-entity,
    beacon-payment,
    brewing-stand-input,
    brewing-stand-result,
    brewing-stand-fuel,
    combined-hot-bar-and-inventory,
    crafting-input,
    crafting-output-preview,
    recipe-construction,
    recipe-nature,
    recipe-items,
    recipe-search,
    recipe-search-bar,
    recipe-equipment,
    recipe-book,
    enchanting-input,
    enchanting-material,
    furnace-fuel,
    furnace-ingredient,
    furnace-result,
    horse-equip,
    hot-bar,
    inventory,
    shulker-box,
    trade-ingredient1,
    trade-ingredient2,
    trade-result-preview,
    offhand,
    compound-creator-input,
    compound-creator-output-preview,
    element-constructor-output-preview,
    material-reducer-input,
    material-reducer-output,
    lab-table-input,
    loom-input,
    loom-dye,
    loom-material,
    loom-result-preview,
    blast-furnace-ingredient,
    smoker-ingredient,
    trade2-ingredient1,
    trade2-ingredient2,
    trade2-result-preview,
    grindstone-input,
    grindstone-additional,
    grindstone-result-preview,
    stonecutter-input,
    stonecutter-result-preview,
    cartography-input,
    cartography-additional,
    cartography-result-preview,
    barrel,
    cursor,
    created-output,
    smithing-table-template,
    crafter-level-entity,
    dynamic,
    recipe-food,
    recipe-blocks,
    recipe-furnace-items,
  }

  /// Container identifier paired with an optional dynamic session ID for complex inventories.
  record full-container-name {
    /// Specific container slot category.
    container-name: container-name,
    /// Dynamic ID assigned to temporary containers (e.g. trading or crafting).
    dynamic-id: option<s32>,
  }

  record item-stack-request-slot-info {
    container-name: full-container-name,
    slot-id: u8,
    stack-id: s32,
  }

  record item-stack-request-action-take {
    count: u8,
    source: item-stack-request-slot-info,
    destination: item-stack-request-slot-info,
  }

  record item-stack-request-action-place {
    count: u8,
    source: item-stack-request-slot-info,
    destination: item-stack-request-slot-info,
  }

  record item-stack-request-action-swap {
    slot1: item-stack-request-slot-info,
    slot2: item-stack-request-slot-info,
  }

  record item-stack-request-action-drop {
    count: u8,
    source: item-stack-request-slot-info,
    randomly: bool,
  }

  record item-stack-request-action-destroy {
    count: u8,
    source: item-stack-request-slot-info,
  }

  record item-stack-request-action-consume {
    count: u8,
    source: item-stack-request-slot-info,
  }

  variant item-stack-request-action {
    take(item-stack-request-action-take),
    place(item-stack-request-action-place),
    swap(item-stack-request-action-swap),
    drop(item-stack-request-action-drop),
    destroy(item-stack-request-action-destroy),
    consume(item-stack-request-action-consume),
    create(item-stack-request-action-create),
    lab-table-combine,
    beacon-payment(item-stack-request-action-beacon-payment),
    mine-block(item-stack-request-action-mine-block),
    craft-recipe(item-stack-request-action-craft-recipe),
    craft-recipe-auto(item-stack-request-action-craft-recipe-auto),
    craft-creative(item-stack-request-action-craft-creative),
    optional(item-stack-request-action-optional),
    grindstone(item-stack-request-action-grindstone),
    loom(item-stack-request-action-loom),
    craft-non-implemented,
    craft-results-deprecated(item-stack-request-action-craft-results-deprecated),
  }

  /// An individual inventory request containing slot manipulation actions.
  record item-stack-request {
    /// Client-assigned sequence ID identifying this request for response correlation.
    request-id: s32,
    /// Ordered actions that modify inventory slots (take, place, swap, craft, etc.).
    actions: list<item-stack-request-action>,
    /// Filter strings for text filtering when renaming items.
    filter-strings: list<string>,
    /// Reason code for profanity or server filtering checks.
    filter-cause: s32,
  }

  /// A batch of item stack requests sent by the client to manipulate inventory slots.
  record s-item-stack-request {
    /// List of item stack requests to execute sequentially.
    requests: list<item-stack-request>,
  }

  /// Sent by the client every tick to transmit player movement, view orientation, and input state under server authoritative movement.
  record s-player-auth-input {
    /// Pitch rotation angle in degrees.
    pitch: f32,
    /// Yaw rotation angle in degrees.
    yaw: f32,
    /// Absolute player position in world space.
    position: tuple<f64, f64, f64>,
    /// Movement vector created from directional input controls (WASD / analog stick).
    move-vec: tuple<f64, f64>,
    /// Horizontal head yaw rotation angle in degrees.
    head-yaw: f32,
    /// Bitset of active input flags for the current tick.
    input-data: list<s64>,
    /// Input device mode used by the client (mouse, touch, gamepad).
    input-mode: s32,
    /// Client play mode (screen, VR, etc.).
    play-mode: s32,
    /// Touch or crosshair interaction model.
    interaction-model: s32,
    /// Pitch angle when an interaction occurred.
    interact-pitch: f32,
    /// Yaw angle when an interaction occurred.
    interact-yaw: f32,
    /// Client world simulation tick number.
    tick: s64,
    /// Positional delta since the previous input tick.
    delta: tuple<f64, f64, f64>,
    /// Optional block destruction or interaction actions executed during this tick.
    block-actions: option<list<player-block-action>>,
    /// Optional item use action performed during this tick.
    item-interaction: option<player-inventory-action>,
    /// Optional item stack request embedded into the movement tick.
    item-stack-request: option<item-stack-request>,
    /// Predicted vehicle rotation if riding an entity.
    vehicle-rotation: option<tuple<f64, f64>>,
    /// Unique entity ID of the ridden vehicle.
    vehicle-unique-id: option<s64>,
    /// Analog movement stick input values.
    analog-move: tuple<f64, f64>,
    /// Camera orientation vector for camera-relative movement.
    camera-orientation: tuple<f64, f64, f64>,
    /// Unclamped raw movement input vector.
    raw-move: tuple<f64, f64>,
  }

  /// Sent by the server to synchronize the entire contents of an inventory or container window.
  record c-inventory-content {
    /// Window ID of the container being populated.
    container-id: s32,
    /// Array of item stacks filling every slot of the container.
    slots: list<network-item-stack-descriptor>,
    /// Full container name descriptor with dynamic session ID.
    full-container-name: full-container-name,
    /// Storage item descriptor (e.g. shulker box item if inspecting inside a shulker).
    storage-item: network-item-stack-descriptor,
  }

  /// Sent by the server to update a single item slot within an open inventory container.
  record c-inventory-slot {
    /// Window ID of the container being updated.
    container-id: s32,
    /// Slot index within the container.
    slot: s32,
    /// Optional full container descriptor.
    full-container-name: option<full-container-name>,
    /// Optional storage item descriptor.
    storage-item: option<network-item-stack-descriptor>,
    /// New item stack descriptor placed into the slot.
    item: network-item-stack-descriptor,
  }

  record item-stack-response-container-info {
    full-container-name: full-container-name,
    slots: list<item-stack-response-slot-info>,
  }

  /// Status result and slot updates for an individual item stack request.
  record item-stack-response-info {
    /// Status code of the response (`0` = Success, `1` = Error).
    %result: u8,
    /// Request ID matching the client's `ItemStackRequest`.
    client-request-id: s32,
    /// Container slot updates applied as a consequence of the request.
    containers: list<item-stack-response-container-info>,
  }

  /// Sent by the server to approve or reject item stack requests and sync modified slots.
  record c-item-stack-response {
    /// List of response statuses corresponding to client requests.
    responses: list<item-stack-response-info>,
  }

  /// Compact representation of an item stack in network transactions with raw extra data bytes.
  record network-item-stack {
    /// Runtime item ID.
    id: s32,
    /// Stack count.
    count: s32,
    /// Auxiliary metadata or damage value.
    aux-value: s32,
    /// Runtime block state identifier.
    block-runtime-id: s32,
    /// Raw unparsed extra user data buffer.
    extra-data: list<u8>,
  }

  variant serverbound-packet {
    /// Transmits actor-specific animations, sounds, and state changes (such as hurt, taming, or eating).
    s-actor-event(s-actor-event),
    /// Plays animations (arm swing, critical strike particles, waking up) on an actor.
    s-animate(s-animate),
    /// Sent by the client when picking a targeted block (middle-click / pick block action).
    s-block-pick-request(s-block-pick-request),
    /// Sent by the client to report cache hits and misses for chunk blobs requested by the server.
    s-client-cache-blob-status(s-client-cache-blob-status),
    /// Sent by the client during login to inform the server whether client-side chunk blob caching is supported.
    s-client-cache-status(s-client-cache-status),
    /// Sent by the client to request server-side execution of a slash command.
    s-command-request(s-command-request),
    /// Sent by either client or server to close an open container inventory window.
    s-container-close(s-container-close),
    /// Transmits player emote animations to the server and broadcasts them to nearby players.
    s-emote(s-emote),
    /// Sent by the client to provide the server with a list of all emotes unlocked and equipped by the player.
    s-emote-list(s-emote-list),
    /// Sent by the client when interacting with an entity (mounting, NPC dialogue, opening inventory).
    s-interact(s-interact),
    /// Sent by the client when performing complex inventory interactions, item usages, and entity attacks.
    s-inventory-transaction(s-inventory-transaction),
    /// A batch of item stack requests sent by the client to manipulate inventory slots.
    s-item-stack-request(s-item-stack-request),
    /// Sent by the client to update the server on client-side loading screen transitions.
    s-loading-screen(s-loading-screen),
    /// Sent by the client to initiate the login handshake, containing authentication tokens and device information.
    s-login(s-login),
    /// Sent by the client to update the item held or equipped in a mob or player slot.
    s-mob-equipment(s-mob-equipment),
    /// Sent by the client in response to a server-sent modal form dialog.
    s-modal-form-response(s-modal-form-response),
    /// Sent by the client to report malformed or unexpected packets received from the server.
    s-packet-violation-warning(s-packet-violation-warning),
    /// Sent by the client when performing player actions such as mining, sprinting, sneaking, or dimensions changes.
    s-player-action(s-player-action),
    /// Sent by the client every tick to transmit player movement, view orientation, and input state under server authoritative movement.
    s-player-auth-input(s-player-auth-input),
    /// Sent by the Bedrock client when the player changes their active hotbar slot.
    s-player-hotbar(s-player-hotbar),
    /// Sent by the client to request permission to modify a player ability (such as flying).
    s-request-ability(s-request-ability),
    /// Sent by the client to request a specific chunk render distance from the server.
    s-request-chunk-radius(s-request-chunk-radius),
    /// Sent by the client to query network settings (such as compression algorithms and thresholds) from the server.
    s-request-network-settings(s-request-network-settings),
    /// Sent by the client during resource pack negotiation to acknowledge packs or request downloads.
    s-resource-pack-client-response(s-resource-pack-client-response),
    /// Bidirectional packet managing player respawning and client spawn readiness.
    s-respawn(s-respawn),
    /// Sent by the client after receiving PlayStatus(PlayerSpawn) to signal that world initialization is complete.
    s-set-local-player-as-initialized(s-set-local-player-as-initialized),
    /// Sent by the client to sync inventory UI layout options and selected crafting tabs.
    s-set-player-inventory-options(s-set-player-inventory-options),
    /// Transmits in-game chat messages, system alerts, popups, and raw JSON text between client and server.
    s-text(s-text),
    unknown,
  }

  variant clientbound-packet {
    /// Sent by the server to spawn non-player entities (mobs, projectiles, vehicles, items) on the client.
    c-add-actor(c-add-actor),
    /// Sent by the server to spawn a dropped item entity in the world.
    c-add-item-actor(c-add-item-actor),
    /// Sent by the server to spawn another player client-side into the world.
    c-add-player(c-add-player),
    /// Advertises available console and chat commands, arguments, overloads, and auto-completion structures.
    c-available-commands(c-available-commands),
    /// Sent by the server to synchronize all available biome definitions and properties with the client.
    c-biome-definition-list,
    /// Synchronizes the complete block-actor data for a block position.
    c-block-actor-data(c-block-actor-data),
    /// Updates a client-side block animation, such as a chest lid opening or closing.
    c-block-event(c-block-event),
    /// Sent by the server to make a specific 'boss event' occur in the world.
    ///
    /// Packet ID: `74`
    c-boss-event(c-boss-event),
    /// Transitions the player to a different dimension with a loading screen.
    c-change-dimension(c-change-dimension),
    /// Sent by the server in response to [`SRequestChunkRadius`](crate::bedrock::server::request_chunk_radius::SRequestChunkRadius) to confirm the approved chunk render distance.
    c-chunk-radius-updated(c-chunk-radius-updated),
    /// Sent by the server in response to [`SClientCacheBlobStatus`](crate::bedrock::server::client_cache_blob_status::SClientCacheBlobStatus) with requested chunk blobs.
    c-client-cache-miss-response(c-client-cache-miss-response),
    /// Sent by the server to open an inventory container screen (chest, furnace, anvil) on the client.
    c-container-open(c-container-open),
    /// Sent by the server to correct the client's predicted movement under server authoritative movement.
    c-correct-player-move-prediction(c-correct-player-move-prediction),
    /// Sent by the server to send all crafting and smelting recipes available in the world.
    c-crafting-data(c-crafting-data),
    /// Sent by the server to populate the creative inventory menu with item categories, groups, and items.
    c-creative-content(c-creative-content),
    /// Sent by the server to cleanly disconnect a client with an optional error code and kick message.
    c-disconnect(c-disconnect),
    /// Sent by the server to update gamerules on the client (e.g. `showcoordinates` or `dodaylightcycle`).
    c-gamerules-changed(c-gamerules-changed),
    /// Sent by the server to synchronize the entire contents of an inventory or container window.
    c-inventory-content(c-inventory-content),
    /// Sent by the server to update a single item slot within an open inventory container.
    c-inventory-slot(c-inventory-slot),
    /// Sent by the server to register custom and vanilla item identifiers with their component definitions.
    c-item-registry(c-item-registry),
    /// Sent by the server to approve or reject item stack requests and sync modified slots.
    c-item-stack-response(c-item-stack-response),
    /// Transmits server-defined jigsaw structure generation rules, processors, and template pools.
    c-jigsaw-structure-data,
    /// Broadcasts visual or auditory level-wide events, such as particles or block breaking.
    c-level-event(c-level-event),
    /// Plays a sound effect at a designated world position or associated with an actor.
    c-level-sound-event(c-level-sound-event),
    /// Sent by the server to add, modify, or remove potion/status effects on an entity.
    c-mob-effect(c-mob-effect),
    /// Sent by the server to show the item equipped or held by a mob or other player.
    c-mob-equipment(c-mob-equipment),
    /// Requests the client to open a server-defined UI form (modal dialog, list menu, or custom form).
    c-modal-form-request(c-modal-form-request),
    /// Sent by the server to update an entity's absolute position and rotation angles.
    c-move-actor-absolute(c-move-actor-absolute),
    /// Bandwidth-optimized delta movement packet for updating an entity's position and rotation.
    c-move-actor-delta(c-move-actor-delta),
    /// Sent by the server to update a player's movement, teleport, or view angle.
    c-move-player(c-move-player),
    /// Sent by the server to update the center anchor position and radius around which chunks remain loaded on the client.
    c-network-chunk-publisher-update(c-network-chunk-publisher-update),
    /// Sent by the server in response to [`SRequestNetworkSettings`](crate::bedrock::server::request_network_settings::SRequestNetworkSettings) to configure packet compression and client throttling.
    c-network-settings(c-network-settings),
    /// Sent by the server to inform the client of login results, version compatibility, or player spawn readiness.
    c-play-status(c-play-status),
    /// Sent by the server to update the active selected hotbar slot of the player.
    c-player-hotbar(c-player-hotbar),
    /// Sent by the server to add or remove players from the in-game pause screen player list.
    c-player-list(c-player-list),
    /// Sent by the server to despawn an entity from the client's world.
    c-remove-actor(c-remove-actor),
    /// Removes a scoreboard objective, hiding it from the player's screen.
    c-remove-objective(c-remove-objective),
    /// Sent by the server to define the order in which resource and behavior packs are applied by the client.
    c-resource-pack-stack-packet(c-resource-pack-stack-packet),
    /// Sent by the server to list all resource and behavior packs required or available to download.
    c-resource-packs-info(c-resource-packs-info),
    /// Sent by the server to update metadata and Molang properties of an entity (e.g. name tags, fire, scale).
    c-set-actor-data(c-set-actor-data),
    /// Sent by the server to create, modify, or remove an attachment link between two entities (e.g. riding).
    c-set-actor-link(c-set-actor-link),
    /// Sent by the server to set the movement velocity of an entity (e.g. knockback or explosion velocity).
    c-set-actor-motion(c-set-actor-motion),
    /// Synchronizes world difficulty level to the client.
    c-set-difficulty(c-set-difficulty),
    /// Configures and displays a scoreboard objective in a specific UI slot.
    c-set-display-objective(c-set-display-objective),
    /// Updates player health (legacy packet; attribute updates are typically preferred).
    c-set-health(c-set-health),
    /// Updates the player's active game mode (e.g. Survival, Creative, Spectator).
    c-set-player-game-type(c-set-player-game-type),
    /// Updates or removes scoreboard entries displayed to the client.
    c-set-score(c-set-score),
    /// Updates the player or world spawn coordinates, affecting respawning and compass orientation.
    c-set-spawn-position(c-set-spawn-position),
    /// Sent by the server to synchronize the day-night cycle time (in ticks) with the client.
    c-set-time(c-set-time),
    /// Displays or controls on-screen titles, subtitles, or action bar notices.
    c-set-title(c-set-title),
    /// Displays or dismisses the end-game rolling credits screen.
    c-show-credits(c-show-credits),
    /// Sent by the server to initialize the client's world, spawn coordinates, gamerules, and entity runtime ID.
    c-start-game(c-start-game),
    /// Sent by the server when an entity or player picks up a dropped item, playing the pickup animation.
    c-take-item-actor(c-take-item-actor),
    /// Instructs the client to disconnect and reconnect to another server address and port.
    c-transfer(c-transfer),
    /// Updates player movement and interaction abilities such as flight and build permissions.
    c-update-abilities(c-update-abilities),
    /// Sent by the server to update an entity's attribute values (e.g. health, absorption, movement speed, hunger).
    c-update-attributes(c-update-attributes),
    /// Updates a single block state client-side without retransmitting the entire chunk.
    c-update-block(c-update-block),
    /// Opens or refreshes a Bedrock merchant screen with its complete offer list.
    c-update-trade(c-update-trade),
    /// Sends custom collision and selection voxel shapes to the client.
    c-voxel-shapes,
    unknown,
  }
}

interface java-packets {
  use uuid.{uuid};
  use common.{nbt-tree};

  /// Sent by the client to inform the server about its local settings
  record config-s-client-information-config {
    /// The language code used by the client (e.g., "`en_us`")
    locale: string,
    /// The maximum number of chunks the client renders
    view-distance: u8,
    /// Visibility of chat messages (0: Enabled, 1: Commands Only, 2: Hidden)
    chat-mode: s32,
    /// Whether the client wants chat colors/formatting rendered
    chat-colors: bool,
    /// Bitmask representing displayed skin parts (e.g., cape, jacket, sleeves)
    skin-parts: u8,
    /// The player's dominant hand (0: Left, 1: Right)
    main-hand: s32,
    /// Whether the client wants text filtering (e.g., for profanity) enabled
    text-filtering: bool,
    /// Whether the player should appear in the server's online player list
    server-listing: bool,
  }

  /// Response to a `CCookieRequest` from the server during the configuration phase
  ///
  /// Cookies allow servers to store small amounts of data on the client side,
  /// which can be retrieved later (e.g., for session tracking or preferences)
  record config-s-config-cookie-response {
    /// The unique identifier for the cookie being returned
    key: string,
    /// Indicates whether a payload is attached to this response
    has-payload: bool,
    /// The actual data stored in the cookie. Limited to 5120 bytes
    payload: option<list<u8>>,
  }

  record config-s-custom-click-action {
    action-id: string,
    payload: option<list<u8>>,
  }

  record config-s-keep-alive {
    keep-alive-id: s64,
  }

  record config-s-known-packs {
    known-packs: list<string>,
  }

  /// A packet used for custom communication between the client and server.
  ///
  /// This allows mods, plugins, or proxy
  /// software to send proprietary data over the standard Minecraft protocol.
  record config-s-plugin-message {
    /// The name of the channel used to distinguish different types of messages.
    /// Example: `minecraft:brand` or `velocity:main`.
    channel: string,
    /// The payload sent by the client.
    data: list<u8>,
  }

  record config-s-config-pong {
    id: s32,
  }

  variant resource-pack-response-result {
    download-success,
    download-fail,
    downloaded,
    accepted,
    declined,
    invalid-url,
    reload-failed,
    discarded,
    unknown(s32),
  }

  /// Sent by the client to inform the server of the status of a requested resource pack.
  ///
  /// This allows the server to know if the player is using the required textures
  /// or if the download failed.
  record config-s-config-resource-pack {
    /// The unique identifier of the resource pack this response refers to.
    uuid: uuid,
    /// The status code of the operation, mapped to [`ResourcePackResponseResult`].
    %result: s32,
  }

  /// Response to a `CCookieRequest` (login) from the server.
  /// The Notchian server only accepts responses of up to 5 kiB in size.
  record login-s-login-cookie-response {
    key: string,
    payload: option<list<u8>>,
  }

  record s-encryption-response {
    shared-secret: list<u8>,
    verify-token: list<u8>,
  }

  record login-s-login-start {
    name: string,
    uuid: uuid,
  }

  record login-s-login-plugin-response {
    message-id: s32,
    data: option<list<u8>>,
  }

  record s-attack {
    entity-id: s32,
  }

  record s-block-entity-tag-query {
    transaction-id: s32,
    location: tuple<s32, s32, s32>,
  }

  record s-bundle-item-selected {
    slot-id: s32,
    selected-item-index: s32,
  }

  record s-change-difficulty {
    difficulty: string,
  }

