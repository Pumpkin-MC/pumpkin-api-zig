  /// Sent by the client to measure the round-trip time (latency) to the server.
  ///
  /// This is the second part of the Server List Ping (SLP) process
  /// The server should respond with `CPingResponse`.
  record status-s-status-ping-request {
    payload: s64,
  }

  record config-c-config-add-resource-pack {
    uuid: uuid,
    url: string,
    hash: string,
    forced: bool,
    prompt-message: option<string>,
  }

  record config-c-code-of-conduct {
    code-of-conduct: string,
  }

  record config-c-config-disconnect {
    reason: string,
  }

  /// Requests a cookie that was previously stored.
  record config-c-cookie-request {
    key: string,
  }

  record config-c-config-custom-report-details {
    details: list<tuple<string, string>>,
  }

  record config-c-feature-flags {
    features: list<string>,
  }

  record config-c-known-packs {
    known-packs: list<string>,
  }

  record config-c-config-ping {
    id: s32,
  }

  record config-c-plugin-message {
    channel: string,
    data: list<u8>,
  }

  record config-c-config-post-effects {
    effects: list<string>,
  }

  /// Added in 1.20.2
  record config-c-registry-data {
    registry-id: string,
    entries: list<string>,
  }

  record config-c-config-remove-resource-pack {
    uuid: option<uuid>,
  }

  record config-c-config-server-links {
    links: list<string>,
  }

  record config-c-config-show-dialog {
    dialog: string,
  }

  /// Stores some arbitrary data on the client, which persists between server transfers.
  /// The Notchian (vanilla) client only accepts cookies of up to 5 KiB in size.
  record config-c-store-cookie {
    key: string,
    payload: list<u8>,
  }

  record config-c-transfer {
    host: string,
    port: s32,
  }

  record config-c-update-tags {
    tags: list<string>,
  }

  /// Sent by the server to retrieve a previously stored cookie from the client.
  ///
  /// This occurs during the login phase, allowing the server to identify
  /// returning players or retrieve session data stored during a previous visit.
  record login-c-login-cookie-request {
    /// The unique identifier of the cookie being requested.
    key: string,
  }

  /// Sent by the server to initiate the encryption handshake.
  ///
  /// This packet provides the client with the server's public key and a
  /// verification token, allowing the client to generate a shared secret
  /// for secure communication.
  record c-encryption-request {
    /// The server's ID string. In modern Minecraft, this is usually
    /// an empty string unless the server is using legacy authentication.
    server-id: string,
    /// The server's DER-encoded RSA public key.
    public-key: list<u8>,
    /// A random bitstring used to verify that the client can correctly
    /// encrypt data with the server's public key.
    verify-token: list<u8>,
    /// Indicates whether the server is in "online mode" and requires
    /// Mojang authentication.
    should-authenticate: bool,
  }

  /// Sent by the server to reject a login attempt or kick a player during the login phase
  ///
  /// This is used for reasons such as the server being full, the player being banned,
  /// or version mismatches. After this packet is sent, the connection is closed.
  record login-c-login-disconnect {
    /// A JSON-encoded chat component explaining why the player was disconnected.
    json-reason: string,
  }

  /// Sent by the server to initiate a custom plugin messaging exchange during login.
  ///
  /// This is used by server software (like proxies or anti-cheats) to request
  /// information from a client-side mod before the player officially joins.
  record login-c-login-plugin-request {
    /// A unique ID for this request. The client must include this same ID
    /// in its response so the server can match them up.
    message-id: s32,
    /// The name of the custom channel (e.g., "velocity:main").
    channel: string,
    /// The raw payload data. Unlike standard plugin messages, this data
    /// is often serialized without a length prefix at the end of the packet.
    data: list<u8>,
  }

  /// Sent by the server to enable network compression for all subsequent packets.
  ///
  /// Once this packet is sent, both the server and the client must compress any
  /// packet with a size equal to or greater than the specified threshold.
  record login-c-set-compression {
    /// The packet size threshold (in bytes) at which compression is applied.
    ///
    /// Packets smaller than this are sent uncompressed. A negative threshold
    /// typically disables compression.
    threshold: s32,
  }

  /// Sent by the server to acknowledge a sequence of block changes initiated by the client.
  ///
  /// This packet is critical for preventing "ghost blocks" and synchronization issues.
  /// It tells the client that the server has processed all actions up to a specific point.
  record c-acknowledge-block-change {
    /// The ID of the last sequence processed by the server.
    ///
    /// The client increments this ID every time it starts a sequence of actions
    /// (like breaking or placing a block), and the server must mirror it back
    /// to confirm processing is complete.
    sequence-id: s32,
  }

  /// Updates the text displayed above the player's hotbar (the Action Bar).
  ///
  /// Unlike chat messages, Action Bar text is transient and generally used for
  /// non-critical status information like "Now entering: Wilderness" or
  /// mana/stamina counters.
  record c-action-bar {
    /// The text component to be displayed.
    action-bar: string,
  }

  record c-add-resource-pack {
    uuid: uuid,
    url: string,
    hash: string,
    forced: bool,
    prompt-message: option<string>,
  }

  record statistic {
    category-id: s32,
    statistic-id: s32,
    value: s32,
  }

  record c-award-stats {
    stats: list<statistic>,
  }

  /// Updates the visual "breaking" progress of a block for all clients.
  ///
  /// This packet controls the overlay of cracks that appear on a block when
  /// it is being mined. It is often used to show other players' mining progress.
  record c-set-block-destroy-stage {
    /// A unique ID for this destruction instance. Usually the miner's Entity ID.
    /// If multiple entities mine the same block, they must use different IDs.
    entity-id: s32,
    /// The coordinates of the block being destroyed.
    location: tuple<s32, s32, s32>,
    /// The destruction stage, typically a value from 0 to 9.
    /// Any value outside 0-9 (like -1) will remove the destruction overlay.
    destroy-stage: u8,
  }

  /// Updates the NBT data of a block entity (e.g., signs, chests, or banners).
  ///
  /// This packet is sent by the server when a block entity's state changes
  /// (like text on a sign) or when the block entity is loaded into the client's view.
  record c-block-entity-data {
    /// The world coordinates of the block entity.
    location: tuple<s32, s32, s32>,
    /// The type of block entity being updated (e.g., Mob Spawner, Command Block).
    r-type: s32,
    /// The raw NBT payload containing the block's specific data.
    nbt-data: list<u8>,
  }

  /// Triggers a physical block animation or sound effect.
  ///
  /// This is used for simple block interactions that don't necessarily change
  /// NBT data, such as chests opening/closing, pistons extending, or note blocks playing.
  record c-block-event {
    /// The coordinates where the event occurs.
    location: tuple<s32, s32, s32>,
    /// The ID of the action to perform. Meaning varies by block type.
    action-id: u8,
    /// A parameter for the action (e.g., note pitch or instrument).
    action-parameter: u8,
    /// The block type ID (e.g., `minecraft:chest`).
    /// Note: This is the block ID, not the state ID.
    block-type: s32,
  }

  /// Updates a single block state at a specific location in the world.
  ///
  /// This is the most common way to sync world changes to the client, such as
  /// when a player places a block, a fluid flows, or a redstone component toggles.
  record c-block-update {
    /// The world coordinates of the block being updated.
    location: tuple<s32, s32, s32>,
    /// The new block state ID.
    state-id: s32,
  }

  record bossevent-action-add {
    title: string,
    health: f32,
    color: s32,
    division: s32,
    %flags: u8,
  }

  record bossevent-action-update-style {
    color: s32,
    dividers: s32,
  }

  variant bossevent-action {
    add(bossevent-action-add),
    remove,
    update-health(f32),
    update-tile(string),
    update-style(bossevent-action-update-style),
    update-flags(u8),
  }

  /// Updates the "Boss Bar" displayed at the top of the player's screen.
  ///
  /// This packet is used to manage health bars for entities like the Ender Dragon
  /// or Wither, as well as custom progress bars for server events or raids.
  record c-boss-event {
    /// A unique identifier for this specific boss bar instance.
    uuid: uuid,
    /// The action to perform (Add, Remove, Update Health, etc.).
    action: bossevent-action,
  }

  /// Updates the center of the player's loaded chunk radius (the "view center").
  ///
  /// This packet tells the client which chunk coordinate it should use as the
  /// focal point for loading and unloading chunks. It is typically sent when
  /// a player moves across a chunk boundary.
  record c-center-chunk {
    /// The X coordinate of the center chunk.
    chunk-x: s32,
    /// The Z coordinate of the center chunk.
    chunk-z: s32,
  }

  /// Notifies the client of a change in the world's difficulty level or lock status.
  ///
  /// This updates the client's internal state, which affects certain UI elements
  /// and client-side behavior (though actual game logic like mob damage is
  /// primarily handled by the server).
  record c-change-difficulty {
    /// The current difficulty level of the world.
    ///
    /// * **0**: Peaceful
    /// * **1**: Easy
    /// * **2**: Normal
    /// * **3**: Hard
    difficulty: u8,
    /// Whether the difficulty is locked (Added in 1.14). If true, the client's difficulty
    /// toggle in the options menu will be disabled.
    locked: bool,
  }

  /// Notifies the client that the server has finished sending a batch of chunks.
  ///
  /// Introduced in modern protocol versions to optimize world loading, this packet
  /// allows the client to acknowledge the receipt of a group of chunks, helping
  /// the server regulate the flow of data and prevent network congestion.
  record c-chunk-batch-end {
    /// The number of chunks sent in the batch that just finished.
    batch-size: s32,
  }

  /// Heightmap data accompanying a chunk packet.
  record chunk-heightmaps {
    world-surface: option<list<s64>>,
    motion-blocking: option<list<s64>>,
    motion-blocking-no-leaves: option<list<s64>>,
  }

  /// Block entity metadata serialized in chunk packets.
  record chunk-block-entity {
    packed-xz: u8,
    y: s32,
    type-id: s32,
    data: nbt-tree,
  }

  record chunk-biome-entry {
    chunk-x: s32,
    chunk-z: s32,
    data: list<u8>,
  }

  record c-chunks-biomes {
    chunks: list<chunk-biome-entry>,
  }

  /// Removes any currently displayed Title or Subtitle from the player's screen.
  ///
  /// This packet is used to immediately hide titles that are currently in their
  /// "stay" or "fade-out" phases.
  record c-clear-title {
    /// If true, the client also resets the title timings (fade-in, stay, fade-out)
    /// to their default values (10, 70, 20 ticks).
    ///
    /// Set this to false if you want to clear the text but keep custom timings
    /// for the next title you send.
    reset: bool,
  }

  /// Notifies the client that a container (inventory, chest, etc.) has been closed.
  ///
  /// This is used by the server to force the player's UI to shut, for example,
  /// if the player moves too far away from a chest or if an NPC's trade window
  /// is invalidated.
  record c-close-container {
    /// The ID of the container window to close.
    ///
    /// A value of 0 usually refers to the player's own inventory, while higher
    /// values refer to active windows opened via previous packets.
    sync-id: s32,
  }

  /// Notifies the client that a player has died.
  ///
  /// This packet is responsible for triggering the death screen on the client
  /// and displaying the death message in the chat for the deceased player.
  record c-combat-death {
    /// The Entity ID of the player who died.
    player-id: s32,
    /// The death message to be displayed (e.g., "Player was pricked to death by a Cactus").
    message: string,
  }

  record c-combat-end {
    duration-ticks: s32,
  }

  record command-suggestion {
    suggestion: string,
    tooltip: option<string>,
  }

  /// Sent by the server to provide a list of "tab-completion" suggestions.
  ///
  /// This packet responds to a client's request for help with commands,
  /// appearing as a scrollable list of options while the player is typing
  /// in the chat bar.
  record c-command-suggestions {
    /// The unique ID of the request this response is for.
    /// This must match the ID sent by the client in the request packet.
    id: s32,
    /// The starting character index in the chat bar where the completion
    /// should be inserted.
    start: s32,
    /// The number of characters in the original text to replace with
    /// the suggestion.
    length: s32,
    /// The list of possible completions, which can include tooltips
    /// for extra context.
    matches: list<command-suggestion>,
  }

  record proto-node-type-literal {
    name: string,
    is-executable: bool,
    redirect-target: option<s32>,
    /// Added in 1.21.6. Indicates that the command node is restricted.
    restricted: bool,
  }

  record argument-type-float {
    min: option<f32>,
    max: option<f32>,
  }

  record argument-type-double {
    min: option<f64>,
    max: option<f64>,
  }

  record argument-type-integer {
    min: option<s32>,
    max: option<s32>,
  }

  record argument-type-long {
    min: option<s64>,
    max: option<s64>,
  }

  record argument-type-entity {
    %flags: u8,
  }

  record argument-type-score-holder {
    %flags: u8,
  }

  record argument-type-time {
    min: s32,
  }

  record argument-type-resource-or-tag {
    identifier: string,
  }

  record argument-type-resource-or-tag-key {
    identifier: string,
  }

  record argument-type-resource {
    identifier: string,
  }

  record argument-type-resource-key {
    identifier: string,
  }

  enum string-proto-arg-behavior {
    single-word,
    quotable-phrase,
    /// does not stop after a space
    greedy-phrase,
  }

  variant argument-type {
    %bool,
    float(argument-type-float),
    double(argument-type-double),
    integer(argument-type-integer),
    long(argument-type-long),
    %string(string-proto-arg-behavior),
    entity(argument-type-entity),
    game-profile,
    block-pos,
    column-pos,
    vec3,
    vec2,
    block-state,
    block-predicate,
    item-stack,
    item-predicate,
    color,
    hex-color,
    component,
    style,
    message,
    nbt-compound,
    nbt-tag,
    nbt-path,
    objective,
    objective-criteria,
    operation,
    particle,
    angle,
    rotation,
    scoreboard-slot,
    score-holder(argument-type-score-holder),
    swizzle,
    team,
    item-slot,
    item-slots,
    resource-location,
    function,
    entity-anchor,
    int-range,
    float-range,
    dimension,
    gamemode,
    time(argument-type-time),
    resource-or-tag(argument-type-resource-or-tag),
    resource-or-tag-key(argument-type-resource-or-tag-key),
    %resource(argument-type-resource),
    resource-key(argument-type-resource-key),
    resource-selector,
    template-mirror,
    template-rotation,
    heightmap,
    loot-table,
    loot-predicate,
    loot-modifier,
    dialog,
    uuid,
  }

  enum suggestion-providers {
    ask-server,
    all-recipes,
    available-sounds,
    summonable-entities,
  }

  record proto-node-type-argument {
    name: string,
    is-executable: bool,
    redirect-target: option<s32>,
    parser: argument-type,
    override-suggestion-type: option<suggestion-providers>,
    /// Added in 1.21.6. Indicates that the command node is restricted.
    restricted: bool,
  }

  variant proto-node-type {
    root,
    literal(proto-node-type-literal),
    argument(proto-node-type-argument),
  }

  record proto-node {
    children: list<s32>,
    node-type: proto-node-type,
  }

  /// Sends the entire command tree to the client for client-side parsing and tab-completion.
  ///
  /// Minecraft uses the "Brigadier" command system. This packet informs the client
  /// which commands exist, their arguments, and how they branch, allowing the
  /// client to highlight syntax errors in red before the command is even sent.
  record c-commands {
    /// A flat list of all nodes in the command graph.
    /// Nodes reference each other by their index in this array.
    nodes: list<proto-node>,
    /// The index of the "root" node in the `nodes` array.
    /// This is the entry point for all commands (the '/' symbol).
    root-node-index: s32,
  }

  /// Sent by the server to request a "cookie" (stored data) from the client.
  ///
  /// Introduced in modern Minecraft versions, cookies allow servers to store
  /// small amounts of persistent data on the client side that can be retrieved
  /// even across different server instances or sub-servers in a network.
  record c-play-cookie-request {
    /// The unique identifier (namespace:path) of the cookie to retrieve.
    key: string,
  }

  record c-custom-chat-completions {
    action: s32,
    entries: list<string>,
  }

  /// A packet used for custom communication between the server and client.
  record c-custom-payload {
    channel: string,
    data: list<u8>,
  }

  record c-play-custom-report-details {
    details: list<tuple<string, string>>,
  }

  /// Notifies the client that an entity has taken damage.
  ///
  /// This packet is used to trigger damage animations (like the red tint on mobs),
  /// directional knockback visuals, and sound effects. It provides the client
  /// with specific details about the damage source to ensure the visual feedback
  /// matches the cause.
  record c-damage-event {
    /// The Entity ID of the entity taking damage.
    entity-id: s32,
    /// The ID of the damage type (references the `minecraft:damage_type` registry).
    /// Examples: `magic`, `fall`, `on_fire`, or `arrow`.
    source-type-id: s32,
    /// The Entity ID of the actual cause of the damage (e.g., the player who shot the arrow).
    /// Set to 0 if there is no specific entity cause.
    source-cause-id: s32,
    /// The Entity ID of the direct damager (e.g., the arrow entity itself).
    /// Set to 0 if this is the same as the cause or if not applicable.
    source-direct-id: s32,
    /// The coordinates of the damage source. Used by the client to calculate
    /// the direction of the "damage tilt" camera effect.
    source-position: option<tuple<f64, f64, f64>>,
  }

  record c-debug-block-value {
    pos: tuple<s32, s32, s32>,
    name: string,
    value: string,
  }

  record c-debug-chunk-value {
    chunk-pos: tuple<f64, f64>,
    name: string,
    value: string,
  }

  record c-debug-entity-value {
    entity-id: s32,
    name: string,
    value: string,
  }

  record c-debug-event {
    name: string,
    data: list<u8>,
  }

  record c-debug-sample {
    sample: list<s64>,
    sample-type: s32,
  }

  record c-delete-chat {
    signature-id: s32,
    signature: option<list<u8>>,
  }

  /// Forces the client to disconnect from the server while in the "Play" state.
  ///
  /// This packet displays the provided reason to the player on a dedicated
  /// disconnection screen. It is used for kicks, server shutdowns, or when
  /// a player is banned.
  record c-play-disconnect {
    /// The message shown to the player explaining why they were disconnected.
    /// This supports full JSON formatting (colors, bold, links, etc.).
    reason: string,
  }

  /// Sends a chat message that is not cryptographically signed by a player.
  ///
  /// Introduced to support server-side "disguised" identities (like /say or NPC chat),
  /// this packet bypasses the player-to-player chat signing requirements while
  /// still allowing the client to format the message using the standard chat registry.
  record c-disguised-chat-message {
    /// The raw content of the message.
    message: string,
    /// An index into the `minecraft:chat_type` registry.
    /// This determines the decoration (e.g., "<%s> %s" or "[%s -> %s] %s").
    chat-type: s32,
    /// The name shown as the "sender" of the message.
    sender-name: string,
    /// The optional name shown as the "target" (used for private messages/whispers).
    target-name: option<string>,
  }

  /// Instructs the client to display a specific scoreboard objective in a given slot.
  ///
  /// This packet is the final step in showing a scoreboard to a player. After
  /// an objective is created and populated with scores, this packet "maps"
  /// that objective to a visual location like the sidebar or the player list.
  record c-display-objective {
    /// The display slot/position for the objective.
    position: s32,
    /// The unique internal name of the objective to be displayed.
    /// To hide an objective in a specific slot, send an empty string.
    score-name: string,
  }

  /// Triggers a specific animation for an entity that is visible to the client.
  ///
  /// This is primarily used for player-driven animations like swinging an arm
  /// or showing damage, but it can apply to other entities as well.
  record c-entity-animation {
    /// The Entity ID of the entity performing the animation.
    entity-id: s32,
    /// The ID of the animation to play.
    /// See the table below for standard values.
    animation: u8,
  }

  /// Plays the swing animation of an entity's hand.
  ///
  /// Up to 26.2 this was an animation of [`CEntityAnimation`], since 26.3 it is its own packet that
  /// also carries the swing animation of the held item.
  record c-swing-arm {
    entity-id: s32,
    off-hand: bool,
  }

  enum animation {
    swing-main-arm,
    leave-bed,
    swing-offhand,
    critical-effect,
    magic-criticaleffect,
  }

  /// Updates the "Data Tracker" values for an entity.
  ///
  /// Entity Metadata (or `DataWatchers`) controls persistent visual states that
  /// don't require a full packet to update, such as whether an entity is on fire,
  /// crouching, glowing, or the custom name displayed above its head.
  record c-set-entity-metadata {
    /// The Entity ID of the entity whose metadata is being updated.
    entity-id: s32,
    /// A serialized collection of metadata entries.
    /// Ends with a terminal byte (0xFF).
    metadata: list<u8>,
  }

  /// Updates the exact position, rotation, and velocity of an entity.
  ///
  /// This packet is used for server-side authority over entity movement.
  /// In the latest protocol versions, this replaces several older "Relative Move"
  /// packets to provide more precise synchronization and reduce "rubber-banding."
  ///
  /// Note: This packet must NOT be used for the player receiving the packet or
  /// any entity the player is currently riding.
  record c-entity-position-sync {
    /// The Entity ID of the entity being moved.
    entity-id: s32,
    /// The absolute position of the entity in the world.
    position: tuple<f64, f64, f64>,
    /// The current velocity (delta) of the entity, used by the client
    /// for smooth interpolation.
    delta: tuple<f64, f64, f64>,
    /// The absolute yaw (horizontal rotation) in degrees.
    yaw: f32,
    /// The absolute pitch (vertical rotation) in degrees.
    pitch: f32,
    /// Whether the entity is currently touching the ground.
    on-ground: bool,
  }

  /// Plays a sound effect that originates from a specific entity.
  ///
  /// Unlike global sounds, this sound will follow the entity as it moves
  /// through the world. The client handles the panning and attenuation
  /// (volume drop-off) based on the distance between the player and the entity.
  record c-entity-sound-effect {
    /// The sound to play. Can be a hardcoded ID or a custom `SoundEvent`
    /// (Resource Location).
    sound-event: string,
    /// The category of the sound (e.g., Master, Music, Weather, Players).
    /// Used by the client to apply volume sliders from settings.
    sound-category: s32,
    /// The Entity ID that the sound is "attached" to.
    entity-id: s32,
    /// The loudness of the sound (usually 1.0).
    volume: f32,
    /// The playback speed/pitch (0.5 to 2.0).
    pitch: f32,
    /// A random seed used for sound variations (like different pitch shifts
    /// for the same sound).
    seed: s64,
  }

  /// Sends a status update for a specific entity.
  ///
  /// This packet is a "catch-all" for various entity triggers that don't
  /// warrant a complex packet of their own. It primarily handles visual
  /// and logical state triggers, such as tool breaking, totem usage,
  /// or sheep shearing.
  record c-entity-status {
    /// The Entity ID of the entity affected by the status change.
    entity-id: s32,
    /// The ID of the status/event to trigger.
    /// See the table below for common entity statuses.
    entity-status: u8,
  }

  /// Updates the velocity of an entity.
  ///
  /// This packet informs the client of a sudden change in an entity's movement,
  /// such as knockback from an attack, explosions, or being launched by a piston.
  record c-entity-velocity {
    /// The Entity ID of the entity whose velocity is being set
    entity-id: s32,
    /// The velocity vector
    velocity: string,
  }

  /// Notifies the client that an explosion has occurred.
  ///
  /// This is a high-level packet that handles the visual, auditory, and physical
  /// effects of an explosion in a single call. It triggers the explosion particles,
  /// plays the sound at the source, and applies knockback to the player.
  record c-explosion {
    /// The center coordinates of the explosion.
    center: tuple<f64, f64, f64>,
    /// The strength/radius of the explosion.
    /// Higher values increase the visual size of the particle effect.
    radius: f32,
    /// The number of blocks affected/destroyed.
    block-count: s32,
    /// The impulse/knockback applied to the player receiving this packet.
    /// If None, no velocity change is applied.
    knockback: option<tuple<f64, f64, f64>>,
    /// The ID of the particle to use for the explosion (e.g., `minecraft:explosion_emitter`).
    particle: s32,
    /// The sound to play (e.g., `minecraft:entity.generic.explode`).
    sound: string,
    /// The size of the block particles pool, used for debris visuals in 1.21.9+.
    block-particles-pool-size: s32,
  }

  /// Updates the game state or triggers specific environmental changes.
  ///
  /// This packet is the primary way the server communicates global or
  /// context-specific transitions, such as changing the weather,
  /// altering the player's gamemode, or displaying the credits.
  record c-game-event {
    /// The ID of the event type.
    event: u8,
    /// A value associated with the event (usage depends on the event ID).
    value: f32,
  }

  enum game-event {
    no-respawn-block-available,
    begin-raining,
    end-raining,
    change-game-mode,
    win-game,
    demo-event,
    arrow-hit-player,
    rain-level-change,
    thunder-level-change,
    play-pufferfish-string-sound,
    play-elder-guardian-mob-appearance,
    enabled-respawn-screen,
    limited-crafting,
    start-waiting-chunks,
  }

  record c-game-rule-values {
    rules: list<tuple<string, string>>,
  }

  record c-game-test-highlight-pos {
    pos: tuple<s32, s32, s32>,
    color: s32,
    label: string,
    duration-ms: s32,
  }

  /// Rotates an entity's head to a specific yaw.
  ///
  /// In Minecraft, an entity's "body yaw" and "head yaw" are separate.
  /// While standard movement packets update the body, this packet is
  /// required to make an entity (like a player or a mob) look in a
  /// specific direction without necessarily turning its entire body.
  record c-head-rot {
    /// The Entity ID of the entity whose head is rotating.
    entity-id: s32,
    /// The new head yaw, in steps of 1/256 of a full turn (0-255).
    head-yaw: u8,
  }

  /// Triggers the "hurt" visual effect on an entity.
  ///
  /// This packet causes the entity to turn red and perform a directional
  /// camera shake or model tilt. It is typically sent immediately after
  /// an entity's health is reduced.
  record c-hurt-animation {
    /// The Entity ID of the entity that was hurt.
    entity-id: s32,
    /// The yaw (direction) from which the damage originated.
    /// This determines the direction the entity's model tilts.
    yaw: f32,
  }

  /// Fully initializes the world border for the client.
  ///
  /// This packet is sent when a player joins the world or changes dimensions.
  /// It synchronizes the current position, size, and all warning parameters
  /// to ensure the client-side visual barrier matches the server's authority.
  record c-initialize-world-border {
    /// The X coordinate of the center of the world border.
    x: f64,
    /// The Z coordinate of the center of the world border.
    z: f64,
    /// The diameter the border is moving from.
    old-diameter: f64,
    /// The diameter the border is moving toward.
    new-diameter: f64,
    /// The time (in milliseconds) it will take to reach `new_diameter`.
    speed: s64,
    /// The maximum distance a player can be teleported by a portal
    /// before the border prevents the teleport.
    portal-teleport-boundary: s32,
    /// Distance in blocks from the border where the screen starts to tint red.
    warning-blocks: s32,
    /// Time in seconds that a player must be on a collision course with
    /// the border before the warning tint appears.
    warning-time: s32,
  }

  record c-item-cooldown {
    group: string,
    cooldown: s32,
  }

  /// Maintains the connection and measures latency (ping) between client and server.
  ///
  /// The server sends this packet at regular intervals (typically every 15–20 seconds).
  /// The client must respond with the exact same ID. If the server does not receive
  /// a response within a timeout period (usually 30 seconds), it will disconnect
  /// the player with a "Timed Out" message.
  record c-keep-alive {
    /// A unique random identifier for this specific keep-alive request.
    /// Used to match the server's request with the client's response.
    keep-alive-id: s64,
  }

  /// Triggers a specific sound or particle effect at a world location.
  ///
  /// This packet handles a wide variety of "world-level" events, such as
  /// block breaking particles, firework explosions, or ambient sounds
  /// like doors opening and portals humming.
  record c-level-event {
    /// The ID of the event to trigger.
    /// Event IDs are generally divided into Sound Events (1000s) and
    /// Particle/Visual Events (2000s).
    event: s32,
    /// The world coordinates where the event occurs.
    location: tuple<s32, s32, s32>,
    /// Event-specific data (e.g., the block ID for break particles
    /// or the direction of a smoke puff).
    data: s32,
    /// If true, the sound is played at a constant volume regardless of
    /// the player's distance from the `location`.
    disable-relative-volume: bool,
  }

  record light-data {
    trust-edges: bool,
    sky-light-mask: list<s64>,
    block-light-mask: list<s64>,
    empty-sky-light-mask: list<s64>,
    empty-block-light-mask: list<s64>,
    sky-light-arrays: list<list<u8>>,
    block-light-arrays: list<list<u8>>,
  }

  /// The chunk data and light packet sent to clients (`LEVEL_CHUNK_WITH_LIGHT`).
  ///
  /// Contains chunk position, heightmaps, pre-encoded section and biome payload,
  /// block entities, and lighting data.
  record c-chunk-data {
    chunk-x: s32,
    chunk-z: s32,
    heightmaps: chunk-heightmaps,
    data: list<u8>,
    block-entities: list<chunk-block-entity>,
    light-data: light-data,
  }

  /// Sent by the server to update light levels (block light and sky light) for a chunk.
  ///
  /// This packet updates lighting data for a specific chunk without sending the full chunk data.
  /// It was introduced in Minecraft 1.14 (protocol version 477).
  record c-light-update {
    chunk-x: s32,
    chunk-z: s32,
    light-data: light-data,
  }

  record map-icon {
    icon-type: s32,
    x: u8,
    z: u8,
    direction: u8,
    display-name: option<string>,
  }

  record map-patch {
    columns: u8,
    rows: u8,
    x: u8,
    z: u8,
    data: list<u8>,
  }

  record c-map-item-data {
    map-id: s32,
    scale: u8,
    tracking-position: bool,
    locked: bool,
    icons: option<list<map-icon>>,
    data: option<map-patch>,
  }

  record merchant-offer {
    base-cost-a: string,
    output: string,
    cost-b: option<string>,
    reward-exp: bool,
    uses: s32,
    max-uses: s32,
    xp: s32,
    special-price: s32,
    price-multiplier: f32,
    demand: s32,
  }

  record c-merchant-offers {
    window-id: s32,
    offers: list<merchant-offer>,
    villager-level: s32,
    experience: s32,
    is-regular-villager: bool,
    can-restock: bool,
  }

  record minecart-step {
    position: tuple<f64, f64, f64>,
    movement: tuple<f64, f64, f64>,
    yaw: f32,
    pitch: f32,
    weight: f32,
  }

  record c-move-minecart-along-track {
    entity-id: s32,
    steps: list<minecart-step>,
  }

  record c-move-vehicle {
    x: f64,
    y: f64,
    z: f64,
    yaw: f32,
    pitch: f32,
  }

  /// Updates multiple blocks within a single chunk section (or chunk in older versions).
  ///
  /// This packet is much more efficient than sending multiple individual
  /// `CBlockUpdate` packets when many changes occur in the same area
  /// (e.g., explosions, structure generation, or large-scale terraforming).
  record c-multi-block-update {
    /// Chunk section position (x, y, z)
    chunk-section: tuple<f64, f64, f64>,
    /// Suppress light updates (used in 1.16..=1.19.4)
    suppress-light-updates: bool,
    /// Array of block updates: (`BlockPos`, `BlockStateId`)
    updates: list<tuple<tuple<s32, s32, s32>, string>>,
  }

  record c-open-book {
    hand: s32,
  }

  record c-open-mount-screen {
    window-id: u8,
    slot-count: s32,
    entity-id: s32,
  }

  /// Instructs the client to open a specific type of GUI (inventory, chest, etc.).
  ///
  /// This packet is sent when a player interacts with a block (like a chest)
  /// or when a command/plugin forces an interface to open. It establishes a
  /// `sync_id` which must be used in all subsequent "Set Slot" or "Click Slot"
  /// packets to ensure the server and client are talking about the same window.
  record c-open-screen {
    /// A unique identifier for the current window session.
    /// Typically increments by 1 for every new window opened.
    sync-id: s32,
    /// The ID of the window type to open (e.g., Generic 9x3, Crafting Table).
    /// See the table below for standard IDs.
    window-type: s32,
    /// The title displayed at the top of the GUI.
    /// Supports full JSON formatting (colors, bold, etc.).
    window-title: string,
  }

  /// Opens the sign text input screen for the client.
  ///
  /// This packet is sent by the server to force the client to show the
  /// sign editing interface. This usually happens immediately after a
  /// player places a sign or interacts with an existing one (if allowed).
  record c-open-sign-editor {
    /// The world coordinates of the sign block to be edited.
    location: tuple<s32, s32, s32>,
    /// Whether the editor should open the front or the back of the sign.
    /// Introduced in the 1.20 "Trails & Tales" update for double-sided signs.
    is-front-text: bool,
  }

  /// Spawns a cluster of particles at a specific location.
  ///
  /// This is the most versatile visual packet in the protocol. It allows for
  /// precise control over particle density, spread, and speed. It can also
  /// carry extra data for complex particles like redstone dust (color) or
  /// block/item breaking (textures).
  record c-particle {
    /// If true, the particle renders even if the client's "Particles"
    /// setting is set to "Minimal".
    force-spawn: bool,
    /// If true, the distance at which particles are visible is significantly
    /// increased (from 256 to 65536 blocks). Often used for massive events.
    important: bool,
    /// The absolute center position of the particle cluster.
    position: tuple<f64, f64, f64>,
    /// The maximum distance from the center that particles can spawn.
    offset: tuple<f64, f64, f64>,
    /// The velocity or "spread" speed of the particles.
    max-speed: f32,
    /// The total number of particles to spawn in this cluster.
    particle-count: s32,
    /// The ID of the particle type (e.g., `minecraft:flame`).
    particle-id: s32,
    /// Extra data required by specific particles (e.g., block states for
    /// `block` particles or RGB values for `dust`).
    data: list<u8>,
  }

  record c-play-ping {
    id: s32,
  }

  /// Responds to a client-initiated ping request to synchronize game state.
  record c-ping-response {
    /// The unique identifier sent by the client in the initial Ping packet.
    /// The server must return this exact value.
    payload: s64,
  }

  record c-place-ghost-recipe {
    window-id: u8,
    recipe-id: string,
  }

  /// Updates the player's movement and interaction abilities.
  ///
  /// This packet informs the client about the player's state (flying, invulnerable)
  /// and sets the movement speeds. While the client applies these visuals,
  /// the server must still validate these states to prevent cheating.
  record c-player-abilities {
    /// A bitmask of player states.
    /// Bit 0 (0x01): Invulnerable (Creative mode)
    /// Bit 1 (0x02): Flying
    /// Bit 2 (0x04): Allow Flying
    /// Bit 3 (0x08): Creative Mode (Instant Break)
    %flags: u8,
    /// The multiplier for flying speed.
    /// Default is 0.05.
    flying-speed: f32,
    /// The field of view modifier (Walking speed multiplier).
    /// Default is 0.1.
    field-of-view: f32,
  }

  record init-chat {
    session-id: uuid,
    expires-at: s64,
    public-key: list<u8>,
    signature: list<u8>,
  }

  record previous-message {
    id: s32,
    signature: option<list<u8>>,
  }

  variant filter-type {
    /// Message is not filtered at all
    pass-through,
    /// Message is fully filtered
    fully-filtered,
    /// Only some characters in the message are filtered
    partially-filtered(list<s64>),
  }

  /// Sends a cryptographically signed player chat message to the client.
  ///
  /// This packet is the backbone of the modern secure chat system. It includes
  /// tracking indices, digital signatures, and context for reporting.
  record c-player-chat-message {
    /// Incremental index for messages sent TO this specific client.
    /// Starts at 0 on login; client disconnects if the sequence is broken.
    global-index: s32,
    /// The UUID of the player who sent the message.
    sender: uuid,
    /// Incremental index for messages sent BY the sender player.
    /// Used by the client to verify the order of the sender's history.
    index: s32,
    /// The RSA signature (256 bytes) verifying the message's authenticity.
    message-signature: option<list<u8>>,
    /// The raw plain-text content of the message.
    message: string,
    /// Epoch timestamp (milliseconds) when the message was sent.
    timestamp: s64,
    /// A random 64-bit value used to ensure signature uniqueness.
    salt: s64,
    /// Last 20 message signatures seen by the sender, providing context
    /// for chat reporting and ensuring no messages were omitted.
    previous-messages: list<previous-message>,
    /// Optional formatted version of the message (e.g., if the server
    /// added colors or links that aren't in the signed raw text).
    unsigned-content: option<string>,
    /// Indicates if the message should be hidden or partially masked
    /// by the client's profanity filter.
    filter-type: filter-type,
    /// ID of the chat type registry entry (e.g., "chat", "`say_command`").
    /// Usually `(index + 1)`.
    chat-type: s32,
    /// The display name of the sender.
    sender-name: string,
    /// The display name of the target (used in private messages).
    target-name: option<string>,
  }

  record c-player-look-at {
    from-anchor: s32,
    target-x: f64,
    target-y: f64,
    target-z: f64,
    entity: option<tuple<s32, s32>>,
  }

  /// Updates the player's position and rotation on the client.
  ///
  /// Commonly known as the "Teleport Packet," this is sent by the server to
  /// force a change in the player's location. The client must respond with a
  /// `Teleport Confirm` packet matching the `teleport_id`.
  record c-player-position {
    /// A unique ID for this teleport. The client must echo this back
    /// to confirm the teleport was processed.
    teleport-id: s32,
    /// The absolute or relative target position.
    position: tuple<f64, f64, f64>,
    /// The intended velocity of the player after teleporting.
    delta: tuple<f64, f64, f64>,
    /// The horizontal rotation (0-360 degrees).
    yaw: f32,
    /// The vertical rotation (-90 to 90 degrees).
    pitch: f32,
    /// A set of flags determining which of the above fields are relative (~).
    relatives: list<string>,
  }

  /// Sent by the server to remove one or more players from the client's player list (tab list).
  ///
  /// This packet is typically used when a player leaves the server or becomes invisible
  /// to the recipient (e.g., moving out of tracking range).
  record c-remove-player-info {
    /// A list of UUIDs corresponding to the players that should be removed.
    players: list<uuid>,
  }

  record c-player-rotation {
    yaw: f32,
    pitch: f32,
  }

  record player-spawn-data {
    /// The Dimension for the current dimension's properties (lighting, sky color).
    dimension: string,
    /// Used by the client to seed local biome noise and decoration algorithms.
    hashed-seed: s64,
    game-mode: u8,
    /// The previous gamemode (used for the F3+F4 toggle UI). -1 if none.
    previous-gamemode: u8,
    /// If true, the world is a debug world (all blocks shown in a grid).
    debug: bool,
    /// If true, the world is a flat world (affects the horizon rendering).
    is-flat: bool,
    /// The location where the player last died (Added in 1.19, used for the recovery compass).
    death-dimension-name: option<tuple<string, tuple<s32, s32, s32>>>,
    /// Added in 1.20.
    portal-cooldown: s32,
    /// The height of the ocean level, usually 63 (Added in 1.21.2).
    sealevel: s32,
  }

  /// The "Join Game" packet that transitions the client from the Configuration state
  /// to the Play state.
  ///
  /// This is one of the largest and most important packets in the protocol. It
  /// initializes the player's world view, dimension settings, and local game
  /// rules. Once received, the client begins rendering the world.
  record c-login {
    /// The unique ID assigned to the player for the current session.
    entity-id: s32,
    is-hardcore: bool,
    /// A list of all dimensions present on the server (Added in 1.16).
    dimension-names: list<string>,
    max-players: s32,
    /// The number of chunks the client will render in each direction (Added in 1.14).
    view-distance: s32,
    /// The distance at which entities and world ticks are processed (Added in 1.18).
    simulated-distance: s32,
    /// If true, hides coordinates and other info from the F3 screen (Added in 1.8).
    reduced-debug-info: bool,
    /// Added in 1.15.
    enabled-respawn-screen: bool,
    /// Added in 1.19.3.
    limited-crafting: bool,
    spawn-data: player-spawn-data,
    /// Added in 26.2.
    online-mode: bool,
    /// If true, the client will warn the player if they send unsigned chat messages (Added in 1.20.5).
    enforce-secure-chat: bool,
  }

  /// Sent by the server to set the client's default spawn point and compass target.
  ///
  /// This packet updates where the player will respawn upon death (if no bed or anchor is set)
  /// and dictates the coordinates that a compass will point toward.
  record c-player-spawn-position {
    /// The namespaced ID of the dimension (e.g., "minecraft:overworld").
    /// Required for the client to determine if the spawn point is in their current world.
    /// (1.21.9+)
    dimension-name: string,
    /// The X, Y, and Z coordinates of the spawn location.
    location: tuple<s32, s32, s32>,
    /// The horizontal rotation (0-360 degrees) the player's camera should face upon respawning.
    /// (1.17+)
    yaw: f32,
    /// The vertical rotation (-90 to 90 degrees) the player's camera should face upon respawning.
    /// (1.21.9+)
    pitch: f32,
  }

  record c-post-effects {
    effects: list<string>,
  }

  record c-projectile-power {
    entity-id: s32,
    x-power: f64,
    y-power: f64,
    z-power: f64,
  }

  /// Clientbound packet that adds recipes to the client's recipe book.
  /// `replace = true` means the client replaces its current recipe list.
  record c-recipe-book-add {
    replace: bool,
  }

  record c-recipe-book-remove {
    recipes: list<s32>,
  }

  /// Sent by the server to update the player's recipe book open/filter state.
  ///
  /// Wire format: 4 `TypeSettings` pairs (crafting, furnace, `blast_furnace`, smoker),
  /// each pair is (`is_open`: bool, `is_filtering`: bool).
  record c-recipe-book-settings {
    crafting-open: bool,
    crafting-filtering: bool,
    furnace-open: bool,
    furnace-filtering: bool,
    blast-furnace-open: bool,
    blast-furnace-filtering: bool,
    smoker-open: bool,
    smoker-filtering: bool,
  }

  /// Sent by the server to instruct the client to remove (despawn) one or more entities.
  ///
  /// This is typically sent when an entity leaves the player's tracking range,
  /// is killed, or is otherwise removed from the world.
  record c-remove-entities {
    /// A list of entity IDs to be removed.
    entity-ids: list<s32>,
  }

  record c-remove-mob-effect {
    entity-id: s32,
    effect-id: s32,
  }

  record c-remove-resource-pack {
    uuid: option<uuid>,
  }

  record c-reset-score {
    entity-name: string,
    objective-name: option<string>,
  }

  record c-respawn {
    player-spawn-info: player-spawn-data,
    data-kept: u8,
  }

  record c-select-advancements-tab {
    tab-id: option<string>,
  }

  record c-server-data {
    motd: string,
    icon-base64: option<string>,
  }

  record c-play-server-links {
    links: list<string>,
  }

  record c-set-border-center {
    x: f64,
    z: f64,
  }

  record c-set-border-lerp-size {
    old-diameter: f64,
    new-diameter: f64,
    speed: s64,
  }

  record c-set-border-size {
    diameter: f64,
  }

  record c-set-border-warning-delay {
    warning-time: s32,
  }

  record c-set-border-warning-distance {
    warning-blocks: s32,
  }

  record c-set-camera {
    camera-id: s32,
  }

  record c-set-chunk-cache-radius {
    radius: s32,
  }

  record c-set-container-content {
    window-id: s32,
    state-id: s32,
    slot-data: list<string>,
    carried-item: string,
  }

  record c-set-container-property {
    window-id: s32,
    property: s32,
    value: s32,
  }

  record c-set-container-slot {
    window-id: u8,
    state-id: s32,
    slot: s32,
    slot-data: string,
  }

  record c-set-cursor-item {
    stack: string,
  }

  /// Sent by the server to attach (leash) or detach an entity to another entity (e.g. leash knot, player, mob).
  record c-set-entity-link {
    attached-entity-id: s32,
    holding-entity-id: s32,
    leash: bool,
  }

  record c-set-equipment {
    entity-id: s32,
    equipment: list<tuple<u8, string>>,
  }

  record c-set-experience {
    progress: f32,
    level: s32,
    total-experience: s32,
  }

  record c-set-health {
    health: f32,
    food: s32,
    food-saturation: f32,
  }

  record c-set-selected-slot {
    slot: u8,
  }

  record c-set-passengers {
    entity-id: s32,
    passengers: list<s32>,
  }

  record c-set-player-inventory {
    slot: s32,
    item: string,
  }

  enum team-method {
    create,
    remove,
    update,
    add-players,
    remove-players,
  }

  record team-parameters {
    display-name: string,
    options: u8,
    nametag-visibility: string,
    collision-rule: string,
    color: s32,
    player-prefix: string,
    player-suffix: string,
  }

  record c-set-player-team {
    team-name: string,
    method: team-method,
    parameters: option<team-parameters>,
    players: list<string>,
  }

  record c-set-simulation-distance {
    simulation-distance: s32,
  }

  record c-update-time {
    game-time: s64,
    /// (`clock_registry_id`, `total_ticks`, `partial_tick`, rate)
    clock-updates: list<tuple<s32, s64, f32, f32>>,
  }

  record c-title-text {
    title: string,
  }

  record c-title-animation {
    fade-in-ticks: s32,
    stay-ticks: s32,
    fade-out-ticks: s32,
  }

  record c-play-show-dialog {
    dialog: string,
  }

  record c-sound-effect {
    sound-event: string,
    sound-category: s32,
    position: tuple<f64, f64, f64>,
    volume: f32,
    pitch: f32,
    seed: s64,
  }

  record c-spawn-entity {
    entity-id: s32,
    entity-uuid: uuid,
    r-type: s32,
    position: tuple<f64, f64, f64>,
    velocity: string,
    pitch: u8,
    yaw: u8,
    head-yaw: u8,
    data: s32,
  }

  record c-stop-sound {
    sound-id: option<string>,
    category: option<string>,
  }

  /// Stores some arbitrary data on the client, which persists between server transfers.
  /// The Notchian client only accepts cookies of up to 5 kiB in size.
  record c-store-cookie {
    key: string,
    payload: list<u8>,
  }

  record c-subtitle {
    subtitle: string,
  }

  /// Sends a system chat message to the client.
  ///
  /// System messages are messages sent by the server itself (such as join/quit notices,
  /// command feedback, server announcements, or actionbar overlay messages).
  record c-system-chat-message {
    content: string,
    /// When true, the message is displayed above the hotbar (actionbar).
    /// When false, it is displayed in the normal chat box.
    overlay: bool,
  }

  /// Updates the header and footer of the player list (Tab List).
  record c-tab-list {
    /// The text to be displayed at the top of the player list.
    header: string,
    /// The text to be displayed at the bottom of the player list.
    footer: string,
  }

  record c-tag-query-response {
    transaction-id: s32,
    nbt-bytes: list<u8>,
  }

  record c-take-item-entity {
    /// The entity id of the item entity.
    entity-id: s32,
    /// The entity id of the entity who is collecting the item.
    collector-entity-id: s32,
    /// The Number of items in the Stack
    stack-amount: s32,
  }

  /// Only used when teleporting a player's vehicle, this packet is sent to the player.
  record c-teleport-entity {
    entity-id: s32,
    position: tuple<f64, f64, f64>,
    delta: tuple<f64, f64, f64>,
    yaw: f32,
    pitch: f32,
    relatives: list<string>,
    on-ground: bool,
  }

  record c-test-instance-block-status {
    pos: tuple<s32, s32, s32>,
    status: s32,
    message: option<string>,
  }

  record c-ticking-state {
    tick-rate: f32,
    is-frozen: bool,
  }

  record c-ticking-step {
    tick-steps: s32,
  }

  record c-transfer {
    host: string,
    port: s32,
  }

  record c-unload-chunk {
    x: s32,
    z: s32,
  }

  record c-update-advancements {
    reset: bool,
    added: list<string>,
    removed: list<string>,
    progress: list<string>,
    show-advancements: bool,
  }

  record attribute-modifier {
    id: string,
    amount: f64,
    operation: u8,
  }

  record property {
    id: s32,
    value: f64,
    modifiers: list<attribute-modifier>,
  }

  /// Sent by the server to signal a successful login and transition to the configuration phase
  ///
  /// This packet provides the client with its official UUID and username as
  /// recognized by the server, along with any associated skin or cape properties.
  record c-login-success {
    /// The unique identifier assigned to the player.
    uuid: uuid,
    /// The player's verified username.
    username: string,
    /// A list of properties for the player's profile, such as skin data and signatures.
    /// This is typically retrieved from the Mojang authentication servers.
    properties: list<property>,
    /// (<1.21.2) Whether strict error handling should be enabled.
    strict-error-handling: bool,
    /// Added in 26.2
    session-id: uuid,
  }

  record player-action-add-player {
    name: string,
    properties: list<property>,
  }

  variant player-action {
    add-player(player-action-add-player),
    initialize-chat(option<init-chat>),
    update-game-mode(s32),
    update-listed(bool),
    update-latency(s32),
    update-display-name(option<string>),
    /// Added in 1.21.2
    update-list-order(s32),
    /// Added in 1.21.4
    /// Toggles the visibility of the player's hat layer (second skin layer).
    update-hat(bool),
  }

  record player {
    uuid: uuid,
    actions: list<player-action>,
  }

  /// Updates one or more players' information on the client.
  ///
  /// This packet replaces the legacy "Player Info" packet with a more efficient
  /// bitmask-driven approach. Instead of sending full data every time, the
  /// server only sends the fields specified in the `actions` bitmask.
  record c-player-info-update {
    /// The bitmask (`PlayerInfoFlags`) determining which data follows.
    actions: u8,
    /// The list of players being updated. Each player entry contains
    /// data fields in the order they appear in the bitmask.
    players: list<player>,
  }

  record c-update-attributes {
    entity-id: s32,
    properties: list<property>,
  }

  record c-update-entity-pos {
    entity-id: s32,
    delta: tuple<f64, f64, f64>,
    on-ground: bool,
  }

  record c-update-entity-pos-rot {
    entity-id: s32,
    delta: tuple<f64, f64, f64>,
    yaw: u8,
    pitch: u8,
    on-ground: bool,
  }

  record c-update-entity-rot {
    entity-id: s32,
    yaw: u8,
    pitch: u8,
    on-ground: bool,
  }

  record c-update-mob-effect {
    entity-id: s32,
    effect-id: s32,
    amplifier: s32,
    duration: s32,
    %flags: u8,
  }

  record c-update-objectives {
    objective-name: string,
    mode: u8,
    display-name: string,
    render-type: s32,
    number-format: option<string>,
  }

  enum mode {
    add,
    remove,
    update,
  }

  enum render-type {
    integer,
    hearts,
  }

  record c-update-recipes {
    raw-data: list<u8>,
  }

  /// Sent by the server to create or update a score for an entity on a specific objective.
  ///
  /// This packet is the primary way to manage scoreboard data. In the latest protocol,
  /// it also supports optional custom formatting for how the numeric score is displayed.
  record c-update-score {
    /// The name of the entity whose score is being updated (e.g., a player's username
    /// or a non-player entry like "Kills").
    entity-name: string,
    /// The internal name of the objective this score belongs to.
    objective-name: string,
    /// The actual integer value of the score.
    value: s32,
    /// An optional custom name for the entity to be displayed in the scoreboard.
    /// If `None`, the `entity_name` is used by default.
    display-name: option<string>,
    /// Optional formatting for the number (e.g., blank, fixed text, or styled).
    /// This allows for scores to appear as something other than raw numbers.
    number-format: option<string>,
  }

  record c-update-tags-play {
    tags: list<string>,
  }

  enum waypoint-operation {
    track,
    untrack,
    update,
  }

  record waypoint-target-chunk {
    x: s32,
    z: s32,
  }

  variant waypoint-target {
    position(tuple<s32, s32, s32>),
    chunk(waypoint-target-chunk),
    azimuth(f32),
    empty,
  }

  record waypoint-icon {
    style: option<string>,
    color: s32,
  }

  record tracked-waypoint {
    identifier: uuid,
    icon: option<waypoint-icon>,
    target: waypoint-target,
  }

  /// Syncs tracked waypoints (`ClientboundTrackedWaypointPacket`) to client.
  record c-waypoint {
    operation: waypoint-operation,
    waypoint: tracked-waypoint,
  }

  /// Sent by the server to trigger a specific sound or particle effect at a world location.
  ///
  /// This is used for a wide variety of effects, from breaking blocks and firework
  /// explosions to splashing water or record playing.
  record c-world-event {
    /// The ID of the event to trigger (e.g., 1000 for a bow shoot, 2001 for block break).
    /// Refer to the latest protocol registry for the full list of sound/particle IDs.
    event: s32,
    /// The world coordinates where the effect should originate.
    location: tuple<s32, s32, s32>,
    /// Additional metadata associated with the event.
    ///
    /// For example, if breaking a block, this contains the block ID.
    /// For firework particles, it may contain the color or type.
    data: s32,
    /// If true, the sound will be played at a constant volume regardless of the
    /// player's distance from the `location`.
    disable-relative-volume: bool,
  }

  /// Sent by the server to complete a latency check initiated by a `SStatusPingRequest`.
  ///
  /// This is the final packet in the Server List Ping (SLP) sequence. It allows the
  /// client to calculate the round-trip time (ping) to the server.
  record status-c-ping-response {
    /// The exact 64-bit integer received from the client's ping request.
    ///
    /// The client uses this value to ensure the response matches the specific
    /// request it sent and to measure elapsed time.
    payload: s64,
  }

  /// Sent by the server in response to a `SStatusRequest`.
  ///
  /// This packet provides the client with the information required to display the
  /// server in the multiplayer menu, including the MOTD, player count, and icon
  record status-c-status-response {
    /// A JSON-encoded string containing the server's status data.
    ///
    /// The maximum length of this string is 32,767 characters. It typically
    /// includes fields for `version`, `players`, `description` (MOTD), and `favicon`
    json-response: string,
  }

  variant serverbound-packet {
    config-s-accept-code-of-conduct,
    /// This packet signals to the server that the client is ready to transition
    /// from the `Configuration` state to the `Play` state.
    config-s-acknowledge-finish-config,
    /// Sent by the client to inform the server about its local settings
    config-s-client-information-config(config-s-client-information-config),
    /// Response to a `CCookieRequest` from the server during the configuration phase
    ///
    /// Cookies allow servers to store small amounts of data on the client side,
    /// which can be retrieved later (e.g., for session tracking or preferences)
    config-s-config-cookie-response(config-s-config-cookie-response),
    config-s-custom-click-action(config-s-custom-click-action),
    config-s-keep-alive(config-s-keep-alive),
    config-s-known-packs(config-s-known-packs),
    /// A packet used for custom communication between the client and server.
    ///
    /// This allows mods, plugins, or proxy
    /// software to send proprietary data over the standard Minecraft protocol.
    config-s-plugin-message(config-s-plugin-message),
    config-s-config-pong(config-s-config-pong),
    /// Sent by the client to inform the server of the status of a requested resource pack.
    ///
    /// This allows the server to know if the player is using the required textures
    /// or if the download failed.
    config-s-config-resource-pack(config-s-config-resource-pack),
    /// Response to a `CCookieRequest` (login) from the server.
    /// The Notchian server only accepts responses of up to 5 kiB in size.
    login-s-login-cookie-response(login-s-login-cookie-response),
    /// Acknowledgement to the `CLoginSuccess` packet sent by the server.
    login-s-login-acknowledged,
    login-s-login-start(login-s-login-start),
    login-s-login-plugin-response(login-s-login-plugin-response),
    s-attack(s-attack),
    s-block-entity-tag-query(s-block-entity-tag-query),
    s-bundle-item-selected(s-bundle-item-selected),
    s-change-difficulty(s-change-difficulty),
    s-change-game-mode(s-change-game-mode),
    s-chat-ack(s-chat-ack),
    s-chat-command(s-chat-command),
    s-chat-command-signed(s-chat-command-signed),
    s-chat-message(s-chat-message),
    s-chunk-batch(s-chunk-batch),
    s-click-slot(s-click-slot),
    s-client-command(s-client-command),
    s-client-information-play(s-client-information-play),
    s-client-tick-end,
    s-close-container(s-close-container),
    s-command-suggestion(s-command-suggestion),
    s-configuration-acknowledged,
    s-container-button-click(s-container-button-click),
    s-container-slot-state-changed(s-container-slot-state-changed),
    /// Response to a `CCookieRequest` (play) from the server.
    /// The Notchian (vanilla) server only accepts responses of up to 5 KiB in size.
    s-cookie-response(s-cookie-response),
    s-custom-click-action(s-custom-click-action),
    /// A packet used for custom communication between the client and server.
    ///
    /// This allows mods, plugins, or proxy software to send proprietary data over the standard
    /// Minecraft protocol.
    s-custom-payload(s-custom-payload),
    s-debug-sample-subscription(s-debug-sample-subscription),
    s-debug-subscription-request(s-debug-subscription-request),
    s-edit-book(s-edit-book),
    s-entity-tag-query(s-entity-tag-query),
    s-interact(s-interact),
    s-jigsaw-generate(s-jigsaw-generate),
    s-keep-alive(s-keep-alive),
    s-lock-difficulty(s-lock-difficulty),
    s-move-vehicle(s-move-vehicle),
    s-paddle-boat(s-paddle-boat),
    s-pick-item-from-block(s-pick-item-from-block),
    s-pick-item-from-entity(s-pick-item-from-entity),
    s-play-ping-request(s-play-ping-request),
    s-place-recipe(s-place-recipe),
    s-player-abilities(s-player-abilities),
    s-player-action(s-player-action),
    s-player-command(s-player-command),
    s-set-player-ground(s-set-player-ground),
    s-player-input(s-player-input),
    /// Added in 1.21.4
    s-player-loaded,
    s-player-position(s-player-position),
    s-player-position-rotation(s-player-position-rotation),
    s-player-rotation(s-player-rotation),
    s-player-session(s-player-session),
    s-play-pong(s-play-pong),
    s-recipe-book-change-settings(s-recipe-book-change-settings),
    s-recipe-book-seen-recipe(s-recipe-book-seen-recipe),
    s-rename-item(s-rename-item),
    s-play-resource-pack(s-play-resource-pack),
    s-seen-advancement(s-seen-advancement),
    s-select-trade(s-select-trade),
    s-set-beacon(s-set-beacon),
    s-set-command-block(s-set-command-block),
    s-set-command-minecart(s-set-command-minecart),
    s-set-creative-slot(s-set-creative-slot),
    s-set-game-rule(s-set-game-rule),
    s-set-held-item(s-set-held-item),
    s-set-jigsaw-block(s-set-jigsaw-block),
    s-set-structure-block(s-set-structure-block),
    s-set-test-block(s-set-test-block),
    s-spectate-entity(s-spectate-entity),
    s-teleport-to-entity(s-teleport-to-entity),
    s-test-instance-block-action(s-test-instance-block-action),
    s-update-sign(s-update-sign),
    s-use-item(s-use-item),
    s-use-item-on(s-use-item-on),
    /// Sent by the client to measure the round-trip time (latency) to the server.
    ///
    /// This is the second part of the Server List Ping (SLP) process
    /// The server should respond with `CPingResponse`.
    status-s-status-ping-request(status-s-status-ping-request),
    /// Sent by the client to request the server's current status information.
    ///
    /// This is the first packet sent during the "Status" state.
    /// The server should respond with `CStatusResponse`.
    status-s-status-request,
    unknown,
  }

  variant clientbound-packet {
    config-c-config-add-resource-pack(config-c-config-add-resource-pack),
    config-c-config-clear-dialog,
    config-c-code-of-conduct(config-c-code-of-conduct),
    config-c-config-disconnect(config-c-config-disconnect),
    /// Requests a cookie that was previously stored.
    config-c-cookie-request(config-c-cookie-request),
    config-c-config-custom-report-details(config-c-config-custom-report-details),
    config-c-feature-flags(config-c-feature-flags),
    config-c-finish-config,
    config-c-known-packs(config-c-known-packs),
    config-c-config-ping(config-c-config-ping),
    config-c-plugin-message(config-c-plugin-message),
    config-c-config-post-effects(config-c-config-post-effects),
    /// Added in 1.20.2
    config-c-registry-data(config-c-registry-data),
    config-c-config-remove-resource-pack(config-c-config-remove-resource-pack),
    config-c-config-reset-chat,
    config-c-config-server-links(config-c-config-server-links),
    config-c-config-show-dialog(config-c-config-show-dialog),
    /// Stores some arbitrary data on the client, which persists between server transfers.
    /// The Notchian (vanilla) client only accepts cookies of up to 5 KiB in size.
    config-c-store-cookie(config-c-store-cookie),
    config-c-transfer(config-c-transfer),
    config-c-update-tags(config-c-update-tags),
    /// Sent by the server to retrieve a previously stored cookie from the client.
    ///
    /// This occurs during the login phase, allowing the server to identify
    /// returning players or retrieve session data stored during a previous visit.
    login-c-login-cookie-request(login-c-login-cookie-request),
    /// Sent by the server to reject a login attempt or kick a player during the login phase
    ///
    /// This is used for reasons such as the server being full, the player being banned,
    /// or version mismatches. After this packet is sent, the connection is closed.
    login-c-login-disconnect(login-c-login-disconnect),
    /// Sent by the server to initiate a custom plugin messaging exchange during login.
    ///
    /// This is used by server software (like proxies or anti-cheats) to request
    /// information from a client-side mod before the player officially joins.
    login-c-login-plugin-request(login-c-login-plugin-request),
    /// Sent by the server to enable network compression for all subsequent packets.
    ///
    /// Once this packet is sent, both the server and the client must compress any
    /// packet with a size equal to or greater than the specified threshold.
    login-c-set-compression(login-c-set-compression),
    /// Sent by the server to acknowledge a sequence of block changes initiated by the client.
    ///
    /// This packet is critical for preventing "ghost blocks" and synchronization issues.
    /// It tells the client that the server has processed all actions up to a specific point.
    c-acknowledge-block-change(c-acknowledge-block-change),
    /// Updates the text displayed above the player's hotbar (the Action Bar).
    ///
    /// Unlike chat messages, Action Bar text is transient and generally used for
    /// non-critical status information like "Now entering: Wilderness" or
    /// mana/stamina counters.
    c-action-bar(c-action-bar),
    c-add-resource-pack(c-add-resource-pack),
    c-award-stats(c-award-stats),
    /// Updates the visual "breaking" progress of a block for all clients.
    ///
    /// This packet controls the overlay of cracks that appear on a block when
    /// it is being mined. It is often used to show other players' mining progress.
    c-set-block-destroy-stage(c-set-block-destroy-stage),
    /// Updates the NBT data of a block entity (e.g., signs, chests, or banners).
    ///
    /// This packet is sent by the server when a block entity's state changes
    /// (like text on a sign) or when the block entity is loaded into the client's view.
    c-block-entity-data(c-block-entity-data),
    /// Triggers a physical block animation or sound effect.
    ///
    /// This is used for simple block interactions that don't necessarily change
    /// NBT data, such as chests opening/closing, pistons extending, or note blocks playing.
    c-block-event(c-block-event),
    /// Updates a single block state at a specific location in the world.
    ///
    /// This is the most common way to sync world changes to the client, such as
    /// when a player places a block, a fluid flows, or a redstone component toggles.
    c-block-update(c-block-update),
    /// Updates the "Boss Bar" displayed at the top of the player's screen.
    ///
    /// This packet is used to manage health bars for entities like the Ender Dragon
    /// or Wither, as well as custom progress bars for server events or raids.
    c-boss-event(c-boss-event),
    c-bundle-delimiter,
    /// Updates the center of the player's loaded chunk radius (the "view center").
    ///
    /// This packet tells the client which chunk coordinate it should use as the
    /// focal point for loading and unloading chunks. It is typically sent when
    /// a player moves across a chunk boundary.
    c-center-chunk(c-center-chunk),
    /// Notifies the client of a change in the world's difficulty level or lock status.
    ///
    /// This updates the client's internal state, which affects certain UI elements
    /// and client-side behavior (though actual game logic like mob damage is
    /// primarily handled by the server).
    c-change-difficulty(c-change-difficulty),
    /// Notifies the client that the server has finished sending a batch of chunks.
    ///
    /// Introduced in modern protocol versions to optimize world loading, this packet
    /// allows the client to acknowledge the receipt of a group of chunks, helping
    /// the server regulate the flow of data and prevent network congestion.
    c-chunk-batch-end(c-chunk-batch-end),
    /// Signals the beginning of a new batch of chunk data packets.
    ///
    /// This packet initiates a synchronized chunk loading sequence. In modern
    /// protocol versions, the server must wrap chunk data transmissions between
    /// a `Start` and `End` packet to manage client-side backpressure and
    /// network throughput.
    c-chunk-batch-start,
    c-chunks-biomes(c-chunks-biomes),
    c-play-clear-dialog,
    /// Removes any currently displayed Title or Subtitle from the player's screen.
    ///
    /// This packet is used to immediately hide titles that are currently in their
    /// "stay" or "fade-out" phases.
    c-clear-title(c-clear-title),
    /// Notifies the client that a container (inventory, chest, etc.) has been closed.
    ///
    /// This is used by the server to force the player's UI to shut, for example,
    /// if the player moves too far away from a chest or if an NPC's trade window
    /// is invalidated.
    c-close-container(c-close-container),
    /// Notifies the client that a player has died.
    ///
    /// This packet is responsible for triggering the death screen on the client
    /// and displaying the death message in the chat for the deceased player.
    c-combat-death(c-combat-death),
    c-combat-enter,
    c-combat-end(c-combat-end),
    /// Sent by the server to provide a list of "tab-completion" suggestions.
    ///
    /// This packet responds to a client's request for help with commands,
    /// appearing as a scrollable list of options while the player is typing
    /// in the chat bar.
    c-command-suggestions(c-command-suggestions),
    /// Sends the entire command tree to the client for client-side parsing and tab-completion.
    ///
    /// Minecraft uses the "Brigadier" command system. This packet informs the client
    /// which commands exist, their arguments, and how they branch, allowing the
    /// client to highlight syntax errors in red before the command is even sent.
    c-commands(c-commands),
    /// Sent by the server to request a "cookie" (stored data) from the client.
    ///
    /// Introduced in modern Minecraft versions, cookies allow servers to store
    /// small amounts of persistent data on the client side that can be retrieved
    /// even across different server instances or sub-servers in a network.
    c-play-cookie-request(c-play-cookie-request),
    c-custom-chat-completions(c-custom-chat-completions),
    /// A packet used for custom communication between the server and client.
    c-custom-payload(c-custom-payload),
    c-play-custom-report-details(c-play-custom-report-details),
    /// Notifies the client that an entity has taken damage.
    ///
    /// This packet is used to trigger damage animations (like the red tint on mobs),
    /// directional knockback visuals, and sound effects. It provides the client
    /// with specific details about the damage source to ensure the visual feedback
    /// matches the cause.
    c-damage-event(c-damage-event),
    c-debug-block-value(c-debug-block-value),
    c-debug-chunk-value(c-debug-chunk-value),
    c-debug-entity-value(c-debug-entity-value),
    c-debug-event(c-debug-event),
    c-debug-sample(c-debug-sample),
    c-delete-chat(c-delete-chat),
    /// Forces the client to disconnect from the server while in the "Play" state.
    ///
    /// This packet displays the provided reason to the player on a dedicated
    /// disconnection screen. It is used for kicks, server shutdowns, or when
    /// a player is banned.
    c-play-disconnect(c-play-disconnect),
    /// Sends a chat message that is not cryptographically signed by a player.
    ///
    /// Introduced to support server-side "disguised" identities (like /say or NPC chat),
    /// this packet bypasses the player-to-player chat signing requirements while
    /// still allowing the client to format the message using the standard chat registry.
    c-disguised-chat-message(c-disguised-chat-message),
    /// Instructs the client to display a specific scoreboard objective in a given slot.
    ///
    /// This packet is the final step in showing a scoreboard to a player. After
    /// an objective is created and populated with scores, this packet "maps"
    /// that objective to a visual location like the sidebar or the player list.
    c-display-objective(c-display-objective),
    /// Triggers a specific animation for an entity that is visible to the client.
    ///
    /// This is primarily used for player-driven animations like swinging an arm
    /// or showing damage, but it can apply to other entities as well.
    c-entity-animation(c-entity-animation),
    /// Updates the "Data Tracker" values for an entity.
    ///
    /// Entity Metadata (or `DataWatchers`) controls persistent visual states that
    /// don't require a full packet to update, such as whether an entity is on fire,
    /// crouching, glowing, or the custom name displayed above its head.
    c-set-entity-metadata(c-set-entity-metadata),
    /// Plays a sound effect that originates from a specific entity.
    ///
    /// Unlike global sounds, this sound will follow the entity as it moves
    /// through the world. The client handles the panning and attenuation
    /// (volume drop-off) based on the distance between the player and the entity.
    c-entity-sound-effect(c-entity-sound-effect),
    /// Sends a status update for a specific entity.
    ///
    /// This packet is a "catch-all" for various entity triggers that don't
    /// warrant a complex packet of their own. It primarily handles visual
    /// and logical state triggers, such as tool breaking, totem usage,
    /// or sheep shearing.
    c-entity-status(c-entity-status),
    /// Updates the velocity of an entity.
    ///
    /// This packet informs the client of a sudden change in an entity's movement,
    /// such as knockback from an attack, explosions, or being launched by a piston.
    c-entity-velocity(c-entity-velocity),
    /// Notifies the client that an explosion has occurred.
    ///
    /// This is a high-level packet that handles the visual, auditory, and physical
    /// effects of an explosion in a single call. It triggers the explosion particles,
    /// plays the sound at the source, and applies knockback to the player.
    c-explosion(c-explosion),
    /// Updates the game state or triggers specific environmental changes.
    ///
    /// This packet is the primary way the server communicates global or
    /// context-specific transitions, such as changing the weather,
    /// altering the player's gamemode, or displaying the credits.
    c-game-event(c-game-event),
    c-game-rule-values(c-game-rule-values),
    c-game-test-highlight-pos(c-game-test-highlight-pos),
    /// Rotates an entity's head to a specific yaw.
    ///
    /// In Minecraft, an entity's "body yaw" and "head yaw" are separate.
    /// While standard movement packets update the body, this packet is
    /// required to make an entity (like a player or a mob) look in a
    /// specific direction without necessarily turning its entire body.
    c-head-rot(c-head-rot),
    /// Triggers the "hurt" visual effect on an entity.
    ///
    /// This packet causes the entity to turn red and perform a directional
    /// camera shake or model tilt. It is typically sent immediately after
    /// an entity's health is reduced.
    c-hurt-animation(c-hurt-animation),
    /// Fully initializes the world border for the client.
    ///
    /// This packet is sent when a player joins the world or changes dimensions.
    /// It synchronizes the current position, size, and all warning parameters
    /// to ensure the client-side visual barrier matches the server's authority.
    c-initialize-world-border(c-initialize-world-border),
    c-item-cooldown(c-item-cooldown),
    /// Maintains the connection and measures latency (ping) between client and server.
    ///
    /// The server sends this packet at regular intervals (typically every 15–20 seconds).
    /// The client must respond with the exact same ID. If the server does not receive
    /// a response within a timeout period (usually 30 seconds), it will disconnect
    /// the player with a "Timed Out" message.
    c-keep-alive(c-keep-alive),
    /// Triggers a specific sound or particle effect at a world location.
    ///
    /// This packet handles a wide variety of "world-level" events, such as
    /// block breaking particles, firework explosions, or ambient sounds
    /// like doors opening and portals humming.
    c-level-event(c-level-event),
    /// Sent by the server to update light levels (block light and sky light) for a chunk.
    ///
    /// This packet updates lighting data for a specific chunk without sending the full chunk data.
    /// It was introduced in Minecraft 1.14 (protocol version 477).
    c-light-update(c-light-update),
    /// The "Join Game" packet that transitions the client from the Configuration state
    /// to the Play state.
    ///
    /// This is one of the largest and most important packets in the protocol. It
    /// initializes the player's world view, dimension settings, and local game
    /// rules. Once received, the client begins rendering the world.
    c-login(c-login),
    /// Warns the client that the server is running low on disk space.
    ///
    /// Added in 26.1. This packet informs the client to display a warning
    /// overlay/notification about low storage.
    c-low-disk-space-warning,
    c-map-item-data(c-map-item-data),
    c-merchant-offers(c-merchant-offers),
    c-move-minecart-along-track(c-move-minecart-along-track),
    c-move-vehicle(c-move-vehicle),
    /// Updates multiple blocks within a single chunk section (or chunk in older versions).
    ///
    /// This packet is much more efficient than sending multiple individual
    /// `CBlockUpdate` packets when many changes occur in the same area
    /// (e.g., explosions, structure generation, or large-scale terraforming).
    c-multi-block-update(c-multi-block-update),
    c-open-book(c-open-book),
    c-open-mount-screen(c-open-mount-screen),
    /// Instructs the client to open a specific type of GUI (inventory, chest, etc.).
    ///
    /// This packet is sent when a player interacts with a block (like a chest)
    /// or when a command/plugin forces an interface to open. It establishes a
    /// `sync_id` which must be used in all subsequent "Set Slot" or "Click Slot"
    /// packets to ensure the server and client are talking about the same window.
    c-open-screen(c-open-screen),
    /// Opens the sign text input screen for the client.
    ///
    /// This packet is sent by the server to force the client to show the
    /// sign editing interface. This usually happens immediately after a
    /// player places a sign or interacts with an existing one (if allowed).
    c-open-sign-editor(c-open-sign-editor),
    /// Spawns a cluster of particles at a specific location.
    ///
    /// This is the most versatile visual packet in the protocol. It allows for
    /// precise control over particle density, spread, and speed. It can also
    /// carry extra data for complex particles like redstone dust (color) or
    /// block/item breaking (textures).
    c-particle(c-particle),
    c-play-ping(c-play-ping),
    /// Responds to a client-initiated ping request to synchronize game state.
    c-ping-response(c-ping-response),
    c-place-ghost-recipe(c-place-ghost-recipe),
    /// Updates the player's movement and interaction abilities.
    ///
    /// This packet informs the client about the player's state (flying, invulnerable)
    /// and sets the movement speeds. While the client applies these visuals,
    /// the server must still validate these states to prevent cheating.
    c-player-abilities(c-player-abilities),
    /// Sends a cryptographically signed player chat message to the client.
    ///
    /// This packet is the backbone of the modern secure chat system. It includes
    /// tracking indices, digital signatures, and context for reporting.
    c-player-chat-message(c-player-chat-message),
    /// Updates one or more players' information on the client.
    ///
    /// This packet replaces the legacy "Player Info" packet with a more efficient
    /// bitmask-driven approach. Instead of sending full data every time, the
    /// server only sends the fields specified in the `actions` bitmask.
    c-player-info-update(c-player-info-update),
    c-player-look-at(c-player-look-at),
    /// Updates the player's position and rotation on the client.
    ///
    /// Commonly known as the "Teleport Packet," this is sent by the server to
    /// force a change in the player's location. The client must respond with a
    /// `Teleport Confirm` packet matching the `teleport_id`.
    c-player-position(c-player-position),
    /// Sent by the server to remove one or more players from the client's player list (tab list).
    ///
    /// This packet is typically used when a player leaves the server or becomes invisible
    /// to the recipient (e.g., moving out of tracking range).
    c-remove-player-info(c-remove-player-info),
    c-player-rotation(c-player-rotation),
    /// Sent by the server to set the client's default spawn point and compass target.
    ///
    /// This packet updates where the player will respawn upon death (if no bed or anchor is set)
    /// and dictates the coordinates that a compass will point toward.
    c-player-spawn-position(c-player-spawn-position),
    c-post-effects(c-post-effects),
    c-projectile-power(c-projectile-power),
    /// Clientbound packet that adds recipes to the client's recipe book.
    /// `replace = true` means the client replaces its current recipe list.
    c-recipe-book-add(c-recipe-book-add),
    c-recipe-book-remove(c-recipe-book-remove),
    /// Sent by the server to update the player's recipe book open/filter state.
    ///
    /// Wire format: 4 `TypeSettings` pairs (crafting, furnace, `blast_furnace`, smoker),
    /// each pair is (`is_open`: bool, `is_filtering`: bool).
    c-recipe-book-settings(c-recipe-book-settings),
    /// Sent by the server to instruct the client to remove (despawn) one or more entities.
    ///
    /// This is typically sent when an entity leaves the player's tracking range,
    /// is killed, or is otherwise removed from the world.
    c-remove-entities(c-remove-entities),
    c-remove-mob-effect(c-remove-mob-effect),
    c-remove-resource-pack(c-remove-resource-pack),
    c-reset-score(c-reset-score),
    c-respawn(c-respawn),
    c-select-advancements-tab(c-select-advancements-tab),
    c-server-data(c-server-data),
    c-play-server-links(c-play-server-links),
    c-set-border-center(c-set-border-center),
    c-set-border-lerp-size(c-set-border-lerp-size),
    c-set-border-size(c-set-border-size),
    c-set-border-warning-delay(c-set-border-warning-delay),
    c-set-border-warning-distance(c-set-border-warning-distance),
    c-set-camera(c-set-camera),
    c-set-chunk-cache-radius(c-set-chunk-cache-radius),
    c-set-container-content(c-set-container-content),
    c-set-container-property(c-set-container-property),
    c-set-container-slot(c-set-container-slot),
    c-set-cursor-item(c-set-cursor-item),
    /// Sent by the server to attach (leash) or detach an entity to another entity (e.g. leash knot, player, mob).
    c-set-entity-link(c-set-entity-link),
    c-set-equipment(c-set-equipment),
    c-set-experience(c-set-experience),
    c-set-health(c-set-health),
    c-set-passengers(c-set-passengers),
    c-set-player-inventory(c-set-player-inventory),
    c-set-player-team(c-set-player-team),
    c-set-simulation-distance(c-set-simulation-distance),
    c-update-time(c-update-time),
    c-title-text(c-title-text),
    c-title-animation(c-title-animation),
    c-play-show-dialog(c-play-show-dialog),
    c-sound-effect(c-sound-effect),
    c-spawn-entity(c-spawn-entity),
    c-start-configuration,
    c-stop-sound(c-stop-sound),
    /// Stores some arbitrary data on the client, which persists between server transfers.
    /// The Notchian client only accepts cookies of up to 5 kiB in size.
    c-store-cookie(c-store-cookie),
    c-subtitle(c-subtitle),
    /// Updates the header and footer of the player list (Tab List).
    c-tab-list(c-tab-list),
    c-tag-query-response(c-tag-query-response),
    c-take-item-entity(c-take-item-entity),
    /// Only used when teleporting a player's vehicle, this packet is sent to the player.
    c-teleport-entity(c-teleport-entity),
    c-test-instance-block-status(c-test-instance-block-status),
    c-ticking-state(c-ticking-state),
    c-ticking-step(c-ticking-step),
    c-transfer(c-transfer),
    c-unload-chunk(c-unload-chunk),
    c-update-advancements(c-update-advancements),
    c-update-attributes(c-update-attributes),
    c-update-entity-pos(c-update-entity-pos),
    c-update-entity-pos-rot(c-update-entity-pos-rot),
    c-update-entity-rot(c-update-entity-rot),
    c-update-mob-effect(c-update-mob-effect),
    c-update-objectives(c-update-objectives),
    c-update-recipes(c-update-recipes),
    /// Sent by the server to create or update a score for an entity on a specific objective.
    ///
    /// This packet is the primary way to manage scoreboard data. In the latest protocol,
    /// it also supports optional custom formatting for how the numeric score is displayed.
    c-update-score(c-update-score),
    /// Syncs tracked waypoints (`ClientboundTrackedWaypointPacket`) to client.
    c-waypoint(c-waypoint),
    /// Sent by the server to trigger a specific sound or particle effect at a world location.
    ///
    /// This is used for a wide variety of effects, from breaking blocks and firework
    /// explosions to splashing water or record playing.
    c-world-event(c-world-event),
    /// Sent by the server to complete a latency check initiated by a `SStatusPingRequest`.
    ///
    /// This is the final packet in the Server List Ping (SLP) sequence. It allows the
    /// client to calculate the round-trip time (ping) to the server.
    status-c-ping-response(status-c-ping-response),
    /// Sent by the server in response to a `SStatusRequest`.
    ///
    /// This packet provides the client with the information required to display the
    /// server in the multiplayer menu, including the MOTD, player count, and icon
    status-c-status-response(status-c-status-response),
    unknown,
  }
}

interface %world {
  use common.{position, entity-pose, block-pos, nbt-tree};
  use block-entity.{block-entity, command-block-entity, block-entity-type};
  use text.{text-component};
  use scoreboard.{scoreboard};
  use particles.{particle};
  use sounds.{sound, sound-category};
  use entity-types.{entity-type};
  use biomes.{biome};
  use attributes.{attribute, modifier-operation, attribute-modifier};
  use item-stack.{item-stack};
  use damage-types.{damage-type};
  use game-rules.{game-rule, game-rule-value};
  use uuid.{uuid};

  /// Equipment slots available on living entities (mobs, armor stands, players).
  enum equipment-slot {
    main-hand,
    off-hand,
    feet,
    legs,
    chest,
    head,
    body,
    saddle,
  }

  /// Defines how a block reacts when pushed by a piston.
  enum piston-behavior {
    /// Normal behavior; the block can be pushed and pulled.
    normal,
    /// The block is destroyed when pushed.
    destroy,
    /// The block cannot be pushed or pulled.
    block,
    /// The block is ignored by pistons.
    ignore,
    /// The block can only be pushed, not pulled.
    push-only,
  }

  /// Predefined AI goals that can be added to mob entities.
  variant builtin-ai-goal {
    swim,
    wander-around(f32),
    melee-attack(f32),
    look-at-player(f32),
    look-around,
    escape-danger(f32),
    avoid-entity(f32),
    blaze-attack,
    creeper-ignite,
    eat-grass,
    zombie-attack(f32),
  }

  /// Node and terrain classification types evaluated during mob pathfinding.
  enum path-node-type {
    blocked,
    open,
    walkable,
    walkable-door,
    trapdoor,
    powder-snow,
    danger-powder-snow,
    fence,
    lava,
    water,
    water-border,
    rail,
    unpassable-rail,
    danger-fire,
    damage-fire,
    danger-other,
    damage-other,
    door-open,
    door-wood-closed,
    door-iron-closed,
    breach,
    leaves,
    sticky-honey,
    cocoa,
    damage-cautious,
    danger-trapdoor,
  }

  /// Minecraft 16 dye colors.
  enum dye-color {
    white,
    orange,
    magenta,
    light-blue,
    yellow,
    lime,
    pink,
    gray,
    light-gray,
    cyan,
    purple,
    blue,
    brown,
    green,
    red,
    black,
  }

  /// Villager profession identifiers.
  enum villager-profession {
    none,
    armorer,
    butcher,
    cartographer,
    cleric,
    farmer,
    fisherman,
    fletcher,
    leatherworker,
    librarian,
    mason,
    nitwit,
    shepherd,
    toolsmith,
    weaponsmith,
  }

  /// Specialized data for sheep entities.
  record sheep-data {
    color: dye-color,
    is-sheared: bool,
  }

  /// Specialized data for wolf entities.
  record wolf-data {
    is-tamed: bool,
    owner: option<uuid>,
    is-sitting: bool,
    collar-color: dye-color,
    is-angry: bool,
    is-begging: bool,
  }

  /// Specialized data for cat entities.
  record cat-data {
    is-tamed: bool,
    owner: option<uuid>,
    is-sitting: bool,
    collar-color: dye-color,
  }

  /// Specialized data for villager entities.
  record villager-data {
    profession: villager-profession,
    level: u8,
    experience: u32,
  }

  /// Specialized data for creeper entities.
  record creeper-data {
    is-powered: bool,
    fuse: s32,
    is-ignited: bool,
    explosion-radius: u8,
  }

  /// Specialized data for slime and magma cube entities.
  record slime-data {
    size: s32,
  }

  /// Specialized data for enderman entities.
  record enderman-data {
    carried-block-state: option<u16>,
    is-screaming: bool,
    is-staring: bool,
  }

  /// Specialized data for iron golem entities.
  record iron-golem-data {
    is-player-created: bool,
  }

  /// Specialized data for fox entities.
  record fox-data {
    is-sitting: bool,
    is-sleeping: bool,
    is-crouching: bool,
  }

  /// Specialized data for ageable animal mobs.
  record ageable-data {
    is-baby: bool,
    age: s32,
    in-love-ticks: s32,
  }

  /// Specialized data for zombie entities.
  record zombie-data {
    is-baby: bool,
    can-break-doors: bool,
  }

  /// Defines how an explosion interacts with blocks in the world.
  enum explosion-interaction {
    /// No interaction with blocks.
    none,
    /// Blocks are destroyed and may drop loot.
    block,
    /// Interaction typical for mob-caused explosions.
    mob,
    /// Interaction typical for TNT explosions.
    tnt,
    /// Triggers specific block behaviors.
    trigger,
  }

  /// Flags used to control block updates and notifications.
  flags block-flags {
    /// Notifies neighbor blocks of the change.
    notify-neighbors,
    /// Notifies client listeners of the change.
    notify-listeners,
    /// Forces the block state even if it's the same.
    force-state,
    /// Skips dropping items when the block is removed.
    skip-drops,
    /// Indicates the block was moved (e.g., by a piston).
    moved,
    /// Skips state replacement for redstone wires.
    skip-redstone-wire-state-replacement,
    /// Skips the callback when a block entity is replaced.
    skip-block-entity-replaced-callback,
    /// Skips the callback when a block is added.
    skip-block-added-callback,
  }

  /// Flammability properties of a block.
  record flammable {
    spread-chance: u8,
    burn-chance: u8,
  }

  /// Musical instruments used by note blocks.
  enum noteblock-instrument {
    harp,
    basedrum,
    snare,
    hat,
    bass,
    flute,
    bell,
    guitar,
    chime,
    xylophone,
    iron-xylophone,
    cow-bell,
    didgeridoo,
    bit,
    banjo,
    pling,
    trumpet,
    trumpet-exposed,
    trumpet-oxidized,
    trumpet-weathered,
    zombie,
    skeleton,
    creeper,
    dragon,
    wither-skeleton,
    piglin,
    custom-head,
  }

  /// Static definition of a Minecraft block type.
  record block {
    /// The internal numerical ID of the block type.
    id: u16,
    /// The unique namespaced ID (e.g., "minecraft:stone").
    name: string,
    /// How hard the block is to break (-1.0 for unbreakable blocks).
    hardness: f32,
    /// Resistance to explosions.
    blast-resistance: f32,
    /// The color of this block when displayed on a map.
    map-color: u8,
    /// The friction coefficient (0.6 default, 0.98 for ice).
    slipperiness: f32,
    /// How much this block affects entity walk speed.
    velocity-multiplier: f32,
    /// How much this block affects entity jump height.
    jump-velocity-multiplier: f32,
    /// The item ID associated with this block in inventory/drops.
    item-id: u16,
    /// The default block state ID when placed without extra properties.
    default-state-id: u16,
    /// All valid state IDs belonging to this block type.
    state-ids: list<u16>,
    /// Whether this block is solid by default.
    is-solid: bool,
    /// Whether this block is considered air.
    is-air: bool,
    /// Whether this block is flammable.
    is-flammable: bool,
    /// Flammability details if flammable.
    flammable: option<flammable>,
  }

  /// A simple wrapper for a block state ID.
  record block-state-id {
    id: u16,
  }

  resource entity {
    get-id: func() -> u32;
    get-uuid: func() -> uuid;
    get-type: func() -> entity-type;
    get-position: func() -> position;
    get-world: func() -> %world;
    get-yaw: func() -> f32;
    get-pitch: func() -> f32;
    get-head-yaw: func() -> f32;
    teleport: func(pos: position, world-ref: %world);
    set-velocity: func(velocity: position);
    get-velocity: func() -> position;
    get-pose: func() -> entity-pose;
    get-name: func() -> text-component;
    set-custom-name: func(name: text-component);
    get-custom-name: func() -> option<text-component>;
    set-custom-name-visible: func(visible: bool);
    is-custom-name-visible: func() -> bool;
    is-invulnerable: func() -> bool;
    set-invulnerable: func(invulnerable: bool);
    get-fire-ticks: func() -> s32;
    set-fire-ticks: func(ticks: s32);
    get-fall-distance: func() -> f32;
    set-fall-distance: func(distance: f32);
    get-ticks-lived: func() -> s32;
    set-ticks-lived: func(ticks: s32);
    is-sneaking: func() -> bool;
    set-sneaking: func(sneaking: bool);
    is-sprinting: func() -> bool;
    set-sprinting: func(sprinting: bool);
    is-swimming: func() -> bool;
    set-swimming: func(swimming: bool);
    is-invisible: func() -> bool;
    set-invisible: func(invisible: bool);
    is-glowing: func() -> bool;
    set-glowing: func(glowing: bool);
    is-fall-flying: func() -> bool;
    set-fall-flying: func(fall-flying: bool);
    is-silent: func() -> bool;
    set-silent: func(silent: bool);
    has-gravity: func() -> bool;
    set-has-gravity: func(gravity: bool);
    get-width: func() -> f32;
    get-height: func() -> f32;
    set-rotation: func(yaw: f32, pitch: f32);
    is-on-ground: func() -> bool;
    is-on-fire: func() -> bool;
    set-on-fire: func(on-fire: bool);
    has-visual-fire: func() -> bool;
    set-visual-fire: func(visual-fire: bool);
    get-portal-cooldown: func() -> u32;
    set-portal-cooldown: func(cooldown: u32);
    get-remaining-air: func() -> s32;
    set-remaining-air: func(air: s32);
    get-max-air: func() -> s32;
    get-eye-height: func() -> f32;
    get-eye-position: func() -> position;
    get-nearby-entities: func(x: f64, y: f64, z: f64) -> list<entity>;
    get-vehicle: func() -> option<entity>;
    set-vehicle: func(vehicle: option<entity>);
    get-passengers: func() -> list<entity>;
    add-passenger: func(passenger: entity);
    remove-passenger: func(passenger: entity);
    eject-passengers: func();
    get-bounding-box: func() -> bounding-box;
    is-in-water: func() -> bool;
    is-in-lava: func() -> bool;
    remove: func();
    /// Performs a raycast from the entity's eye position in its looking direction.
    raycast: func(max-distance: f64, fluid-handling: bool) -> option<raycast-result>;
    /// Performs a ray-trace from the entity's eye position in its looking direction to find the targeted block.
    ray-trace-block: func(max-distance: f64, include-fluids: bool) -> option<ray-trace-block-result>;
    /// Performs a ray-trace from the entity's eye position in its looking direction to find the targeted entity.
    ray-trace-entity: func(max-distance: f64) -> option<ray-trace-entity-result>;
    /// Returns the entity currently targeted in the looking direction within the specified distance.
    get-target-entity: func(max-distance: f64) -> option<entity>;
    /// Sets a namespaced custom data value on this entity.
    set-custom-data: func(namespace: string, key: string, value: nbt-tree);
    /// Returns a namespaced custom data value from this entity, if set.
    get-custom-data: func(namespace: string, key: string) -> option<nbt-tree>;
    /// Removes a namespaced custom data value from this entity.
    remove-custom-data: func(namespace: string, key: string);
    /// Returns whether this entity has a namespaced custom data value.
    has-custom-data: func(namespace: string, key: string) -> bool;
    /// Returns this entity as a living-entity if it has health and attributes, or none otherwise.
    as-living: func() -> option<living-entity>;
    /// Returns this entity as a mob if it is an AI-driven mob entity, or none otherwise.
    as-mob: func() -> option<mob>;
    /// Returns whether this entity is a living entity.
    is-living: func() -> bool;
    /// Returns whether this entity is an AI-driven mob.
    is-mob: func() -> bool;
  }

  /// Represents a living entity with health, combat stats, attributes, and equipment (mobs, players, armor stands).
  resource living-entity {
    /// Converts back to the base entity handle.
    as-entity: func() -> entity;
    /// Returns this living entity as a mob if it has AI/navigation, or none otherwise.
    as-mob: func() -> option<mob>;
    /// Returns whether this living entity is an AI-driven mob.
    is-mob: func() -> bool;
    /// Health & Combat
    get-health: func() -> f32;
    set-health: func(health: f32);
    get-max-health: func() -> f32;
    set-max-health: func(max-health: f32);
    damage: func(amount: f32, damage-type: damage-type);
    is-dead: func() -> bool;
    get-absorption: func() -> f32;
    set-absorption: func(amount: f32);
    /// Attributes
    get-attribute-value: func(attr: attribute) -> f64;
    get-attribute-base: func(attr: attribute) -> f64;
    set-attribute-base: func(attr: attribute, value: f64);
    add-attribute-modifier: func(attr: attribute, modifier: attribute-modifier);
    remove-attribute-modifier: func(attr: attribute, id: string);
    get-attribute-modifiers: func(attr: attribute) -> list<attribute-modifier>;
    reset-attribute: func(attr: attribute);
    reset-all-attributes: func();
    /// Equipment
    get-equipment: func(slot: equipment-slot) -> option<item-stack>;
    set-equipment: func(slot: equipment-slot, stack: option<item-stack>);
    clear-equipment: func();
    get-age: func() -> s32;
    set-age: func(age: s32);
    send-system-message: func(message: text-component);
  }

  /// Represents an AI-driven mob entity with goals, targeting, and pathfinding navigation (e.g. zombies, villagers).
  resource mob {
    /// Converts back to the base entity handle.
    as-entity: func() -> entity;
    /// Converts to the living-entity handle.
    as-living: func() -> living-entity;
    /// Goals & Targeting
    add-ai-goal: func(priority: u8, goal: builtin-ai-goal);
    add-custom-ai-goal: func(priority: u8, goal-id: u32);
    clear-ai-goals: func();
    set-ai-disabled: func(disabled: bool);
    is-ai-disabled: func() -> bool;
    set-target: func(target: option<entity>);
    get-target: func() -> option<entity>;
    /// Pathfinding & Navigation
    navigate-to-pos: func(pos: position, speed: f64) -> bool;
    navigate-to-entity: func(target: entity, speed: f64) -> bool;
    stop-navigation: func();
    is-navigating: func() -> bool;
    has-reached-destination: func() -> bool;
    set-navigation-speed: func(speed: f64);
    can-reach: func(pos: position, max-distance: f32) -> bool;
    set-pathfinding-malus: func(node-type: path-node-type, malus: f32);
    get-pathfinding-malus: func(node-type: path-node-type) -> f32;
    look-at: func(pos: position);
    look-at-entity: func(target: entity);
    /// Returns the specialized mob-specific data for this mob.
    get-mob-data: func() -> mob-data;
    /// Sets the specialized mob-specific data for this mob.
    /// Returns false if the provided data variant is incompatible with this mob.
    set-mob-data: func(data: mob-data) -> bool;
    /// Sets the number of freeze ticks on this entity (0 to 140).
    set-freeze-ticks: func(ticks: s32);
    /// Returns the number of freeze ticks currently on this entity.
    get-freeze-ticks: func() -> s32;
  }

  /// Result of an entity ray-trace operation.
  record ray-trace-entity-result {
    /// The entity that was hit.
    entity: entity,
    /// The exact hit coordinates in world space.
    hit-pos: position,
    /// The distance from the ray start to the hit position.
    distance: f64,
  }

  resource chunk {
    /// Gets the chunk's X coordinate.
    get-x: func() -> s32;
    /// Gets the chunk's Z coordinate.
    get-z: func() -> s32;
    /// Gets the block state ID at the specified position relative to the chunk.
    /// X and Z must be in the range [0, 15].
    get-block-state-id: func(pos: block-pos) -> u16;
    /// Gets detailed block state information at the specified position relative to the chunk.
    /// X and Z must be in the range [0, 15].
    get-block-state: func(pos: block-pos) -> block-state;
    /// Sets the block state at the specified position relative to the chunk.
    /// X and Z must be in the range [0, 15].
    set-block-state: func(pos: block-pos, state: u16);
    /// Gets the block at the specified position relative to the chunk.
    /// X and Z must be in the range [0, 15].
    get-block: func(pos: block-pos) -> block;
    /// Sets the block at the specified position relative to the chunk using its default state.
    /// X and Z must be in the range [0, 15].
    set-block: func(pos: block-pos, block: block);
    /// Sets the block by block ID at the specified position relative to the chunk using its default state.
    /// X and Z must be in the range [0, 15].
    set-block-by-id: func(pos: block-pos, block-id: u16);
    /// Gets the biome at the specified position relative to the chunk.
    /// X and Z must be in the range [0, 15].
    get-biome: func(pos: block-pos) -> biome;
    /// Gets the block entity at the specified position relative to the chunk, if any.
    /// X and Z must be in the range [0, 15].
    get-block-entity: func(pos: block-pos) -> option<block-entity-type>;
    /// Gets the highest non-air block Y coordinate at the specified X and Z relative to the chunk.
    /// X and Z must be in the range [0, 15].
    get-top-block-y: func(x: s32, z: s32) -> s32;
    /// Gets the sky light level at the specified position relative to the chunk.
    /// X and Z must be in the range [0, 15].
    get-sky-light: func(pos: block-pos) -> u8;
    /// Gets the block light level at the specified position relative to the chunk.
    /// X and Z must be in the range [0, 15].
    get-block-light: func(pos: block-pos) -> u8;
    /// Sets a namespaced custom data value on this chunk.
    set-custom-data: func(namespace: string, key: string, value: nbt-tree);
    /// Returns a namespaced custom data value from this chunk, if set.
    get-custom-data: func(namespace: string, key: string) -> option<nbt-tree>;
    /// Removes a namespaced custom data value from this chunk.
    remove-custom-data: func(namespace: string, key: string);
    /// Returns whether this chunk has a namespaced custom data value.
    has-custom-data: func(namespace: string, key: string) -> bool;
  }

  /// Represents the boundaries of a world.
  resource world-border {
    /// Gets the center X coordinate of the border.
    get-center-x: func() -> f64;
    /// Gets the center Z coordinate of the border.
    get-center-z: func() -> f64;
    /// Gets the center position of the border.
    get-center: func() -> position;
    /// Sets the center coordinates of the border.
    set-center: func(x: f64, z: f64);
    /// Gets the current diameter of the border.
    get-diameter: func() -> f64;
    /// Gets the current diameter of the border (alias for get-diameter).
    get-size: func() -> f64;
    /// Sets the diameter of the border, optionally with a speed (in ticks) for lerping.
    set-diameter: func(diameter: f64, speed: option<u64>);
    /// Sets the size of the border instantly.
    set-size: func(size: f64);
    /// Sets the size of the border with a transition duration in seconds.
    set-size-transition: func(new-size: f64, time-seconds: u64);
    /// Gets the target diameter when lerping/transitioning.
    get-target-diameter: func() -> f64;
    /// Gets the target transition duration/speed in ticks.
    get-target-speed: func() -> s64;
    /// Gets the distance from the border where warning effects start (in blocks).
    get-warning-distance: func() -> s32;
    /// Sets the warning distance (in blocks).
    set-warning-distance: func(distance: s32);
    /// Gets the time before a player hitting the border is warned (in seconds).
    get-warning-delay: func() -> s32;
    /// Sets the warning delay (in seconds).
    set-warning-delay: func(delay: s32);
    /// Gets the warning time (alias for get-warning-delay).
    get-warning-time: func() -> s32;
    /// Sets the warning time (alias for set-warning-delay).
    set-warning-time: func(time: s32);
    /// Gets the safe damage buffer distance outside the border (in blocks).
    get-damage-buffer: func() -> f64;
    /// Sets the safe damage buffer distance outside the border (in blocks).
    set-damage-buffer: func(buffer: f64);
    /// Gets the damage amount inflicted per block per second when outside the buffer.
    get-damage-amount: func() -> f64;
    /// Sets the damage amount inflicted per block per second when outside the buffer.
    set-damage-amount: func(damage: f64);
    /// Returns whether the specified coordinates are within the border.
    contains: func(x: f64, z: f64) -> bool;
    /// Returns whether the specified position is within the border.
    contains-pos: func(pos: position) -> bool;
    /// Resets the world border to vanilla default settings.
    reset: func();
  }

  /// Represents an axis-aligned bounding box.
  record bounding-box {
    min: position,
    max: position,
  }

  /// Detailed information about a block's state.
  record block-state {
    /// The internal numerical ID of the block state.
    id: u16,
    /// The numerical ID of the parent block type.
    block-id: u16,
    /// The namespaced identifier of the parent block type.
    block-name: string,
    /// The light level emitted by this block (0-15).
    luminance: u8,
    /// How much light this block blocks.
    opacity: u8,
    /// The hardness of the block, determining mining speed.
    hardness: f32,
    /// Whether this block is considered air.
    is-air: bool,
    /// Whether this block is a liquid.
    is-liquid: bool,
    /// Whether this block is a solid.
    is-solid: bool,
    /// Whether this block occupies a full cube.
    is-full-cube: bool,
    /// How this block behaves when pushed by a piston.
    piston-behavior: piston-behavior,
    /// Whether this block receives random ticks.
    has-random-ticks: bool,
    /// Whether this block can catch fire.
    burnable: bool,
    /// Whether a specific tool is required to mine this block and get drops.
    tool-required: bool,
    /// Whether this block has transparency on its sides.
    sided-transparency: bool,
    /// Whether this block can be replaced by another block (e.g., grass).
    replaceable: bool,
    /// Whether this block is considered a solid block for redstone purposes.
    is-solid-block: bool,
    /// The numerical ID of the block entity type, if any.
    block-entity-type: u16,
    /// The instrument used for note blocks when placed on top of this block.
    instrument: noteblock-instrument,
    /// The collision shapes of this block.
    collision-shapes: list<bounding-box>,
    /// The outline shapes of this block.
    outline-shapes: list<bounding-box>,
    /// Whether the bottom side of the block is solid.
    down-side-solid: bool,
    /// Whether the top side of the block is solid.
    up-side-solid: bool,
    /// Whether the north side of the block is solid.
    north-side-solid: bool,
    /// Whether the south side of the block is solid.
    south-side-solid: bool,
    /// Whether the west side of the block is solid.
    west-side-solid: bool,
    /// Whether the east side of the block is solid.
    east-side-solid: bool,
    /// Whether the center of the bottom side is solid.
    down-center-solid: bool,
    /// Whether the center of the top side is solid.
    up-center-solid: bool,
    /// The color of this block when displayed on a map.
    map-color: u8,
    /// The block state's property key-value pairs (e.g. facing=north).
    properties: list<tuple<string, string>>,
  }

  /// Represents the configured shared spawn location for a world.
  record world-spawn-location {
    /// The block position of the shared world spawn.
    pos: block-pos,
    /// The yaw players should face when spawning here.
    yaw: f32,
    /// The pitch players should use when spawning here.
    pitch: f32,
  }

  /// Represents a cardinal direction or block face.
  enum block-direction {
    down,
    up,
    north,
    south,
    west,
    east,
  }

  /// Specialized data for shulker entities.
  record shulker-data {
    attached-face: block-direction,
    peek-amount: u8,
    color: option<dye-color>,
  }

  /// Tagged variant holding specialized data for specific mob types.
  variant mob-data {
    sheep(sheep-data),
    wolf(wolf-data),
    cat(cat-data),
    villager(villager-data),
    creeper(creeper-data),
    slime(slime-data),
    enderman(enderman-data),
    iron-golem(iron-golem-data),
    fox(fox-data),
    ageable(ageable-data),
    zombie(zombie-data),
    shulker(shulker-data),
    generic,
  }

  /// Result of a raycast operation.
  record raycast-result {
    /// The block position that was hit.
    pos: block-pos,
    /// The face of the block that was hit.
    face: block-direction,
  }

  /// Detailed result of a block ray-trace operation.
  record ray-trace-block-result {
    /// The block position that was hit.
    pos: block-pos,
    /// The face of the block that was hit.
    face: block-direction,
    /// The exact hit coordinates in world space.
    hit-pos: position,
  }

  /// Represents a Minecraft world (dimension).
  resource %world {
    /// Returns the unique identifier of this world.
    get-id: func() -> string;
    /// Gets the world border associated with this world (alias for get-world-border).
    get-border: func() -> world-border;
    /// Gets the world border associated with this world.
    get-world-border: func() -> world-border;
    /// Gets the chunk at the specified chunk coordinates.
    get-chunk: func(x: s32, z: s32) -> option<chunk>;
    /// Gets the block state ID at the specified position.
    get-block-state-id: func(pos: block-pos) -> u16;
    /// Gets detailed block state information at the specified position.
    get-block-state: func(pos: block-pos) -> block-state;
    /// Sets the block state at the specified position.
    set-block-state: func(pos: block-pos, state: u16, update-flags: block-flags);
    /// Gets the block type at the specified position.
    get-block: func(pos: block-pos) -> block;
    /// Gets the numerical block ID at the specified position.
    get-block-id: func(pos: block-pos) -> u16;
    /// Sets the block at the specified position using its default state.
    set-block: func(pos: block-pos, block: block, update-flags: block-flags);
    /// Sets the block at the specified position by numerical block ID using its default state.
    set-block-by-id: func(pos: block-pos, block-id: u16, update-flags: block-flags);
    /// Sets the block at the specified position by namespaced name using its default state.
    /// Returns true if the block was recognized and set.
    set-block-by-name: func(pos: block-pos, name: string, update-flags: block-flags) -> bool;
    /// Returns the current time of day in ticks.
    get-time-of-day: func() -> u64;
    /// Sets the current time of day in ticks.
    set-time-of-day: func(time: u64);
    /// Returns the total age of the world in ticks.
    get-world-age: func() -> u64;
    /// Returns the dimension type (e.g., \"minecraft:overworld\").
    get-dimension: func() -> string;
    /// Returns the configured shared spawn location for this world.
    get-spawn-location: func() -> world-spawn-location;
    /// Gets the highest non-air block Y coordinate at the specified X and Z.
    get-top-block-y: func(x: s32, z: s32) -> s32;
    /// Gets the highest motion-blocking block Y coordinate.
    get-motion-blocking-height: func(x: s32, z: s32) -> s32;
    /// Returns whether it is currently raining or snowing.
    is-raining: func() -> bool;
    /// Sets whether it should be raining or snowing.
    set-raining: func(raining: bool);
    /// Returns whether there is currently a thunderstorm.
    is-thundering: func() -> bool;
    /// Sets whether there should be a thunderstorm.
    set-thundering: func(thundering: bool);
    /// Broadcasts a system message to all players in this world.
    broadcast-system-message: func(message: text-component, overlay: bool);
    /// Returns the scoreboard associated with this world.
    get-scoreboard: func() -> scoreboard;
    /// Plays a sound at the specified position for all players in the world.
    play-sound: func(sound: sound, category: sound-category, pos: position, volume: f32, pitch: f32);
    /// Plays a custom resource pack sound identifier at the specified position for all players in the world.
    play-custom-sound: func(sound-name: string, category: sound-category, pos: position, volume: f32, pitch: f32);
    /// Spawns particles at the specified position.
    spawn-particle: func(particle: particle, pos: position, offset: position, max-speed: f32, count: s32);
    /// Creates an explosion at the specified position.
    create-explosion: func(pos: position, power: f32, create-fire: bool, interaction: explosion-interaction);
    /// Returns the sea level of this world.
    get-sea-level: func() -> s32;
    /// Returns the minimum Y coordinate (bottom of the world).
    get-min-y: func() -> s32;
    /// Returns the sky light level at the specified position.
    get-sky-light: func(pos: block-pos) -> u8;
    /// Sets the sky light level at the specified position.
    set-sky-light: func(pos: block-pos, level: u8);
    /// Returns the block light level at the specified position.
    get-block-light: func(pos: block-pos) -> u8;
    /// Sets the block light level at the specified position.
    set-block-light: func(pos: block-pos, level: u8);
    /// Returns the biome at the specified position.
    get-biome: func(pos: block-pos) -> biome;
    /// Spawns an entity of the specified type at the given position.
    spawn-entity: func(entity-type: entity-type, pos: position) -> entity;
    /// Returns a list of all entities in this world.
    get-entities: func() -> list<entity>;
    /// Spawns a lightning bolt at the specified position.
    strike-lightning: func(pos: position, effect-only: bool);
    /// Performs a raycast from start position to end position to hit blocks.
    ray-trace-blocks: func(start: position, end: position) -> option<position>;
    /// Performs a raycast from start position to end position to hit blocks, with optional fluid handling.
    ray-trace-block: func(start: position, end: position, include-fluids: bool) -> option<ray-trace-block-result>;
    /// Performs a raycast from start position to end position to find the closest entity hit.
    ray-trace-entity: func(start: position, end: position) -> option<ray-trace-entity-result>;
    /// Performs a raycast from start position to end position to find all entities hit along the ray.
    ray-trace-entities: func(start: position, end: position) -> list<ray-trace-entity-result>;
    /// Returns the block entity at the specified position, if any.
    get-block-entity: func(pos: block-pos) -> option<block-entity-type>;
    /// Returns the raw NBT bytes of the block entity at the given position, if any.
    get-block-entity-nbt: func(pos: block-pos) -> option<list<u8>>;
    /// Restores a block entity from raw NBT bytes at the given position.
    /// The NBT must contain a valid "id" field (e.g. "minecraft:chest").
    set-block-entity-nbt: func(pos: block-pos, nbt-data: list<u8>) -> result<_, string>;
    /// Returns the name of this world (e.g. "world", "world_nether", "arena_1").
    get-name: func() -> string;
    /// Saves all chunk data, block entities, and entities for this world to disk.
    save: func() -> result<_, string>;
    /// Sets a custom chunk generator for this world using a registered generator ID.
    set-chunk-generator: func(generator-id: u32);
    /// Sets a namespaced custom data value on this world.
    set-custom-data: func(namespace: string, key: string, value: nbt-tree);
    /// Returns a namespaced custom data value from this world, if set.
    get-custom-data: func(namespace: string, key: string) -> option<nbt-tree>;
    /// Removes a namespaced custom data value from this world.
    remove-custom-data: func(namespace: string, key: string);
    /// Returns whether this world has a namespaced custom data value.
    has-custom-data: func(namespace: string, key: string) -> bool;
    /// Gets the value of a game rule in this world.
    get-game-rule: func(rule: game-rule) -> game-rule-value;
    /// Sets the value of a game rule in this world.
    set-game-rule: func(rule: game-rule, value: game-rule-value);
  }

  /// Generation phase for custom chunk generation.
  enum generation-phase {
    biomes,
    noise,
    surface,
    features,
  }

  /// Mutable chunk buffer representing a 16x16 column during custom world generation.
  resource chunk-buffer {
    /// Returns the chunk X coordinate.
    get-x: func() -> s32;
    /// Returns the chunk Z coordinate.
    get-z: func() -> s32;
    /// Returns the minimum Y coordinate for this world.
    get-min-y: func() -> s32;
    /// Returns the height of the chunk in blocks.
    get-height: func() -> u32;
    /// Sets the block state ID at local coordinates (0..16, y, 0..16).
    set-block-state-id: func(x: u8, y: s32, z: u8, state-id: u16);
    /// Gets the block state ID at local coordinates (0..16, y, 0..16).
    get-block-state-id: func(x: u8, y: s32, z: u8) -> u16;
    /// Fills an entire horizontal 16x16 layer at the given Y level with a block state ID.
    fill-layer: func(y: s32, state-id: u16);
    /// Fills a vertical column from min-y to max-y at local (x, z) with a block state ID.
    fill-range: func(x: u8, min-y: s32, max-y: s32, z: u8, state-id: u16);
    /// Fills a 3D cuboid with a block state ID.
    fill-cuboid: func(min-x: u8, min-y: s32, min-z: u8, max-x: u8, max-y: s32, max-z: u8, state-id: u16);
    /// Sets the biome at local coordinates (0..16, y, 0..16).
    set-biome: func(x: u8, y: s32, z: u8, biome: biome);
    /// Fills the entire chunk with the given biome.
    fill-biome: func(biome: biome);
  }

  /// A block's registry name and its property key-value pairs for a state ID.
  record block-state-info {
    name: string,
    properties: list<tuple<string, string>>,
  }

  /// Resolves a block name and optional properties to a block state ID.
  /// Returns none if the block name is unknown.
  resolve-block-state: func(name: string, properties: list<tuple<string, string>>) -> option<u16>;

  /// Resolves a block state ID back to its block name and properties.
  /// Returns none if the state ID is unknown.
  block-state-to-info: func(state-id: u16) -> option<block-state-info>;

  /// Gets a block type by its numerical block ID.
  get-block-by-id: func(id: u16) -> option<block>;

  /// Gets a block type by its namespaced name (e.g., "minecraft:stone" or "stone").
  get-block-by-name: func(name: string) -> option<block>;

  /// Gets all registered blocks.
  get-all-blocks: func() -> list<block>;

  /// Gets the names of all registered blocks.
  get-all-block-names: func() -> list<string>;

  /// Gets the total number of registered block types.
  get-block-count: func() -> u32;

  /// Gets the total number of registered block states.
  get-block-state-count: func() -> u32;

  /// Gets all valid block states for a block type.
  get-states-for-block: func(block: block) -> list<block-state>;

  /// Gets all valid block states for a numerical block ID.
  get-states-for-block-id: func(block-id: u16) -> list<block-state>;

  /// Gets all valid state IDs for a numerical block ID.
  get-state-ids-for-block-id: func(block-id: u16) -> list<u16>;

  /// Gets property key-value pairs for a numerical block state ID.
  get-block-properties: func(state-id: u16) -> list<tuple<string, string>>;

  /// Gets the block type associated with a block state ID.
  get-block-from-state-id: func(state-id: u16) -> option<block>;

  /// Gets the block type associated with a block state.
  get-block-from-state: func(state: block-state) -> block;

  /// Gets the default block state for a block type.
  get-default-state-from-block: func(block: block) -> block-state;

  /// Gets the default block state for a numerical block ID.
  get-default-state-from-block-id: func(block-id: u16) -> option<block-state>;

  /// Gets the detailed block state for a numerical block state ID.
  get-block-state-by-id: func(state-id: u16) -> option<block-state>;
}

interface display {
  use %world.{entity};
  use text.{text-component};
  use item-stack.{item-stack};
  use uuid.{uuid};

  /// Billboard rendering constraints for display entities.
  enum billboard-mode {
    fixed,
    vertical,
    horizontal,
    center,
  }

  /// Item display transformation modes for item display entities.
  enum item-display-mode {
    none,
    thirdperson-lefthand,
    thirdperson-righthand,
    firstperson-lefthand,
    firstperson-righthand,
    head,
    gui,
    ground,
    fixed,
  }

  /// Text alignment options for text display entities.
  enum text-alignment {
    center,
    left,
    right,
  }

  /// 3D single-precision vector.
  record vector3f {
    x: f32,
    y: f32,
    z: f32,
  }

  /// Single-precision quaternion representing a 3D rotation.
  record quaternionf {
    x: f32,
    y: f32,
    z: f32,
    w: f32,
  }

  /// Transformation (translation, scale, left and right rotations) for display entities.
  record display-transformation {
    translation: vector3f,
    scale: vector3f,
    left-rotation: quaternionf,
    right-rotation: quaternionf,
  }

  /// Common base resource for all display entities.
  resource display-entity {
    from-entity: static func(entity: borrow<entity>) -> option<display-entity>;
    get-entity: func() -> entity;
    get-transformation: func() -> display-transformation;
    set-transformation: func(transformation: display-transformation);
    get-interpolation-duration: func() -> s32;
    set-interpolation-duration: func(duration: s32);
    get-interpolation-start: func() -> s32;
    set-interpolation-start: func(delta-ticks: s32);
    get-teleport-duration: func() -> s32;
    set-teleport-duration: func(duration: s32);
    get-billboard: func() -> billboard-mode;
    set-billboard: func(mode: billboard-mode);
    get-view-range: func() -> f32;
    set-view-range: func(range: f32);
    get-shadow-radius: func() -> f32;
    set-shadow-radius: func(radius: f32);
    get-shadow-strength: func() -> f32;
    set-shadow-strength: func(strength: f32);
    get-display-width: func() -> f32;
    set-display-width: func(width: f32);
    get-display-height: func() -> f32;
    set-display-height: func(height: f32);
    get-glow-color-override: func() -> s32;
    set-glow-color-override: func(color: s32);
    get-brightness: func() -> s32;
    set-brightness: func(brightness: s32);
  }

  /// Resource specifically for Block Display entities.
  resource block-display-entity {
    from-entity: static func(entity: borrow<entity>) -> option<block-display-entity>;
    get-display: func() -> display-entity;
    get-entity: func() -> entity;
    get-block-state-id: func() -> u16;
    set-block-state-id: func(state-id: u16);
  }

  /// Resource specifically for Item Display entities.
  resource item-display-entity {
    from-entity: static func(entity: borrow<entity>) -> option<item-display-entity>;
    get-display: func() -> display-entity;
    get-entity: func() -> entity;
    get-item: func() -> option<item-stack>;
    set-item: func(item: option<item-stack>);
    get-item-display-mode: func() -> item-display-mode;
    set-item-display-mode: func(mode: item-display-mode);
  }

  /// Resource specifically for Text Display entities.
  resource text-display-entity {
    from-entity: static func(entity: borrow<entity>) -> option<text-display-entity>;
    get-display: func() -> display-entity;
    get-entity: func() -> entity;
    get-text: func() -> text-component;
    set-text: func(text: text-component);
    get-line-width: func() -> s32;
    set-line-width: func(width: s32);
    get-background: func() -> s32;
    set-background: func(color: s32);
    get-text-opacity: func() -> s8;
    set-text-opacity: func(opacity: s8);
    get-shadow: func() -> bool;
    set-shadow: func(shadow: bool);
    get-see-through: func() -> bool;
    set-see-through: func(see-through: bool);
    get-default-background: func() -> bool;
    set-default-background: func(default-background: bool);
    get-alignment: func() -> text-alignment;
    set-alignment: func(alignment: text-alignment);
  }

  /// Resource specifically for Interaction entities.
  resource interaction-entity {
    from-entity: static func(entity: borrow<entity>) -> option<interaction-entity>;
    get-entity: func() -> entity;
    get-width: func() -> f32;
    set-width: func(width: f32);
    get-height: func() -> f32;
    set-height: func(height: f32);
    get-response: func() -> bool;
    set-response: func(response: bool);
    get-last-attacker: func() -> option<uuid>;
    get-last-interaction: func() -> option<uuid>;
  }
}

interface entity {
  use %world.{entity, living-entity, mob, path-node-type, dye-color, villager-profession, mob-data, sheep-data, wolf-data, cat-data, villager-data, creeper-data, slime-data, enderman-data, iron-golem-data, fox-data, ageable-data, zombie-data, shulker-data, raycast-result, ray-trace-block-result, ray-trace-entity-result, block-direction};
}

/// Represents a player connected to the Minecraft server.
interface player {
  use common.{hand, position, game-mode, block-pos};
  use item-stack.{item-stack};
  use %world.{%world, entity, ray-trace-block-result, ray-trace-entity-result};
  use permission.{permission-level};
  use text.{text-component};
  use gui.{gui};
  use forms.{form};
  use java-dialogs.{dialog};
  use java-packets.{clientbound-packet as java-packet};
  use bedrock-packets.{clientbound-packet as bedrock-packet};
  use uuid.{uuid};
  use status-effect.{status-effect-type, status-effect-instance};
  use scoreboard.{scoreboard, bedrock-scoreboard};
  use advancement.{advancement-progress};
  use damage-types.{damage-type};
  use statistics.{statistic-category, custom-statistic};
  use inventory.{inventory, player-inventory};
  use sounds.{sound, sound-category};
  use particles.{particle};
  use entity-statuses.{entity-status};

  /// Represents per-player weather condition overrides.
  enum player-weather {
    clear,
    downfall,
  }

  /// Types of projectiles that can be launched by a player.
  enum projectile-type {
    arrow,
    snowball,
    egg,
    ender-pearl,
    splash-potion,
    fireball,
    small-fireball,
    trident,
    wind-charge,
  }

  /// Types of clientbound game events.
  enum client-game-event {
    no-respawn-block-available,
    begin-raining,
    end-raining,
    change-game-mode,
    win-game,
    demo-event,
    arrow-hit-player,
    rain-level-change,
    thunder-level-change,
    play-pufferfish-string-sound,
    play-elder-guardian-mob-appearance,
    enabled-respawn-screen,
    limited-crafting,
    start-waiting-chunks,
  }

  /// Built-in known server link types displayed in the client Escape pause menu.
  enum known-server-link {
    bug-report,
    community-guidelines,
    support,
    status,
    feedback,
    community,
    website,
    forums,
    news,
    announcements,
  }

  /// Label for a server link: either a built-in standard link type or a custom text component.
  variant server-link-label {
    known(known-server-link),
    custom(text-component),
  }

  /// Represents a server link entry with a label and destination URL.
  record server-link {
    label: server-link-label,
    url: string,
  }

  /// Various abilities a player can have.
  record player-abilities {
    /// Whether the player is invulnerable to damage.
    invulnerable: bool,
    /// Whether the player is currently flying.
    flying: bool,
    /// Whether the player is allowed to fly.
    allow-flying: bool,
    /// Whether the player is in creative mode.
    creative: bool,
    /// Whether the player can modify the world.
    allow-modify-world: bool,
    /// The speed at which the player flies.
    fly-speed: f32,
    /// The speed at which the player walks.
    walk-speed: f32,
  }

  /// Represents a player's skin textures and metadata.
  record player-skin {
    /// The base64-encoded texture data (usually JSON containing skin/cape URLs).
    value: string,
    /// The optional signature for the texture data.
    signature: option<string>,
  }

  /// Represents which skin parts are visible.
  flags skin-parts {
    cape,
    jacket,
    left-sleeve,
    right-sleeve,
    left-pants-leg,
    right-pants-leg,
    hat,
  }

  /// Represents the various abilities a Bedrock Edition player can have.
  enum bedrock-ability {
    /// Whether the player can build.
    build,
    /// Whether the player can mine blocks.
    mine,
    /// Whether the player can use doors and switches.
    doors-and-switches,
    /// Whether the player can open containers.
    open-containers,
    /// Whether the player can attack other players.
    attack-players,
    /// Whether the player can attack mobs.
    attack-mobs,
    /// Whether the player can use operator commands.
    operator-commands,
    /// Whether the player can teleport.
    teleport,
    /// Whether the player is invulnerable.
    invulnerable,
    /// Whether the player is currently flying.
    flying,
    /// Whether the player is allowed to fly.
    may-fly,
    /// Whether the player has instant build (creative).
    instabuild,
    /// Whether the player can use lightning-related abilities.
    lightning,
    /// The speed at which the player flies.
    fly-speed,
    /// The speed at which the player walks.
    walk-speed,
    /// Whether the player is muted.
    muted,
    /// Whether the player is a world builder.
    world-builder,
    /// Whether the player has no-clip enabled.
    no-clip,
    /// Whether the player is a privileged builder.
    privileged-builder,
    /// The speed at which the player flies vertically.
    vertical-fly-speed,
  }

  /// Represents the various status flags a Bedrock Edition entity can have.
  /// These flags control client-side rendering and behavior.
  enum bedrock-status-flag {
    /// Whether the entity is currently on fire.
    on-fire,
    /// Whether the entity is sneaking.
    sneaking,
    /// Whether the entity is riding another entity.
    riding,
    /// Whether the entity is sprinting.
    sprinting,
    /// Whether the entity is using an item (e.g., eating, blocking).
    using-item,
    /// Whether the entity is invisible.
    invisible,
    /// Whether the entity is tempted by an item.
    tempted,
    /// Whether the entity is in love (breeding).
    in-love,
    /// Whether the entity is saddled.
    saddled,
    /// Whether the entity is powered (e.g., charged creeper).
    powered,
    /// Whether the entity is ignited.
    ignited,
    /// Whether the entity is a baby.
    baby,
    /// Whether the entity is currently converting to another type.
    converting,
    /// Whether the entity is in a critical state.
    critical,
    /// Whether to show the entity's name tag.
    show-name,
    /// Whether to always show the entity's name tag.
    always-show-name,
    /// Whether the entity has no AI.
    no-ai,
    /// Whether the entity is silent.
    silent,
    /// Whether the entity is climbing a wall.
    wall-climbing,
    /// Whether the entity is climbing.
    climb,
    /// Whether the entity is swimming.
    swim,
    /// Whether the entity is flying.
    fly,
    /// Whether the entity is walking.
    walk,
    /// Whether the entity is resting.
    resting,
    /// Whether the entity is sitting.
    sitting,
    /// Whether the entity is angry.
    angry,
    /// Whether the entity is interested.
    interested,
    /// Whether the entity is charged.
    charged,
    /// Whether the entity is tamed.
    tamed,
    /// Whether the entity is orphaned.
    orphaned,
    /// Whether the entity is leashed.
    leashed,
    /// Whether the entity is sheared.
    sheared,
    /// Whether the entity is gliding (elytra).
    gliding,
    /// Whether the entity is an elder (e.g., elder guardian).
    elder,
    /// Whether the entity is moving.
    moving,
    /// Whether the entity is breathing.
    breathing,
    /// Whether the entity has a chest (e.g., donkey).
    chested,
    /// Whether the entity is stackable.
    stackable,
    /// Whether to show the bottom of the entity.
    show-bottom,
    /// Whether the entity is standing.
    standing,
    /// Whether the entity is shaking.
    shaking,
    /// Whether the entity is idling.
    idling,
    /// Whether the entity is casting (e.g., evoker).
    casting,
    /// Whether the entity is charging an attack.
    charging,
    /// Whether the entity is controlled by a keyboard.
    keyboard-controlled,
    /// Whether the entity is performing a power jump.
    power-jump,
    /// Whether the entity is dashing.
    dash,
    /// Whether the entity is lingering.
    lingering,
    /// Whether the entity has collision.
    has-collision,
    /// Whether the entity has gravity.
    has-gravity,
    /// Whether the entity is immune to fire.
    fire-immune,
    /// Whether the entity is dancing.
    dancing,
    /// Whether the entity is enchanted.
    enchanted,
    /// Whether a trident will return to the entity.
    return-trident,
    /// Whether the container is private.
    container-private,
    /// Whether the entity is transforming.
    transforming,
    /// Whether the entity damages nearby mobs.
    damage-nearby-mobs,
    /// Whether the entity is swimming.
    swimming,
    /// Whether the entity has been bribed.
    bribed,
    /// Whether the entity is pregnant.
    pregnant,
    /// Whether the entity is laying an egg.
    laying-egg,
    /// Whether a passenger can pick up the entity.
    passenger-can-pick,
    /// Whether the entity is transitioning to sitting.
    transition-sitting,
    /// Whether the entity is eating.
    eating,
    /// Whether the entity is laying down.
    laying-down,
    /// Whether the entity is sneezing.
    sneezing,
    /// Whether the entity is trusting.
    trusting,
    /// Whether the entity is rolling.
    rolling,
    /// Whether the entity is scared.
    scared,
    /// Whether the entity is in scaffolding.
    in-scaffolding,
    /// Whether the entity is over scaffolding.
    over-scaffolding,
    /// Whether the entity is descending through a block.
    descend-through-block,
    /// Whether the entity is blocking.
    blocking,
    /// Whether the entity is transitioning to blocking.
    transition-blocking,
    /// Whether the entity is blocked using a shield.
    blocked-using-shield,
    /// Whether the entity is blocked using a damaged shield.
    blocked-using-damaged-shield,
    /// Whether the entity is sleeping.
    sleeping,
    /// Whether the entity wants to wake up.
    wants-to-wake,
    /// Whether the entity shows interest in trading.
    trade-interest,
    /// Whether the entity can break doors.
    door-breaker,
    /// Whether the entity is breaking an obstruction.
    breaking-obstruction,
    /// Whether the entity can open doors.
    door-opener,
    /// Whether the entity is a captain (raid).
    captain,
    /// Whether the entity is stunned.
    stunned,
    /// Whether the entity is roaring.
    roaring,
    /// Whether the entity has a delayed attack.
    delayed-attack,
    /// Whether the entity is avoiding mobs.
    avoiding-mobs,
    /// Whether the entity is avoiding a block.
    avoiding-block,
    /// Whether the entity is facing a target for a ranged attack.
    facing-target-to-range-attack,
    /// Whether the entity is hidden when invisible.
    hidden-when-invisible,
    /// Whether the entity is in a UI.
    in-ui,
    /// Whether the entity is stalking.
    stalking,
    /// Whether the entity is emoting.
    emoting,
    /// Whether the entity is celebrating.
    celebrating,
    /// Whether the entity is admiring (piglin).
    admiring,
    /// Whether the entity is celebrating a special event.
    celebrating-special,
    /// Whether the entity is out of control.
    out-of-control,
    /// Whether the entity is performing a ram attack.
    ram-attack,
    /// Whether the entity is playing dead.
    playing-dead,
    /// Whether the entity is in an ascending block.
    in-ascending-block,
    /// Whether the entity is over a descending block.
    over-descending-block,
    /// Whether the entity is croaking (frog).
    croaking,
    /// Whether the entity is digesting a mob.
    digest-mob,
    /// Whether the entity has a jump goal.
    jump-goal,
    /// Whether the entity is emerging.
    emerging,
    /// Whether the entity is sniffing.
    sniffing,
    /// Whether the entity is digging.
    digging,
    /// Whether the entity is performing a sonic boom.
    sonic-boom,
    /// Whether the entity has a dash timeout.
    has-dash-timeout,
    /// Whether the entity is pushed towards the closest space.
    push-towards-closest-space,
    /// Whether the entity is scenting.
    scenting,
    /// Whether the entity is rising.
    rising,
    /// Whether the entity is feeling happy.
    feeling-happy,
    /// Whether the entity is searching.
    searching,
    /// Whether the entity is crawling.
    crawling,
    /// Whether the entity's body rotation is blocked.
    body-rotation-blocked,
    /// Whether the entity is rendered when invisible.
    render-when-invisible,
    /// Whether the entity's body rotation is axis-aligned.
    body-rotation-axis-aligned,
    /// Whether the entity is collidable.
    collidable,
    /// Whether the entity is air-controlled via WASD.
    wasd-air-controlled,
    /// Whether only the server can authorize a dismount.
    does-server-auth-only-dismount,
    /// Whether the body rotation always follows the head.
    body-rotation-always-follows-head,
    /// Whether the entity can use vertical movement actions.
    can-use-vertical-movement-action,
    /// Whether rotation is locked to the vehicle.
    rotation-locked-to-vehicle,
  }

